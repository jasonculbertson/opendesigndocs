{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "framework": "astro",
  "outputDirectory": ".vercel/output",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
