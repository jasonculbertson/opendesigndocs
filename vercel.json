{
  "buildCommand": "DEPLOY_TIME=$(date +%s) npm run build",
  "devCommand": "npm run dev",
  "framework": "astro",
  "outputDirectory": ".vercel/output",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Surrogate-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/main"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
