---
import Footer from '../components/layout/Footer.astro';
import AppShell from '../components/layout/AppShell';

import { ViewTransitions } from 'astro:transitions';
import { shouldShowSubstack } from '../utils/pageUtils';

// import Analytics from '@vercel/analytics/astro';
import '../styles/main.css';
// import '../styles/global.css'; // Re-add import for global styles
// Auth overlay removed from subpages

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const { 
  title,
  description = "Open Design Docs - A comprehensive resource for design leadership and management",
  image = "/og-image.jpg",
  type = "website"
} = Astro.props;

const path = Astro.url.pathname;
const showSubstack = shouldShowSubstack(path);
const siteUrl = 'https://opendesigndocs.com';
const canonicalURL = new URL(path, siteUrl).toString();
const showSidebar = path.startsWith('/docs');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | Open Design Docs</title>
    <meta name="title" content={`${title} | Open Design Docs`} />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Open Design Docs`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl).toString()} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Open Design Docs`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, siteUrl).toString()} />

    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />
    
    <!-- Google Analytics 4 -->
    {import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <>
        <!-- GA4 script with environment variable support -->
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_MEASUREMENT_ID}`}></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', `${import.meta.env.PUBLIC_GA_MEASUREMENT_ID}`);
        </script>
        <script>
          // Initialize enhanced GA tracking
          import('../utils/googleAnalytics');
        </script>
      </>
    )}
  </head>
  <body>
    <!-- App Shell with proper state management -->
    <AppShell client:load currentPath={path} showSidebar={showSidebar} />
    
          <!-- Main content that updates on navigation -->
      <div class="min-h-screen bg-white">
        <!-- Mobile header is now handled by React MobileHeader component -->

        <!-- Mobile overlay backdrop -->
        <div 
          id="mobile-overlay" 
          class="fixed inset-0 bg-black bg-opacity-50 z-[65] lg:hidden hidden opacity-0 transition-opacity duration-300"
        ></div>

        <div class="flex">
          <main class="flex-1 lg:pl-[250px] flex flex-col min-h-screen">
            <div class="pt-20 lg:pt-8 flex-1">
              <div class="max-w-[900px] mx-auto px-4 lg:px-0">
                <div class="relative max-w-[680px] mx-auto">
                  <slot />
                </div>
              </div>
            </div>
            <div class="mt-auto">
              <Footer />
            </div>
          </main>
        </div>
      </div>
    {/* <Analytics /> */}

    <!-- Mobile menu functionality is now handled by React MobileHeader component -->
  </body>
</html>