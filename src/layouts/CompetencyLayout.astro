---
import Layout from './Layout.astro';
import BookmarkButton from '../components/BookmarkButton';
import ShareButtons from '../components/ShareButtons';
import CommentsSection from '../components/CommentsSection';
import LikeButton from '../components/LikeButton';

const { frontmatter, breadcrumbs } = Astro.props;
const path = Astro.url.pathname;
---

<Layout title={frontmatter.title}>
    <main class="py-8 px-4 sm:px-6 lg:px-8">
      <article class="max-w-[680px] mx-auto">
        <nav class="flex mb-2" aria-label="Breadcrumb">
          <ol class="flex items-center">
            {breadcrumbs.map((crumb: { href?: string; text: string }, index: number) => (
              <li class="flex items-center">
                {index > 0 && <span class="mx-2 text-gray-400">/</span>}
                {crumb.href ? (
                  <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                    {crumb.text}
                  </a>
                ) : (
                  <span class="text-sm text-gray-900">{crumb.text}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>

        <div class="flex justify-end items-center gap-2 mb-4">
          <LikeButton client:only="react" />
          <BookmarkButton client:only="react" title={frontmatter.title} />
        </div>

        <div class="prose">
          <slot />
        </div>

        <div class="mt-12 pt-8 border-t border-gray-200">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div class="flex items-center gap-4">
              <span class="text-sm font-medium text-gray-500 uppercase tracking-wider">Share</span>
              <ShareButtons client:only="react" title={frontmatter.title} />
            </div>
            
            <div class="flex items-center gap-6">
              <LikeButton client:only="react" />
              <div class="flex items-center gap-2">
                <span class="text-sm font-medium text-gray-500 uppercase tracking-wider hidden sm:block">Save</span>
                <BookmarkButton client:only="react" title={frontmatter.title} />
              </div>
            </div>
          </div>
        </div>

        <CommentsSection client:only="react" />
      </article>
    </main>
</Layout>