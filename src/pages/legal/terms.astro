---
import Layout from '../../layouts/Layout.astro';

const title = "Terms of Service";
---

<Layout title={title}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8 font-[Fraunces]">Open Design Docs Terms of Service</h1>
    <p class="text-sm text-gray-500 mb-8">Effective: April 28, 2025</p>

    <div class="prose prose-lg">
