---
import Layout from '../layouts/Layout.astro';

// Check if user is authorized to view analytics
const ADMIN_EMAIL = 'jculbertson@gmail.com';
const ADMIN_USER_IDS = [
  'user_2ycNsYsOHZUfRlxgP2ysOCztGkt', // Production UUID
  'user_2yhwbXQyVgKDpgEisp93K3ObWSQ'  // Development/Testing UUID
];

let isAuthorized = false;
let userInfo = null;

if (Astro.locals.auth?.user) {
  const user = Astro.locals.auth.user;
  userInfo = {
    id: user.id,
    email: user.emailAddresses?.[0]?.emailAddress
  };
  
  // Check if user is authorized
  isAuthorized = userInfo.email === ADMIN_EMAIL || ADMIN_USER_IDS.includes(user.id);
  
  console.log('Analytics access check:', {
    userId: user.id,
    email: userInfo.email,
    isAuthorized
  });
}

// If not authorized, redirect to login or show access denied
if (!isAuthorized) {
  return Astro.redirect('/');
}
---

<Layout title="Analytics Dashboard">
  <div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Analytics Dashboard</h1>
        <p class="text-gray-600">Track user interactions and engagement across the platform</p>
      </div>
      
      <!-- Tab Navigation -->
      <div class="mb-6 bg-white p-4 rounded-lg shadow-sm">
        <div class="border-b border-gray-200">
          <nav class="-mb-px flex space-x-8">
            <button id="general-tab" class="tab-button active border-b-2 border-blue-500 py-3 px-4 text-sm font-medium text-blue-600 bg-blue-50 rounded-t-md">
              📊 General Analytics
            </button>
            <button id="recruiter-tab" class="tab-button border-b-2 border-transparent py-3 px-4 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 hover:bg-gray-50 rounded-t-md cursor-pointer">
              👥 Recruiter Performance
            </button>
          </nav>
        </div>
      </div>

      <!-- General Analytics Tab -->
      <div id="general-analytics" class="tab-content">
      <div id="analytics-container">
        <div class="text-center py-8">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
          <p class="mt-2 text-gray-600">Loading analytics...</p>
          </div>
        </div>
      </div>

      <!-- Recruiter Analytics Tab -->
      <div id="recruiter-analytics" class="tab-content hidden">
        <div id="recruiter-container">
          <div class="text-center py-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
            <p class="mt-2 text-gray-600">Loading recruiter analytics...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<!-- Pass user ID to client-side script -->
<script define:vars={{ userId: userInfo?.id }}>
  // Make user ID available to analytics script
  window.analyticsUserId = userId;
</script>

<script>
  // Tab switching functionality
  function switchTab(tabName) {
    // Update tab buttons
    document.querySelectorAll('.tab-button').forEach(btn => {
      btn.classList.remove('active', 'border-blue-500', 'text-blue-600');
      btn.classList.add('border-transparent', 'text-gray-500');
    });
    
    // Hide all tab content
    document.querySelectorAll('.tab-content').forEach(content => {
      content.classList.add('hidden');
    });
    
    // Show selected tab
    if (tabName === 'general') {
      document.getElementById('general-tab').classList.add('active', 'border-blue-500', 'text-blue-600');
      document.getElementById('general-tab').classList.remove('border-transparent', 'text-gray-500');
      document.getElementById('general-analytics').classList.remove('hidden');
      
      // Load general analytics if not loaded
      if (!window.generalAnalyticsLoaded) {
        loadAnalytics();
      }
    } else if (tabName === 'recruiter') {
      document.getElementById('recruiter-tab').classList.add('active', 'border-blue-500', 'text-blue-600');
      document.getElementById('recruiter-tab').classList.remove('border-transparent', 'text-gray-500');
      document.getElementById('recruiter-analytics').classList.remove('hidden');
      
      // Load recruiter analytics if not loaded
      if (!window.recruiterAnalyticsLoaded) {
        loadRecruiterAnalytics();
      }
    }
  }

  // General analytics loader
  async function loadAnalytics() {
    const container = document.getElementById('analytics-container');
    if (!container) return;
    
    try {
      const userId = window.analyticsUserId || 'anonymous';
      const response = await fetch(`/api/analytics?user_id=${userId}`);
      const result = await response.json();
      
      if (!response.ok) {
        throw new Error(result.error || 'Failed to fetch analytics');
      }
      
      if (result.success) {
        const data = result.data;
        
        container.innerHTML = `
          <div class="space-y-6">
            <!-- Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Total Events</h3>
                <p class="text-3xl font-bold text-blue-600">${data.summary.totalEvents.toLocaleString()}</p>
              </div>
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Unique Users</h3>
                <p class="text-3xl font-bold text-green-600">${data.summary.uniqueUsers.toLocaleString()}</p>
              </div>
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Sessions</h3>
                <p class="text-3xl font-bold text-purple-600">${data.summary.uniqueSessions.toLocaleString()}</p>
              </div>
            </div>
            
            <!-- Top Events -->
            <div class="bg-white p-6 rounded-lg shadow-md">
              <h3 class="text-lg font-semibold text-gray-700 mb-4">Top Events</h3>
              <div class="space-y-2">
                ${data.topEvents.map(([event, count], index) => `
                  <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                    <span class="font-medium text-gray-700">${index + 1}. ${event}</span>
                    <span class="text-blue-600 font-semibold">${count.toLocaleString()}</span>
                  </div>
                `).join('')}
              </div>
            </div>
            
            <!-- Top Pages -->
            <div class="bg-white p-6 rounded-lg shadow-md">
              <h3 class="text-lg font-semibold text-gray-700 mb-4">Top Pages</h3>
              <div class="space-y-2">
                ${data.topPages.map(([page, count], index) => `
                  <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                    <span class="font-medium text-gray-700 truncate">${index + 1}. ${page}</span>
                    <span class="text-green-600 font-semibold">${count.toLocaleString()}</span>
                  </div>
                `).join('')}
              </div>
            </div>
            
            <!-- Daily Activity -->
            <div class="bg-white p-6 rounded-lg shadow-md">
              <h3 class="text-lg font-semibold text-gray-700 mb-4">Daily Activity (Last 7 Days)</h3>
              <div class="space-y-2">
                ${data.dailyActivity.map(([date, count]) => `
                  <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                    <span class="font-medium text-gray-700">${new Date(date).toLocaleDateString()}</span>
                    <span class="text-purple-600 font-semibold">${count.toLocaleString()}</span>
                  </div>
                `).join('')}
              </div>
            </div>
            
            <!-- Date Range Info -->
            <div class="bg-gray-100 p-4 rounded-lg text-sm text-gray-600">
              <p>Data from ${new Date(data.summary.dateRange.startDate).toLocaleDateString()} to ${new Date(data.summary.dateRange.endDate).toLocaleDateString()}</p>
            </div>
          </div>
        `;
        
        window.generalAnalyticsLoaded = true;
      } else {
        throw new Error(result.error || 'Failed to load analytics');
      }
    } catch (error) {
      console.error('Error loading analytics:', error);
      container.innerHTML = `
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
          <h2 class="text-xl font-semibold text-red-600 mb-2">Error</h2>
          <p class="text-gray-600">Failed to load analytics data: ${error.message}</p>
          <button onclick="loadAnalytics()" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            Retry
          </button>
        </div>
      `;
    }
  }
  
  // Recruiter analytics loader
  async function loadRecruiterAnalytics() {
    const container = document.getElementById('recruiter-container');
    if (!container) return;
    
    try {
      const userId = window.analyticsUserId || 'anonymous';
      const response = await fetch(`/api/recruiter-analytics?user_id=${userId}`);
      const result = await response.json();
      
      if (!response.ok) {
        throw new Error(result.error || 'Failed to fetch recruiter analytics');
      }
      
      if (result.success) {
        const data = result.data;
        
        container.innerHTML = `
          <div class="space-y-6">
            <!-- Recruiter Summary Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Active Recruiters</h3>
                <p class="text-3xl font-bold text-blue-600">${data.summary.totalRecruiters}</p>
              </div>
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Profile Views</h3>
                <p class="text-3xl font-bold text-green-600">${data.summary.totalProfileViews.toLocaleString()}</p>
              </div>
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Contact Clicks</h3>
                <p class="text-3xl font-bold text-purple-600">${data.summary.totalContactClicks.toLocaleString()}</p>
              </div>
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-2">Avg. Conversion</h3>
                <p class="text-3xl font-bold text-orange-600">${data.summary.averageConversionRate}%</p>
              </div>
            </div>
            
            <!-- Recruiter Performance Table -->
            <div class="bg-white p-6 rounded-lg shadow-md">
              <h3 class="text-lg font-semibold text-gray-700 mb-4">Recruiter Performance</h3>
              <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                  <thead class="bg-gray-50">
                    <tr>
                      <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recruiter</th>
                      <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agency</th>
                      <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Profile Views</th>
                      <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact Clicks</th>
                      <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Conversion Rate</th>
                      <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Contact Types</th>
                    </tr>
                  </thead>
                  <tbody class="bg-white divide-y divide-gray-200">
                    ${data.recruiterPerformance.map((recruiter, index) => {
                      // Format all contact types as a breakdown
                      const contactTypesBreakdown = Object.entries(recruiter.contactTypes)
                        .sort(([,a], [,b]) => b - a)
                        .map(([type, count]) => `${type}: ${count}`)
                        .join(' • ') || 'None';
                      
                      return `
                        <tr class="${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}">
                          <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-gray-900">${recruiter.name}</div>
                            ${recruiter.slug ? `<div class="text-sm text-gray-500">/${recruiter.slug}</div>` : ''}
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">${recruiter.agency}</td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-blue-600">${recruiter.profileViews.toLocaleString()}</td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-purple-600">${recruiter.contactClicks.toLocaleString()}</td>
                          <td class="px-6 py-4 whitespace-nowrap">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                              parseFloat(recruiter.conversionRate) > 5 ? 'bg-green-100 text-green-800' :
                              parseFloat(recruiter.conversionRate) > 2 ? 'bg-yellow-100 text-yellow-800' :
                              'bg-red-100 text-red-800'
                            }">
                              ${recruiter.conversionRate}%
                            </span>
                          </td>
                          <td class="px-6 py-4 text-sm text-gray-500 max-w-xs">
                            <div class="truncate" title="${contactTypesBreakdown}">
                              ${contactTypesBreakdown}
                            </div>
                          </td>
                        </tr>
                      `;
                    }).join('')}
                  </tbody>
                </table>
              </div>
            </div>
            
            <!-- Contact Type Breakdown -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-4">Top Contact Types</h3>
                <div class="space-y-3">
                  ${data.topContactTypes.map(([type, count], index) => `
                    <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                      <span class="font-medium text-gray-700 capitalize">${type}</span>
                      <span class="text-blue-600 font-semibold">${count.toLocaleString()}</span>
                    </div>
                  `).join('')}
                </div>
              </div>
              
              <!-- Daily Trends -->
              <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-lg font-semibold text-gray-700 mb-4">Daily Trends (Last 14 Days)</h3>
                <div class="space-y-2 max-h-64 overflow-y-auto">
                  ${data.dailyTrends.map(day => `
                    <div class="flex justify-between items-center p-2 text-sm">
                      <span class="text-gray-600">${new Date(day.date).toLocaleDateString()}</span>
                      <div class="flex space-x-4">
                        <span class="text-blue-600">${day.totalViews} views</span>
                        <span class="text-purple-600">${day.totalContacts} contacts</span>
                      </div>
                    </div>
                  `).join('')}
                </div>
              </div>
            </div>
            
            <!-- Date Range Info -->
            <div class="bg-gray-100 p-4 rounded-lg text-sm text-gray-600">
              <p>Recruiter data from ${new Date(data.summary.dateRange.startDate).toLocaleDateString()} to ${new Date(data.summary.dateRange.endDate).toLocaleDateString()}</p>
              <p class="mt-1">Last updated: ${new Date(data.generatedAt).toLocaleString()}</p>
            </div>
          </div>
        `;
        
        window.recruiterAnalyticsLoaded = true;
      } else {
        throw new Error(result.error || 'Failed to load recruiter analytics');
      }
    } catch (error) {
      console.error('Error loading recruiter analytics:', error);
      container.innerHTML = `
        <div class="bg-white p-8 rounded-lg shadow-md text-center">
          <h2 class="text-xl font-semibold text-red-600 mb-2">Error</h2>
          <p class="text-gray-600">Failed to load recruiter analytics: ${error.message}</p>
          <button onclick="loadRecruiterAnalytics()" class="mt-4 bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">
            Retry
          </button>
        </div>
      `;
    }
  }

  // Initialize page
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🔧 Initializing analytics dashboard...');
    
    // Check if tab elements exist
    const generalTab = document.getElementById('general-tab');
    const recruiterTab = document.getElementById('recruiter-tab');
    
    if (!generalTab || !recruiterTab) {
      console.error('❌ Tab elements not found!', { generalTab, recruiterTab });
      return;
    }
    
    console.log('✅ Tab elements found, setting up event listeners...');
    
    // Set up tab switching
    generalTab.addEventListener('click', () => {
      console.log('🔄 Switching to general tab');
      switchTab('general');
    });
    
    recruiterTab.addEventListener('click', () => {
      console.log('🔄 Switching to recruiter tab');
      switchTab('recruiter');
    });
    
    // Load initial tab (general analytics)
    console.log('🚀 Loading initial general analytics tab...');
    switchTab('general');
  });
  
  // Make functions globally available
  window.loadAnalytics = loadAnalytics;
  window.loadRecruiterAnalytics = loadRecruiterAnalytics;
  window.switchTab = switchTab;
</script> 