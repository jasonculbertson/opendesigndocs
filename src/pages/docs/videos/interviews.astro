---
import WideLayout from '../../../layouts/WideLayout.astro';
import VideoCard from '../../../components/media/VideoCard.astro';
import ShortsCarousel from '../../../components/media/ShortsCarousel.astro';

// YouTube Shorts data
const shorts = [
  {
    title: 'Design maturity as a competitive edge',
    thumbnailUrl: 'https://img.youtube.com/vi/-Bc11EY3p7g/maxresdefault.jpg',
    href: 'https://youtube.com/shorts/-Bc11EY3p7g?feature=share',
    duration: '0:45'
  },
  {
    title: 'Authentic leadership',
    thumbnailUrl: 'https://img.youtube.com/vi/QTHTRlimuiY/maxresdefault.jpg', 
    href: 'https://youtube.com/shorts/QTHTRlimuiY?feature=share',
    duration: '0:52'
  },
  {
    title: 'Designing for high-stakes tools',
    thumbnailUrl: 'https://img.youtube.com/vi/gLB4PEtOgXc/maxresdefault.jpg',
    href: 'https://youtube.com/shorts/gLB4PEtOgXc?feature=share', 
    duration: '1:15'
  },
  {
    title: 'Design crits & reviews at Webflow',
    thumbnailUrl: 'https://img.youtube.com/vi/4JSpoBeA6p4/maxresdefault.jpg',
    href: 'https://youtube.com/shorts/4JSpoBeA6p4?feature=share',
    duration: '0:58'
  },
  {
    title: 'Championing design as a leader',
    thumbnailUrl: 'https://img.youtube.com/vi/5xpT9wo6Oz8/maxresdefault.jpg',
    href: 'https://youtube.com/shorts/5xpT9wo6Oz8?feature=share',
    duration: '1:02'
  },
  {
    title: 'Designing for designers',
    thumbnailUrl: 'https://img.youtube.com/vi/M2skBV54aj4/maxresdefault.jpg',
    href: 'https://youtube.com/shorts/M2skBV54aj4?feature=share',
    duration: '0:48'
  }
];

const videos = [
  {
    title: 'Latest Design Leadership Interview - New insights and career advice',
    timestamp: 'June 4, 2025',
    duration: '58:42',
    thumbnailUrl: 'https://img.youtube.com/vi/dOGCartgGSY/maxresdefault.jpg',
    href: 'https://youtu.be/dOGCartgGSY'
  },
  {
    title: 'From Opera Singer to Yahoo Design Leader: Adrian Phillips',
    timestamp: 'March 26, 2025',
    duration: '1:00:00',
    thumbnailUrl: 'https://img.youtube.com/vi/gqcGyTBV4O8/maxresdefault.jpg',
    href: 'https://youtu.be/gqcGyTBV4O8'
  },
  {
    title: 'From designer to founder — Masoud Ardestani on building Rapha and making hiring human',
    timestamp: 'November 11, 2024',
    duration: '56:16',
    thumbnailUrl: 'https://img.youtube.com/vi/SpGlXrvzQeE/maxresdefault.jpg',
    href: 'https://www.youtube.com/watch?v=SpGlXrvzQeE'
  }
];

const title = "Design Leadership Interviews";
---

<WideLayout title={title}>
  <div class="py-8">
    <div class="mb-8">
      <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      <p class="mt-2 text-[15px] text-[#3c4257]">Learn from experienced design leaders through in-depth interviews and quick insights.</p>
    </div>

    <!-- Shorts Carousel -->
    <ShortsCarousel shorts={shorts} />

    <!-- Full Interview Section -->
    <div class="mb-6">
      <h2 class="text-xl font-semibold text-[#1a1f36] mb-6">Full Interviews</h2>
      <!-- YouTube-style grid layout -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {videos.map(video => (
          <VideoCard {...video} youtube={true} />
        ))}
      </div>
    </div>
  </div>
</WideLayout>
