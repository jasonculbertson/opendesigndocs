---
import WideLayout from '../../../layouts/WideLayout.astro';
import VideoCardReact from '../../../components/media/VideoCardReact.tsx';

const videos = [
  {
    title: 'Case Study Review with Nova Hansbrough (Principal UX Designer)',
    timestamp: 'January 15, 2025',
    duration: '55:17',
    thumbnailUrl: 'https://i.ytimg.com/vi/0fDxM5-BYWg/hqdefault.jpg',
    href: 'https://youtu.be/0fDxM5-BYWg'
  },
  {
    title: 'Case Study Review - Joshua McKenzie, Sr. Product Designer',
    timestamp: 'January 6, 2024',
    duration: '41:39',
    thumbnailUrl: 'https://img.youtube.com/vi/eJ7ZRUGdUCk/maxresdefault.jpg',
    href: 'https://youtu.be/eJ7ZRUGdUCk'
  },
  {
    title: 'Peter Pilaf, Staff Product Designer',
    timestamp: 'October 15, 2025',
    duration: '1:05:42',
    thumbnailUrl: 'https://i.ytimg.com/vi/WMT7tQD6e_M/hqdefault.jpg',
    href: 'https://youtu.be/WMT7tQD6e_M'
  },
];

const title = "Design Case Studies";
const description = "Watch Jason Culbertson give in-depth feedback and coaching on real-world design case studies, helping designers grow through practical critique and actionable insights.";

// Prepare structured data for videos
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": videos.map((video, index) => ({
    "@type": "VideoObject",
    "position": index + 1,
    "name": video.title,
    "description": description,
    "thumbnailUrl": video.thumbnailUrl,
    "uploadDate": video.timestamp,
    "duration": video.duration,
    "url": video.href
  }))
};
---

<WideLayout title={title}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="py-8">
    <div class="mb-8">
      <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      <p class="mt-2 text-[15px] text-[#3c4257]">In-depth feedback and coaching on real-world design case studies.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {videos.map(video => (
        <VideoCardReact {...video} youtube={true} client:load />
      ))}
    </div>
  </div>
</WideLayout>
