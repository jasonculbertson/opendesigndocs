---
import Layout from '../../layouts/Layout.astro';
import ReviewsAIChat from '../../components/ReviewsAIChat.tsx';
import AnalyticsButton from '../../components/AnalyticsButton.tsx';

const title = "ReviewsAI - Annual Review Assistant";
const description = "AI-powered assistant for creating comprehensive annual performance reviews";
---

<Layout title={title}>
  <div class="relative">
    <!-- Analytics Link - Only visible to specific user -->
    <div class="absolute top-4 right-4 z-10">
      <AnalyticsButton client:load />
    </div>
    
    <ReviewsAIChat client:load />
  </div>
</Layout>

<style>
  .chat-container {
    height: calc(100vh - 200px);
    min-height: 600px;
  }
</style> 