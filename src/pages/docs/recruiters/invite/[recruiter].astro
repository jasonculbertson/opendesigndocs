---
import WideLayout from '../../../../layouts/WideLayout.astro';

// Define recruiter data
const recruiters = {
  'laura': {
    name: 'Laura Hunting',
    email: 'laura@foundby.co',
    agency: 'Found By',
    title: 'Founding Partner',
    image: '/images/laura.jpeg',
    profileUrl: '/docs/recruiters/laura-hunting'
  },
  'garrett': {
    name: 'Garrett Fowler', 
    email: 'garrett@off.site',
    agency: 'Offsite',
    title: 'Founder',
    image: '/images/garrett.jpeg',
    profileUrl: '/docs/recruiters/garrett-fowler'
  },
  'dirk': {
    name: 'Dirk Cleveland',
    email: 'dirk@fusiontalent.com', 
    agency: 'Fusion',
    title: 'Executive Recruiter',
    image: '/images/dirk.jpeg',
    profileUrl: '/docs/recruiters/dirk-cleveland'
  },
  'jared': {
    name: 'Jared Tredly',
    email: 'jared@bamboocrowd.com',
    agency: 'Bamboo X',
    title: 'Design Recruiter', 
    image: '/images/jared.jpeg',
    profileUrl: '/docs/recruiters/jared-tredly'
  },
  'mj': {
    name: 'Monica (MJ) Jin',
    email: 'mj@off.site',
    agency: 'Offsite',
    title: 'Talent Director',
    image: '/images/mj.jpeg',
    profileUrl: '/docs/recruiters/mj'
  }
};

export async function getStaticPaths() {
  return Object.keys(recruiters).map((key) => ({
    params: { recruiter: key },
    props: { recruiterData: recruiters[key] },
  }));
}

const { recruiter } = Astro.params;
const recruiterData = recruiters[recruiter as keyof typeof recruiters];

if (!recruiterData) {
  return Astro.redirect('/docs/recruiters');
}

const title = `Welcome ${recruiterData.name} - Open Design Docs`;
const description = `Personal invitation for ${recruiterData.name} to join Open Design Docs`;
---

<WideLayout title={title} description={description}>
  <div class="py-8 max-w-4xl mx-auto">
    <!-- Personal Welcome Header -->
    <div class="text-center mb-12">
      <!-- Profile Photo -->
      <div class="mb-8">
        <img
          src={recruiterData.image}
          alt={`${recruiterData.name} profile`}
          class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-xl mx-auto"
          style="box-shadow: 0 8px 32px -8px rgba(0,0,0,0.15)"
        />
      </div>
      
      <!-- Welcome Message -->
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-[#1a1f36] mb-3 tracking-[-0.5px]">
          Welcome, {recruiterData.name}!
        </h1>
        <p class="text-xl text-gray-600 mb-2">
          {recruiterData.title} at {recruiterData.agency}
        </p>
        <p class="text-lg text-gray-500">
          You've been invited to manage your recruiter profile on Open Design Docs
        </p>
      </div>
      
      <!-- Elegant divider -->
      <div class="flex items-center justify-center mb-8">
        <div class="h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent w-64"></div>
      </div>
    </div>

    <!-- Profile Overview Card -->
    <div class="bg-white rounded-2xl border border-gray-200 p-8 mb-8 shadow-sm" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
      <div class="text-center mb-6">
        <h2 class="text-2xl font-semibold text-[#1a1f36] mb-2">Your Profile Overview</h2>
        <p class="text-gray-600">Here's what we have on file for you</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="text-center p-4 bg-gray-50 rounded-xl">
          <div class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-1">Name</div>
          <div class="text-lg font-semibold text-gray-900">{recruiterData.name}</div>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-xl">
          <div class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-1">Agency</div>
          <div class="text-lg font-semibold text-gray-900">{recruiterData.agency}</div>
        </div>
        <div class="text-center p-4 bg-gray-50 rounded-xl">
          <div class="text-sm font-medium text-gray-500 uppercase tracking-wide mb-1">Email</div>
          <div class="text-sm font-mono font-semibold text-gray-900 break-all">{recruiterData.email}</div>
        </div>
      </div>
    </div>

    <!-- Getting Started Steps -->
    <div class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-semibold text-[#1a1f36] mb-2">Getting Started</h2>
        <p class="text-gray-600">Just two simple steps to access your profile</p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Step 1: Create Account -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
          <div class="text-center mb-6">
            <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-2xl flex items-center justify-center text-xl font-bold mx-auto mb-4">
              1
            </div>
            <h3 class="text-xl font-semibold text-[#1a1f36] mb-2">Create Your Account</h3>
            <p class="text-gray-600 text-sm">Sign up using your professional email address</p>
          </div>
          
          <div class="space-y-4">
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
              <div class="text-sm font-medium text-blue-800 mb-1">Use this email:</div>
              <div class="font-mono text-blue-900 font-semibold break-all">{recruiterData.email}</div>
            </div>
            
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-4">
              <div class="flex items-start">
                <svg class="w-5 h-5 text-amber-600 mt-0.5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <div class="text-sm text-amber-800">
                  <strong>Important:</strong> You must use exactly this email address to access your profile.
                </div>
              </div>
            </div>
            
            <button 
              onclick="handleSignUp()"
              class="w-full inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-600 to-blue-700 text-white font-semibold rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all duration-200 shadow-lg hover:shadow-xl"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
              </svg>
              Sign Up / Log In
            </button>
          </div>
        </div>

        <!-- Step 2: Access Profile -->
        <div class="bg-white rounded-2xl border border-gray-200 p-8 shadow-sm" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
          <div class="text-center mb-6">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-2xl flex items-center justify-center text-xl font-bold mx-auto mb-4">
              2
            </div>
            <h3 class="text-xl font-semibold text-[#1a1f36] mb-2">Edit Your Profile</h3>
            <p class="text-gray-600 text-sm">Customize your information and showcase your expertise</p>
          </div>
          
          <div class="space-y-4">
            <div class="bg-gray-50 rounded-xl p-4">
              <p class="text-sm text-gray-700 mb-3">
                Once logged in, you'll see an "Edit Profile" button on your profile page where you can update:
              </p>
              <div class="grid grid-cols-2 gap-2 text-xs">
                <div class="flex items-center text-gray-600">
                  <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  About section
                </div>
                <div class="flex items-center text-gray-600">
                  <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Specialties
                </div>
                <div class="flex items-center text-gray-600">
                  <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Philosophy
                </div>
                <div class="flex items-center text-gray-600">
                  <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Approach
                </div>
                <div class="flex items-center text-gray-600">
                  <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Contact info
                </div>
                <div class="flex items-center text-gray-600">
                  <svg class="w-3 h-3 text-green-500 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  Notable clients
                </div>
              </div>
            </div>
            
            <a 
              href={recruiterData.profileUrl}
              class="w-full inline-flex items-center justify-center px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-xl hover:bg-gray-200 transition-colors"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              Preview Your Profile
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Help Section -->
    <div class="bg-white rounded-2xl border border-gray-200 p-8 text-center shadow-sm" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
      <div class="mb-4">
        <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-[#1a1f36] mb-2">Need Help?</h3>
      <p class="text-gray-600 mb-4">
        If you run into any issues or have questions about your profile, I'm here to help.
      </p>
      <a 
        href="mailto:jculbertson@gmail.com" 
        class="inline-flex items-center px-6 py-3 bg-gray-100 text-gray-700 font-semibold rounded-xl hover:bg-gray-200 transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        Contact Jason
      </a>
    </div>


  </div>

  <script>
    function handleSignUp() {
      // Store the recruiter's profile URL for redirect after login
      const profileUrl = '{recruiterData.profileUrl}';
      localStorage.setItem('recruiter_redirect_url', profileUrl);
      
      // Redirect to login page
      window.location.href = '/login';
    }

    // Check if user just logged in and redirect to their profile
    document.addEventListener('DOMContentLoaded', function() {
      const redirectUrl = localStorage.getItem('recruiter_redirect_url');
      if (redirectUrl && typeof window !== 'undefined' && window.Clerk) {
        window.Clerk.load().then(() => {
          if (window.Clerk.user) {
            // User is logged in, redirect to their profile
            localStorage.removeItem('recruiter_redirect_url');
            window.location.href = redirectUrl;
          }
        });
      }
    });
  </script>
</WideLayout>
