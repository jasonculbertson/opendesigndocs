---
import WideLayout from '../../../layouts/WideLayout.astro';
---

<WideLayout title="Recruiter Onboarding - Open Design Docs" description="Get started with your recruiter profile on Open Design Docs">
  <div class="py-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">Welcome to Open Design Docs</h1>
      <p class="text-lg text-gray-600">Get started with your recruiter profile in just a few steps</p>
    </div>

    <!-- Steps -->
    <div class="space-y-8">
      <!-- Step 1 -->
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-semibold">1</div>
          </div>
          <div class="ml-4">
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Create Your Account</h2>
            <p class="text-gray-600 mb-4">Sign up using the same email address associated with your recruiter profile.</p>
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
              <p class="text-sm text-blue-800">
                <strong>Important:</strong> You must use your professional email address that's already in our system:
              </p>
              <ul class="mt-2 text-sm text-blue-700 space-y-1">
                <li>• Laura Hunting: <code class="bg-blue-100 px-2 py-1 rounded">laura@foundby.co</code></li>
                <li>• Garrett Fowler: <code class="bg-blue-100 px-2 py-1 rounded">garrett@off.site</code></li>
                <li>• Dirk Cleveland: <code class="bg-blue-100 px-2 py-1 rounded">dirk@fusiontalent.com</code></li>
                <li>• Jared Tredly: <code class="bg-blue-100 px-2 py-1 rounded">jared@bamboocrowd.com</code></li>
                <li>• Monica (MJ) Jin: <code class="bg-blue-100 px-2 py-1 rounded">mj@off.site</code></li>
              </ul>
            </div>
            <button 
              onclick="window.location.href='/login'"
              class="inline-flex items-center px-4 py-2 bg-blue-600 text-white font-medium rounded-md hover:bg-blue-700 transition-colors"
            >
              Sign Up / Log In
            </button>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-semibold">2</div>
          </div>
          <div class="ml-4">
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Access Your Profile</h2>
            <p class="text-gray-600 mb-4">Once logged in, navigate to your recruiter profile page.</p>
            <div class="space-y-2">
              <a href="/docs/recruiters/laura-hunting" class="block text-blue-600 hover:text-blue-800 underline">Laura Hunting Profile →</a>
              <a href="/docs/recruiters/garrett-fowler" class="block text-blue-600 hover:text-blue-800 underline">Garrett Fowler Profile →</a>
              <a href="/docs/recruiters/dirk-cleveland" class="block text-blue-600 hover:text-blue-800 underline">Dirk Cleveland Profile →</a>
              <a href="/docs/recruiters/jared-tredly" class="block text-blue-600 hover:text-blue-800 underline">Jared Tredly Profile →</a>
              <a href="/docs/recruiters/mj" class="block text-blue-600 hover:text-blue-800 underline">Monica (MJ) Jin Profile →</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="bg-white rounded-lg border border-gray-200 p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <div class="w-8 h-8 bg-purple-500 text-white rounded-full flex items-center justify-center font-semibold">3</div>
          </div>
          <div class="ml-4">
            <h2 class="text-xl font-semibold text-gray-900 mb-2">Edit Your Profile</h2>
            <p class="text-gray-600 mb-4">When logged in with the correct email, you'll see an "Edit Profile" button on your profile page.</p>
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
              <p class="text-sm text-gray-700">
                <strong>Note:</strong> The edit button only appears when you're logged in with the email address that matches your profile. 
                If you don't see it, make sure you're using the correct email address from Step 1.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Troubleshooting -->
    <div class="mt-12 bg-yellow-50 border border-yellow-200 rounded-lg p-6">
      <h2 class="text-lg font-semibold text-yellow-800 mb-2">Troubleshooting</h2>
      <div class="space-y-3 text-sm text-yellow-700">
        <div>
          <strong>Can't see the edit button?</strong>
          <p>Make sure you're logged in with the exact email address listed above for your profile.</p>
        </div>
        <div>
          <strong>Getting authentication errors?</strong>
          <p>Try logging out and logging back in. Clear your browser cache if the issue persists.</p>
        </div>
        <div>
          <strong>Need help?</strong>
          <p>Contact <a href="mailto:jculbertson@gmail.com" class="underline">jculbertson@gmail.com</a> for assistance.</p>
        </div>
      </div>
    </div>

    <!-- Back to Recruiters -->
    <div class="mt-8 text-center">
      <a 
        href="/docs/recruiters"
        class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to All Recruiters
      </a>
    </div>
  </div>
</WideLayout>
