---
import WideLayout from '../../../layouts/WideLayout.astro';

// Temporary fallback: Allow access with URL parameter while debugging server auth
const url = new URL(Astro.request.url);
const adminKey = url.searchParams.get('admin');
const hasUrlAccess = adminKey === 'jason2024';

// Check for proper admin access via Clerk authentication
const ADMIN_EMAIL = 'jculbertson@gmail.com';
const ADMIN_USER_IDS = [
  'user_2ycNsYsOHZUfRlxgP2ysOCztGkt', // Production
  'user_2yhwbXQyVgKDpgEisp93K3ObWSQ'  // Development
];

// Get user from Clerk auth
let isAdmin = false;
let userEmail = null;

if (Astro.locals.auth?.user) {
  userEmail = Astro.locals.auth.user.primaryEmailAddress?.emailAddress;
  const userId = Astro.locals.auth.user.id;
  isAdmin = userEmail === ADMIN_EMAIL || ADMIN_USER_IDS.includes(userId);
}

// Debug info for troubleshooting
console.log('🔍 Email tracking page auth debug:', {
  hasUrlAccess,
  isAdmin,
  userEmail,
  authUser: Astro.locals.auth?.user ? 'exists' : 'missing',
  adminKey
});

// TEMPORARY: Allow all access for debugging
// TODO: Re-enable authentication once working
// if (!isAdmin && !hasUrlAccess) {
//   console.log('❌ Access denied - redirecting to recruiters page');
//   return Astro.redirect('/docs/recruiters');
// }

console.log('✅ Access granted to email tracking dashboard');

const title = "Email Tracking Dashboard";
const description = "Monitor recruiter email engagement and onboarding progress";
---

<WideLayout title={title} description={description}>
  <div class="py-8 max-w-6xl mx-auto">
    
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">{title}</h1>
      <p class="text-gray-600">Real-time monitoring of recruiter email engagement and onboarding funnel.</p>
    </div>

    <!-- Loading State -->
    <div id="loading" class="text-center py-8">
      <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div>
      <p class="mt-2 text-gray-600">Loading tracking data...</p>
    </div>

    <!-- Dashboard Content -->
    <div id="dashboard" class="hidden">
      
      <!-- Summary Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow p-6 border">
          <div class="flex items-center">
            <div class="p-2 bg-blue-100 rounded-lg">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Emails Sent</p>
              <p class="text-2xl font-bold text-gray-900" id="emails-sent">0</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border">
          <div class="flex items-center">
            <div class="p-2 bg-green-100 rounded-lg">
              <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Emails Opened</p>
              <p class="text-2xl font-bold text-gray-900" id="emails-opened">0</p>
              <p class="text-xs text-gray-500" id="open-rate">0% open rate</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border">
          <div class="flex items-center">
            <div class="p-2 bg-purple-100 rounded-lg">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Page Visits</p>
              <p class="text-2xl font-bold text-gray-900" id="page-visits">0</p>
              <p class="text-xs text-gray-500" id="click-rate">0% click rate</p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-lg shadow p-6 border">
          <div class="flex items-center">
            <div class="p-2 bg-orange-100 rounded-lg">
              <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <div class="ml-4">
              <p class="text-sm font-medium text-gray-600">Signups</p>
              <p class="text-2xl font-bold text-gray-900" id="signups">0</p>
              <p class="text-xs text-gray-500" id="conversion-rate">0% conversion</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Recruiter Progress Table -->
      <div class="bg-white rounded-lg shadow border">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">Recruiter Progress</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recruiter</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email Sent</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Opened</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Visited</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Signed Up</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody id="recruiter-table" class="bg-white divide-y divide-gray-200">
              <!-- Will be populated by JavaScript -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Recent Events -->
      <div class="mt-8 bg-white rounded-lg shadow border">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-lg font-medium text-gray-900">Recent Activity</h3>
        </div>
        <div class="px-6 py-4 max-h-96 overflow-y-auto">
          <ul id="recent-events" class="space-y-3">
            <!-- Will be populated by JavaScript -->
          </ul>
        </div>
      </div>
    </div>

  </div>

  <script>
    let trackingData = {};

    // Fetch tracking data
    async function fetchTrackingData() {
      try {
        const response = await fetch('/api/email-tracking-dashboard?admin=jason2024');
        if (!response.ok) throw new Error('Failed to fetch data');
        
        trackingData = await response.json();
        updateDashboard();
        
      } catch (error) {
        console.error('Error fetching tracking data:', error);
        document.getElementById('loading').innerHTML = `
          <div class="text-center py-8 text-red-600">
            <p>Error loading tracking data</p>
            <button onclick="fetchTrackingData()" class="mt-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
              Retry
            </button>
          </div>
        `;
      }
    }

    function updateDashboard() {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('dashboard').classList.remove('hidden');
      
      // Update summary cards
      const { summary, recruiters, events } = trackingData;
      
      document.getElementById('emails-sent').textContent = summary.emailsSent || 0;
      document.getElementById('emails-opened').textContent = summary.emailsOpened || 0;
      document.getElementById('page-visits').textContent = summary.pageVisits || 0;
      document.getElementById('signups').textContent = summary.signups || 0;
      
      // Calculate rates
      const openRate = summary.emailsSent > 0 ? Math.round((summary.emailsOpened / summary.emailsSent) * 100) : 0;
      const clickRate = summary.emailsOpened > 0 ? Math.round((summary.pageVisits / summary.emailsOpened) * 100) : 0;
      const conversionRate = summary.pageVisits > 0 ? Math.round((summary.signups / summary.pageVisits) * 100) : 0;
      
      document.getElementById('open-rate').textContent = `${openRate}% open rate`;
      document.getElementById('click-rate').textContent = `${clickRate}% click rate`;
      document.getElementById('conversion-rate').textContent = `${conversionRate}% conversion`;
      
      // Update recruiter table
      const tableBody = document.getElementById('recruiter-table');
      tableBody.innerHTML = recruiters.map(recruiter => `
        <tr>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex items-center">
              <div class="text-sm font-medium text-gray-900">${recruiter.name}</div>
              <div class="text-sm text-gray-500">${recruiter.email}</div>
            </div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            ${recruiter.emailSent ? `<span class="text-green-600">✓</span> ${new Date(recruiter.emailSent).toLocaleDateString()}` : '<span class="text-gray-400">-</span>'}
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            ${recruiter.emailOpened ? `<span class="text-green-600">✓</span> ${new Date(recruiter.emailOpened).toLocaleDateString()}` : '<span class="text-gray-400">-</span>'}
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            ${recruiter.pageVisited ? `<span class="text-green-600">✓</span> ${new Date(recruiter.pageVisited).toLocaleDateString()}` : '<span class="text-gray-400">-</span>'}
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            ${recruiter.signedUp ? `<span class="text-green-600">✓</span> ${new Date(recruiter.signedUp).toLocaleDateString()}` : '<span class="text-gray-400">-</span>'}
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <span class="px-2 py-1 text-xs font-medium rounded-full ${getStatusBadgeClass(recruiter.status)}">
              ${recruiter.status}
            </span>
          </td>
        </tr>
      `).join('');
      
      // Update recent events
      const eventsList = document.getElementById('recent-events');
      eventsList.innerHTML = events.slice(0, 10).map(event => `
        <li class="flex items-center space-x-3">
          <div class="flex-shrink-0">
            ${getEventIcon(event.event_type)}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900">${event.recruiter_name}</p>
            <p class="text-sm text-gray-500">${getEventDescription(event.event_type)} • ${new Date(event.timestamp).toLocaleString()}</p>
          </div>
        </li>
      `).join('');
    }

    function getStatusBadgeClass(status) {
      switch(status) {
        case 'completed': return 'bg-green-100 text-green-800';
        case 'in_progress': return 'bg-yellow-100 text-yellow-800';
        case 'bounced': return 'bg-red-100 text-red-800';
        default: return 'bg-gray-100 text-gray-800';
      }
    }

    function getEventIcon(eventType) {
      const icons = {
        email_sent: '📧',
        email_opened: '👀',
        page_visited: '🔗',
        signup_started: '🚀',
        profile_accessed: '👤',
        profile_edited: '✏️'
      };
      return icons[eventType] || '📊';
    }

    function getEventDescription(eventType) {
      const descriptions = {
        email_sent: 'Invitation email sent',
        email_opened: 'Opened email',
        page_visited: 'Visited invite page',
        signup_started: 'Started signup process',
        profile_accessed: 'Accessed profile',
        profile_edited: 'Edited profile'
      };
      return descriptions[eventType] || eventType;
    }

    // Auto-refresh every 30 seconds
    setInterval(fetchTrackingData, 30000);
    
    // Initial load
    fetchTrackingData();
  </script>
</WideLayout>
