---
import WideLayout from '../../../layouts/WideLayout.astro';
---

<WideLayout title="Recruiter Admin" currentPath="/docs/recruiters/admin">
  <div class="max-w-4xl mx-auto p-6">
    <div id="admin-content" style="display: none;">
      <h1 class="text-3xl font-bold mb-8">Recruiter Admin Dashboard</h1>
      
      <!-- Add New Recruiter Form -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-6">Add New Recruiter</h2>
        
        <form id="recruiter-form" class="space-y-6">
          <!-- Basic Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Name *</label>
              <input type="text" id="name" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Laura Hunting">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
              <input type="email" id="email" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="laura@foundby.co">
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Agency *</label>
              <input type="text" id="agency" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Found By">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Title *</label>
              <input type="text" id="title" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Executive Recruiter">
            </div>
          </div>

          <!-- Social/Web -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">LinkedIn URL</label>
              <input type="url" id="linkedin" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://linkedin.com/in/username">
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Website</label>
              <input type="url" id="website" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://foundby.co">
            </div>
          </div>

          <!-- Profile Content -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">About</label>
            <textarea id="about" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Brief bio and background..."></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Specialties</label>
            <input type="text" id="specialties" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Design Leadership, UX Research, Product Design">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Philosophy</label>
            <textarea id="philosophy" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Recruiting philosophy and approach..."></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Approach</label>
            <textarea id="approach" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="How they work with candidates..."></textarea>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Notable Clients</label>
            <input type="text" id="notable_clients" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="SaaS, FinTech, E-commerce companies">
          </div>

                        <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Profile Image</label>
                <div class="space-y-4">
                  <!-- Image Preview -->
                  <div class="flex items-center space-x-4">
                    <div class="w-20 h-20 rounded-full overflow-hidden bg-gray-100 border-2 border-gray-200">
                      <img id="image-preview" src="/images/default-avatar.png" alt="Profile preview" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1">
                      <input type="file" id="image-upload" accept="image/*" class="hidden">
                      <button type="button" onclick="document.getElementById('image-upload').click()" 
                              class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm">
                        Choose Image
                      </button>
                      <p class="text-xs text-gray-500 mt-1">JPG, PNG, or GIF (max 2MB)</p>
                    </div>
                  </div>
                  <!-- Manual Path Input (fallback) -->
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Or enter image path manually:</label>
                    <input type="text" id="image" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="/images/laura.jpeg">
                  </div>
                </div>
              </div>

          <!-- Auto-generated fields (read-only) -->
          <div class="bg-gray-50 p-4 rounded-md">
            <h3 class="text-lg font-medium mb-3">Auto-Generated</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                <input type="text" id="slug" readonly class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md" placeholder="Will be generated from name">
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Profile URL</label>
                <input type="text" id="profile_url" readonly class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md" placeholder="Will be generated from slug">
              </div>
            </div>
          </div>

          <div class="flex gap-4">
            <button type="button" id="generate-slug" class="px-4 py-2 bg-gray-600 text-white rounded-md hover:bg-gray-700 transition-colors">
              Generate Slug
            </button>
            <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
              Add Recruiter
            </button>
          </div>
        </form>
      </div>

      <!-- Invitation Links -->
      <div class="bg-white rounded-lg shadow-md p-6 mb-8">
        <h2 class="text-2xl font-semibold mb-6">Invitation Links</h2>
        <p class="text-gray-600 mb-4">Click these personalized invitation URLs to view or test them:</p>
        <div id="invitation-links" class="space-y-3">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>

      <!-- Existing Recruiters -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-2xl font-semibold mb-6">Current Recruiters</h2>
        <div id="recruiters-list" class="space-y-4">
          <!-- Will be populated by JavaScript -->
        </div>
      </div>
    </div>

    <!-- Edit Recruiter Modal -->
    <div id="edit-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
      <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-screen overflow-y-auto">
          <div class="p-6">
            <div class="flex justify-between items-center mb-6">
              <h2 class="text-2xl font-semibold">Edit Recruiter</h2>
              <button id="close-modal" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
            </div>
            
            <form id="edit-recruiter-form" class="space-y-6">
              <input type="hidden" id="edit-id">
              
              <!-- Basic Info -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Name *</label>
                  <input type="text" id="edit-name" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                  <input type="email" id="edit-email" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Agency *</label>
                  <input type="text" id="edit-agency" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Title *</label>
                  <input type="text" id="edit-title" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
              </div>

              <!-- Social/Web -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">LinkedIn URL</label>
                  <input type="url" id="edit-linkedin" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Website</label>
                  <input type="url" id="edit-website" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
              </div>

              <!-- Profile Content -->
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">About</label>
                <textarea id="edit-about" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Specialties</label>
                <input type="text" id="edit-specialties" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Philosophy</label>
                <textarea id="edit-philosophy" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Approach</label>
                <textarea id="edit-approach" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Notable Clients</label>
                <input type="text" id="edit-notable_clients" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Profile Image</label>
                <div class="space-y-4">
                  <!-- Image Preview -->
                  <div class="flex items-center space-x-4">
                    <div class="w-20 h-20 rounded-full overflow-hidden bg-gray-100 border-2 border-gray-200">
                      <img id="edit-image-preview" src="/images/default-avatar.png" alt="Profile preview" class="w-full h-full object-cover">
                    </div>
                    <div class="flex-1">
                      <input type="file" id="edit-image-upload" accept="image/*" class="hidden">
                      <button type="button" onclick="document.getElementById('edit-image-upload').click()" 
                              class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors text-sm">
                        Choose Image
                      </button>
                      <p class="text-xs text-gray-500 mt-1">JPG, PNG, or GIF (max 2MB)</p>
                    </div>
                  </div>
                  <!-- Manual Path Input (fallback) -->
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Or enter image path manually:</label>
                    <input type="text" id="edit-image" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
                  </div>
                </div>
              </div>

              <!-- Read-only fields -->
              <div class="bg-gray-50 p-4 rounded-md">
                <h3 class="text-lg font-medium mb-3">Auto-Generated (Read-Only)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
                    <input type="text" id="edit-slug" readonly class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md">
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Login Email</label>
                    <input type="text" id="edit-login_email" readonly class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded-md">
                  </div>
                </div>
              </div>

              <div class="flex gap-4 pt-4">
                <button type="button" id="cancel-edit" class="px-4 py-2 bg-gray-500 text-white rounded-md hover:bg-gray-600 transition-colors">
                  Cancel
                </button>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                  Update Recruiter
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Access Denied Message -->
    <div id="access-denied" class="text-center py-12">
      <h1 class="text-2xl font-bold text-gray-800 mb-4">Access Restricted</h1>
      <p class="text-gray-600">This page is only accessible to authorized administrators.</p>
      <p class="text-sm text-gray-500 mt-2">Please sign in with an authorized account.</p>
    </div>

    <!-- Loading State -->
    <div id="loading" class="text-center py-12">
      <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto"></div>
      <p class="text-gray-600 mt-4">Checking access...</p>
    </div>
  </div>

  <script>
    
    // Admin email - only this email can access the page
    const ADMIN_EMAIL = 'jculbertson@gmail.com';
    
    let isAuthorized = false;

    // Check if user is authorized
    async function checkAccess() {
      try {
        // Wait for Clerk to load
        if (typeof window !== 'undefined' && window.Clerk) {
          await window.Clerk.load();
          
          const user = window.Clerk.user;
          if (user && user.primaryEmailAddress?.emailAddress === ADMIN_EMAIL) {
            isAuthorized = true;
            showAdminContent();
            loadRecruiters();
          } else {
            showAccessDenied();
          }
        } else {
          showAccessDenied();
        }
      } catch (error) {
        console.error('Access check failed:', error);
        showAccessDenied();
      }
    }

    function showAdminContent() {
      document.getElementById('loading').style.display = 'none';
      document.getElementById('access-denied').style.display = 'none';
      document.getElementById('admin-content').style.display = 'block';
    }

    function showAccessDenied() {
      document.getElementById('loading').style.display = 'none';
      document.getElementById('admin-content').style.display = 'none';
      document.getElementById('access-denied').style.display = 'block';
    }

    // Generate slug from name
    function generateSlug(name) {
      return name
        .toLowerCase()
        .replace(/[^a-z0-9\s-]/g, '') // Remove special characters
        .replace(/\s+/g, '-') // Replace spaces with hyphens
        .replace(/-+/g, '-') // Replace multiple hyphens with single
        .trim();
    }

    // Auto-generate slug when name changes
    document.addEventListener('DOMContentLoaded', () => {
      const nameInput = document.getElementById('name');
      const slugInput = document.getElementById('slug');
      const profileUrlInput = document.getElementById('profile_url');

      nameInput?.addEventListener('input', (e) => {
        const slug = generateSlug(e.target.value);
        slugInput.value = slug;
        profileUrlInput.value = slug ? `/docs/recruiters/${slug}` : '';
      });

      // Generate slug button
      document.getElementById('generate-slug')?.addEventListener('click', () => {
        const name = nameInput.value;
        if (name) {
          const slug = generateSlug(name);
          slugInput.value = slug;
          profileUrlInput.value = `/docs/recruiters/${slug}`;
        }
      });

      // Form submission
      document.getElementById('recruiter-form')?.addEventListener('submit', handleFormSubmit);

      // Check access on page load
      checkAccess();
    });

    async function handleFormSubmit(e) {
      e.preventDefault();
      
      if (!isAuthorized) {
        alert('Unauthorized access');
        return;
      }

      const formData = new FormData(e.target);
      const recruiterData = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        agency: document.getElementById('agency').value,
        title: document.getElementById('title').value,
        linkedin: document.getElementById('linkedin').value,
        website: document.getElementById('website').value,
        about: document.getElementById('about').value,
        specialties: document.getElementById('specialties').value,
        philosophy: document.getElementById('philosophy').value,
        approach: document.getElementById('approach').value,
        notable_clients: document.getElementById('notable_clients').value,
        image: document.getElementById('image').value,
        slug: document.getElementById('slug').value,
        login_email: document.getElementById('email').value // Use email as login_email
      };

      try {
        const response = await fetch('/api/recruiters/add', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-email': ADMIN_EMAIL
          },
          body: JSON.stringify(recruiterData)
        });

        if (response.ok) {
          alert('Recruiter added successfully!');
          e.target.reset();
          loadRecruiters(); // Refresh the list
        } else {
          const error = await response.text();
          alert(`Error: ${error}`);
        }
      } catch (error) {
        console.error('Error adding recruiter:', error);
        alert('Failed to add recruiter');
      }
    }



    function displayRecruiters(recruiters) {
      const container = document.getElementById('recruiters-list');
      if (!container) return;

      container.innerHTML = recruiters.map(recruiter => `
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <img src="${recruiter.image}" alt="${recruiter.name}" class="w-12 h-12 rounded-full object-cover">
              <div>
                <h3 class="font-semibold">${recruiter.name}</h3>
                <p class="text-sm text-gray-600">${recruiter.email}</p>
                <p class="text-sm text-gray-500">${recruiter.agency} • ${recruiter.title}</p>
              </div>
            </div>
            <div class="flex space-x-2">
              <button onclick="editRecruiter(${recruiter.id})" 
                      class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded text-sm hover:bg-yellow-200">
                Edit
              </button>
              <a href="/docs/recruiters/invite/${recruiter.slug}" target="_blank" 
                 class="px-3 py-1 bg-blue-100 text-blue-700 rounded text-sm hover:bg-blue-200">
                Invite Link
              </a>
              <a href="/docs/recruiters/${recruiter.slug}" target="_blank"
                 class="px-3 py-1 bg-green-100 text-green-700 rounded text-sm hover:bg-green-200">
                View Profile
              </a>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Store recruiters data for editing
    let recruitersData = [];

    async function loadRecruiters() {
      if (!isAuthorized) return;

      try {
        const response = await fetch('/api/recruiters/list', {
          headers: {
            'x-admin-email': ADMIN_EMAIL
          }
        });
        
        if (response.ok) {
          recruitersData = await response.json();
          displayRecruiters(recruitersData);
          displayInvitationLinks(recruitersData);
        }
      } catch (error) {
        console.error('Error loading recruiters:', error);
      }
    }

    // Edit recruiter functionality
    function editRecruiter(id) {
      const recruiter = recruitersData.find(r => r.id === id);
      if (!recruiter) return;

      // Populate edit form
      document.getElementById('edit-id').value = recruiter.id;
      document.getElementById('edit-name').value = recruiter.name || '';
      document.getElementById('edit-email').value = recruiter.email || '';
      document.getElementById('edit-agency').value = recruiter.agency || '';
      document.getElementById('edit-title').value = recruiter.title || '';
      document.getElementById('edit-linkedin').value = recruiter.linkedin || '';
      document.getElementById('edit-website').value = recruiter.website || '';
      document.getElementById('edit-about').value = recruiter.about || '';
      document.getElementById('edit-specialties').value = recruiter.specialties || '';
      document.getElementById('edit-philosophy').value = recruiter.philosophy || '';
      document.getElementById('edit-approach').value = recruiter.approach || '';
      document.getElementById('edit-notable_clients').value = recruiter.notable_clients || '';
      document.getElementById('edit-image').value = recruiter.image || '';
      document.getElementById('edit-slug').value = recruiter.slug || '';
      document.getElementById('edit-login_email').value = recruiter.login_email || '';

      // Update image preview
      const editImagePreview = document.getElementById('edit-image-preview');
      if (editImagePreview && recruiter.image) {
        editImagePreview.src = recruiter.image;
      }

      // Show modal
      document.getElementById('edit-modal').classList.remove('hidden');
    }

    // Modal event handlers
    document.addEventListener('DOMContentLoaded', () => {
      // Close modal handlers
      document.getElementById('close-modal')?.addEventListener('click', closeEditModal);
      document.getElementById('cancel-edit')?.addEventListener('click', closeEditModal);
      
      // Click outside to close
      document.getElementById('edit-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'edit-modal') {
          closeEditModal();
        }
      });

      // Edit form submission
      document.getElementById('edit-recruiter-form')?.addEventListener('submit', handleEditSubmit);
    });

    function closeEditModal() {
      document.getElementById('edit-modal').classList.add('hidden');
    }

    async function handleEditSubmit(e) {
      e.preventDefault();
      
      if (!isAuthorized) {
        alert('Unauthorized access');
        return;
      }

      const id = document.getElementById('edit-id').value;
      const updatedData = {
        name: document.getElementById('edit-name').value,
        email: document.getElementById('edit-email').value,
        agency: document.getElementById('edit-agency').value,
        title: document.getElementById('edit-title').value,
        linkedin: document.getElementById('edit-linkedin').value,
        website: document.getElementById('edit-website').value,
        about: document.getElementById('edit-about').value,
        specialties: document.getElementById('edit-specialties').value,
        philosophy: document.getElementById('edit-philosophy').value,
        approach: document.getElementById('edit-approach').value,
        notable_clients: document.getElementById('edit-notable_clients').value,
        image: document.getElementById('edit-image').value,
        login_email: document.getElementById('edit-email').value // Keep login_email synced with email
      };

      try {
        const response = await fetch(`/api/recruiters/update`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
            'x-admin-email': ADMIN_EMAIL
          },
          body: JSON.stringify({ id, ...updatedData })
        });

        if (response.ok) {
          alert('Recruiter updated successfully!');
          closeEditModal();
          loadRecruiters(); // Refresh the list
        } else {
          const error = await response.text();
          alert(`Error: ${error}`);
        }
      } catch (error) {
        console.error('Error updating recruiter:', error);
        alert('Failed to update recruiter');
      }
    }

    // Display invitation links
    function displayInvitationLinks(recruiters) {
      const container = document.getElementById('invitation-links');
      if (!container) return;

      container.innerHTML = recruiters.map(recruiter => `
        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border">
          <div class="flex items-center space-x-3">
            <img src="${recruiter.image}" alt="${recruiter.name}" class="w-8 h-8 rounded-full object-cover">
            <div>
              <div class="font-medium text-gray-900">${recruiter.name}</div>
              <div class="text-sm text-gray-500">${recruiter.agency}</div>
            </div>
          </div>
          <div class="flex-1 mx-4">
            <a href="https://www.opendesigndocs.com/docs/recruiters/invite/${recruiter.slug}" 
               target="_blank" 
               class="text-blue-600 hover:text-blue-800 underline text-sm font-mono break-all">
              https://www.opendesigndocs.com/docs/recruiters/invite/${recruiter.slug}
            </a>
          </div>
          <div class="flex space-x-2">
            <button onclick="copyToClipboard('https://www.opendesigndocs.com/docs/recruiters/invite/${recruiter.slug}')" 
                    class="px-2 py-1 bg-gray-200 text-gray-700 rounded text-xs hover:bg-gray-300 transition-colors">
              Copy
            </button>
          </div>
        </div>
      `).join('');
    }

    // Copy to clipboard function
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        // Show temporary success message
        const button = event.target;
        const originalText = button.textContent;
        button.textContent = 'Copied!';
        button.classList.add('bg-green-200', 'text-green-700');
        button.classList.remove('bg-gray-200', 'text-gray-700');
        
        setTimeout(() => {
          button.textContent = originalText;
          button.classList.remove('bg-green-200', 'text-green-700');
          button.classList.add('bg-gray-200', 'text-gray-700');
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy: ', err);
        alert('Failed to copy to clipboard');
      });
    }

    // Make functions globally available
    window.editRecruiter = editRecruiter;
    window.copyToClipboard = copyToClipboard;

    // Image upload functionality
    function setupImageUpload() {
      // Add form image upload handler
      const addImageUpload = document.getElementById('image-upload');
      const addImagePreview = document.getElementById('image-preview');
      const addImagePath = document.getElementById('image');

      if (addImageUpload && addImagePreview && addImagePath) {
        addImageUpload.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (file) {
            await handleImageUpload(file, addImagePreview, addImagePath, 'add');
          }
        });

        // Update preview when path is manually entered
        addImagePath.addEventListener('input', (e) => {
          if (e.target.value) {
            addImagePreview.src = e.target.value;
          }
        });
      }

      // Edit modal image upload handler
      const editImageUpload = document.getElementById('edit-image-upload');
      const editImagePreview = document.getElementById('edit-image-preview');
      const editImagePath = document.getElementById('edit-image');

      if (editImageUpload && editImagePreview && editImagePath) {
        editImageUpload.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (file) {
            await handleImageUpload(file, editImagePreview, editImagePath, 'edit');
          }
        });

        // Update preview when path is manually entered
        editImagePath.addEventListener('input', (e) => {
          if (e.target.value) {
            editImagePreview.src = e.target.value;
          }
        });
      }
    }

    async function handleImageUpload(file, previewElement, pathElement, context) {
      // Validate file size (2MB max)
      if (file.size > 2 * 1024 * 1024) {
        alert('Image size must be less than 2MB');
        return;
      }

      // Validate file type
      if (!file.type.startsWith('image/')) {
        alert('Please select a valid image file');
        return;
      }

      try {
        // Show loading state
        const originalSrc = previewElement.src;
        previewElement.style.opacity = '0.5';

        // Create FormData for upload
        const formData = new FormData();
        formData.append('image', file);
        formData.append('context', context);

        // Upload image
        const response = await fetch('/api/upload-image', {
          method: 'POST',
          headers: {
            'x-admin-email': ADMIN_EMAIL
          },
          body: formData
        });

        if (response.ok) {
          const result = await response.json();
          
          // Update preview and path
          previewElement.src = result.path;
          pathElement.value = result.path;
          previewElement.style.opacity = '1';
          
          console.log('Image uploaded successfully:', result.path);
        } else {
          throw new Error('Upload failed');
        }
      } catch (error) {
        console.error('Image upload error:', error);
        alert('Failed to upload image. Please try again.');
        previewElement.style.opacity = '1';
      }
    }

    // Initialize image upload when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
      setupImageUpload();
    });
  </script>
</WideLayout>
