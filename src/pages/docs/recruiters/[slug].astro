// Cleanup function for this page
window.recruiterPageCleanup = function() {
  console.log(`=== CLEANING UP PAGE: ${window.currentPageId || 'unknown'} ===`);
  
  // Remove event listeners
  document.removeEventListener('DOMContentLoaded', initializePage);
  document.removeEventListener('astro:page-load', initializePage);
  
  // Clear any intervals or timeouts if they exist
  if (window.recruiterPageInterval) {
    clearInterval(window.recruiterPageInterval);
  }
  
  console.log('Page cleanup completed');
};

// Main initialization function
function initializePage() {
  // Only initialize if this is the current page
  const expectedPageId = `recruiter-${validRecruiterData.id}`;
  if (window.currentPageId !== expectedPageId) {
    console.log(`Skipping initialization - page mismatch. Expected: ${expectedPageId}, Current: ${window.currentPageId}`);
    return;
  }
  
  console.log(`=== INITIALIZING LISTENERS FOR: ${expectedPageId} ===`);
  refreshRecruiterData();
  setupEventListeners();
}

// Set up event listeners for both initial load and Astro View Transitions
document.addEventListener('DOMContentLoaded', initializePage);
document.addEventListener('astro:page-load', initializePage);

