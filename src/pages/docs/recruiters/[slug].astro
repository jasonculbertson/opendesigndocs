---
import WideLayout from '../../../layouts/WideLayout.astro';

// Check for access parameter
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
const hasAccess = accessKey === 'recruit2024';
const backToRecruitersUrl = hasAccess ? '/docs/recruiters?access=recruit2024' : '/docs/recruiters';

// Function to create URL-friendly slugs
function createSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

// Define recruiters data - we'll use this for fast loading and reading, but save to database
const recruitersData = [
  {
    id: 1,
    name: "Laura Hunting",
    agency: "Found By",
    title: "Founding Partner",
    image: "/images/laura.jpeg",
    linkedin: "https://www.linkedin.com/in/laurahunting/",
    website: "https://www.foundby.co/",
    email: "laura@foundby.co",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Laura is a founding partner at Found By, a boutique talent agency and executive search firm specialized in design. With over a decade of experience building design leadership teams, Found By has placed talent at industry leaders including Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, and Squarespace.",
    specialties: "Design Leadership, Executive Search, UX Design, Product Design",
    philosophy: "I focus on building diverse teams thoughtfully and effectively, understanding that great design teams are built on a foundation of varied perspectives and complementary skills.",
    approach: "My approach involves deep discovery sessions with both clients and candidates to understand cultural fit, growth trajectory, and long-term career goals. I believe in transparent communication and building lasting relationships rather than just filling positions.",
    notableClients: "Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, Squarespace",
  },
  {
    id: 2,
    name: "Garrett Fowler",
    agency: "Offsite",
    title: "Founder",
    image: "/images/garrett.jpeg",
    linkedin: "https://www.linkedin.com/in/garrettfowler/",
    website: "https://www.off.site",
    email: "garrett@off.site",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Garrett is the Founder of Offsite, a new kind of creative talent community focused on the intersection of career and creative practice. As a Design & Executive Talent Agent, he specializes in connecting exceptional design professionals with opportunities that align with their creative vision and career goals.",
    specialties: "Product Design, UX Design, Design Leadership",
    philosophy: "I believe in going beyond traditional recruiting to build meaningful relationships within the creative community. Design talent deserves more than just job placement—they deserve career partnership.",
    approach: "My approach centers on understanding both the creative and business sides of design roles. I focus on long-term career trajectory matching rather than quick placements, ensuring both candidates and companies find the right cultural and skill alignment.",
    notableClients: "Various SaaS, FinTech, E-commerce, and Enterprise Software companies",
  },
  {
    id: 4,
    name: "Dirk Cleveland",
    agency: "Fusion",
    title: "Executive Recruiter",
    image: "/images/dirk.jpeg",
    linkedin: "https://www.linkedin.com/in/dirkcleveland/",
    website: "https://www.fusiontalent.com",
    email: "dirk@fusiontalent.com",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Dirk specializes in Design Leadership Recruiting at Fusion, a 100% referral-based executive search firm focused exclusively on Engineering, Product, and Design leadership roles. With extensive experience placing executives at companies like Uber, Airbnb, Atlassian, and many more, Dirk focuses on long-term career growth and cultural alignment for senior design positions.",
    specialties: "UX Design, Product Design, Design Systems, Design Leadership",
    philosophy: "I believe in the power of referral-based recruiting and building long-term relationships. Great design leaders aren't just found—they're cultivated through trust and understanding of their career aspirations.",
    approach: "My approach is exclusively referral-based, focusing on quality over quantity. I invest time in understanding both the cultural dynamics of client organizations and the career motivations of design leaders to ensure sustainable, long-term placements.",
    notableClients: "Uber, Airbnb, Atlassian, and other leading SaaS, Enterprise Software, FinTech, and Healthcare Tech companies",
  },
  {
    id: 6,
    name: "Jared Tredly",
    agency: "Bamboo X",
    title: "Design Recruiter",
    image: "/images/jared.jpeg",
    linkedin: "https://www.linkedin.com/in/jaredtredly/",
    website: "https://bamboo-x.com",
    email: "jared@bamboocrowd.com",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Jared is a Design Recruiter at Bamboo X, a recruiting partner for disruptive startups and companies building what's next. Since 2013, Bamboo X has been supporting VC-backed startups from pre-seed to IPO in acquiring top design talent. They specialize in recruiting for AI, fintech, health-tech, and other innovative sectors.",
    specialties: "Product Design, UX Design, UI Design, Design Leadership",
    philosophy: "I believe in supporting disruptive startups and innovative companies that are building the future. Great design talent thrives in environments where they can make meaningful impact and drive product innovation.",
    approach: "I focus on understanding the unique challenges and opportunities that come with startup environments. My approach involves matching design talent not just with roles, but with companies where they can grow alongside revolutionary products and teams.",
    notableClients: "200+ VC-backed startups across AI & Machine Learning, FinTech, HealthTech, B2B SaaS, and Consumer Tech sectors",
  }
];

export async function getStaticPaths() {
  return recruitersData.map((recruiter) => ({
    params: { slug: createSlug(recruiter.name) },
    props: { recruiter },
  }));
}

// Get the slug from the URL params
const { slug } = Astro.params;
let recruiterData = Astro.props.recruiter;

// If no recruiter from props (dev mode), look it up by slug
if (!recruiterData && slug) {
  recruiterData = recruitersData.find(r => createSlug(r.name) === slug);
}

// If still no recruiter found, redirect
if (!recruiterData) {
  return Astro.redirect('/docs/recruiters');
}

const title = `${recruiterData.name} - ${recruiterData.agency}`;
const description = `Connect with ${recruiterData.name} from ${recruiterData.agency}. Specializing in ${recruiterData.specialties}.`;
---

<WideLayout title={title} description={description}>
  <div class="py-8">
    <!-- Back Button -->
    <div class="mb-8">
      <a 
        href={backToRecruitersUrl}
        class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Recruiters
      </a>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-8 gap-16">
      <!-- Left Column - Profile -->
      <div class="lg:col-span-3 lg:pr-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 sticky top-8" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
          <!-- Profile Image -->
          <div class="flex justify-center mb-6">
            <img
              src={recruiterData.image}
              alt={`${recruiterData.name} profile`}
              class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
            />
          </div>
          
          <!-- Name & Agency -->
          <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-gray-900 mb-2">{recruiterData.name}</h1>
            <p class="text-sm text-gray-500 mb-4">{recruiterData.title} at {recruiterData.agency}</p>
            
            <!-- Edit Button - Only visible to authorized users -->
            {hasAccess && (
              <button 
                id="edit-profile-btn"
                data-recruiter-id={recruiterData.id}
                class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit Profile
              </button>
            )}
          </div>



          <!-- Contact Buttons -->
          <div class="space-y-3">
            <a
              href={recruiterData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
              style="background-color: #f9fafb"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
            {recruiterData.website && (
              <a
                href={recruiterData.website}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Visit Website
              </a>
            )}
            {recruiterData.email && (
              <a
                href={`mailto:${recruiterData.email}`}
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Send Email
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column - Details -->
      <div class="lg:col-span-5">
        <!-- About -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mt-8 mb-4">About</h2>
          <p class="text-[15px]">{recruiterData.about}</p>
        </div>

        {recruiterData.specialties && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Specialties</h2>
              <div class="flex flex-wrap gap-2">
                {recruiterData.specialties.split(',').map(specialty => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {specialty.trim()}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

        {recruiterData.philosophy && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Philosophy</h2>
              <p class="text-[15px] italic">"{recruiterData.philosophy}"</p>
            </div>
          </>
        )}

        {recruiterData.approach && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Approach</h2>
              <p class="text-[15px]">{recruiterData.approach}</p>
            </div>
          </>
        )}

        {recruiterData.notableClients && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Notable Clients</h2>
              <div class="flex flex-wrap gap-2">
                {recruiterData.notableClients.split(',').map(client => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {client.trim()}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

      </div>
    </div>
  </div>

  <!-- Edit Modal - Pure HTML/JS Implementation -->
  {hasAccess && (
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-[100] items-center justify-center p-4" style="display: none;">
      <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 max-w-4xl w-full max-h-[90vh] overflow-y-auto relative flex flex-col">
        <!-- Header -->
        <div class="flex items-start justify-between px-8 pt-6 pb-4">
          <h2 class="mb-0 text-xl md:text-[24px] font-semibold text-[#1a1f36] tracking-[-0.4px] pt-2">
            Edit Your Profile
          </h2>
          <button
            id="close-modal-btn"
            class="p-2 hover:bg-gray-100 transition -mt-2 -mr-4 md:-mt-2 md:-mr-2 rounded-lg"
            aria-label="Close"
            type="button"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Form Content -->
        <div class="px-8 pb-8">
          <form id="editForm" class="space-y-7">
            <!-- Basic Information -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Name *</label>
                <input
                  type="text"
                  id="edit-name"
                  required
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Agency Name</label>
                <input
                  type="text"
                  id="edit-agency"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
            </div>

            <!-- Contact Information -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Email *</label>
                <input
                  type="email"
                  id="edit-email"
                  required
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Website</label>
                <input
                  type="url"
                  id="edit-website"
                  placeholder="https://"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
            </div>

            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">LinkedIn Profile *</label>
              <input
                type="url"
                id="edit-linkedin"
                required
                placeholder="https://linkedin.com/in/"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
              />
            </div>

            <!-- About -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">About *</label>
              <textarea
                id="edit-about"
                required
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="4"
                placeholder="Tell us about your background, experience, and what makes you unique..."
              ></textarea>
            </div>

            <!-- Specialties -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Specialties</label>
              <p class="text-sm text-gray-600 mb-2">Separate each specialty with a comma (e.g., "Design Leadership, UX Design, Product Design")</p>
              <textarea
                id="edit-specialties"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="2"
                placeholder="Design Leadership, UX Design, Product Design... (Optional)"
              ></textarea>
            </div>

            <!-- Philosophy -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Philosophy *</label>
              <textarea
                id="edit-philosophy"
                required
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="3"
                placeholder="Share your core beliefs about recruiting and talent acquisition..."
              ></textarea>
            </div>

            <!-- Approach -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Approach *</label>
              <textarea
                id="edit-approach"
                required
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="3"
                placeholder="Describe your process and methodology for finding and placing candidates..."
              ></textarea>
            </div>

            <!-- Notable Clients -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Notable Clients</label>
              <p class="text-sm text-gray-600 mb-2">Separate each client with a comma (e.g., "Airbnb, Zillow, Square, Yahoo")</p>
              <textarea
                id="edit-notable-clients"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="3"
                placeholder="Notable companies or clients you've worked with... (Optional)"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-6">
              <button
                type="submit"
                id="submit-btn"
                class="font-semibold py-3 px-12 rounded-lg shadow-sm transition bg-black text-white hover:bg-gray-900"
              >
                Update Profile
              </button>
            </div>
          </form>

          <!-- Error/Success Messages -->
          <div id="error-message" class="mt-4 hidden">
            <div class="bg-red-50 border border-red-200 rounded-lg p-3">
              <p class="text-sm text-red-600" id="error-text"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}
</WideLayout>

<script define:vars={{ recruiterData, hasAccess }}>
// Make recruiter data globally available
window.currentRecruiterData = recruiterData;
window.hasAccess = hasAccess;

// Modal functions
function openEditModal() {
  const modal = document.getElementById('editModal');
  if (!modal || !recruiterData) return;

  // Populate form fields with current data
  document.getElementById('edit-name').value = recruiterData.name || '';
  document.getElementById('edit-agency').value = recruiterData.agency || '';
  document.getElementById('edit-email').value = recruiterData.email || '';
  document.getElementById('edit-website').value = recruiterData.website || '';
  document.getElementById('edit-linkedin').value = recruiterData.linkedin || '';
  document.getElementById('edit-about').value = recruiterData.about || '';
  document.getElementById('edit-specialties').value = recruiterData.specialties || '';
  document.getElementById('edit-philosophy').value = recruiterData.philosophy || '';
  document.getElementById('edit-approach').value = recruiterData.approach || '';
  document.getElementById('edit-notable-clients').value = recruiterData.notableClients || '';

  // Show modal
  modal.style.display = 'flex';
}

function closeEditModal() {
  const modal = document.getElementById('editModal');
  if (modal) {
    modal.style.display = 'none';
  }
}

// Update page content with new data after successful save
function updatePageContent(formData) {
  console.log('Updating page content with:', formData);
  
  // Update the page title
  const pageTitleH1 = document.querySelector('h1');
  if (pageTitleH1) {
    pageTitleH1.textContent = formData.name;
  }
  
  // Update the subtitle
  const subtitle = document.querySelector('p.text-sm.text-gray-500');
  if (subtitle && formData.agency) {
    // Keep the title if it exists, just update agency
    const titleText = recruiterData.title || 'Recruiter';
    subtitle.textContent = `${titleText} at ${formData.agency}`;
  }
  
  // Update About section
  const aboutSection = Array.from(document.querySelectorAll('h2')).find(h => h.textContent.includes('About'));
  if (aboutSection && formData.about) {
    const aboutText = aboutSection.parentElement.querySelector('p');
    if (aboutText) {
      aboutText.textContent = formData.about;
    }
  }
  
  // Update Specialties section
  if (formData.specialties) {
    updatePillSection('Specialties', formData.specialties);
  }
  
  // Update Philosophy section
  const philosophySection = Array.from(document.querySelectorAll('h2')).find(h => h.textContent.includes('Philosophy'));
  if (philosophySection && formData.philosophy) {
    const philosophyText = philosophySection.parentElement.querySelector('p');
    if (philosophyText) {
      philosophyText.textContent = `"${formData.philosophy}"`;
    }
  }
  
  // Update Approach section
  const approachSection = Array.from(document.querySelectorAll('h2')).find(h => h.textContent.includes('Approach'));
  if (approachSection && formData.approach) {
    const approachText = approachSection.parentElement.querySelector('p');
    if (approachText) {
      approachText.textContent = formData.approach;
    }
  }
  
  // Update Notable Clients section
  if (formData.notable_clients) {
    updatePillSection('Notable Clients', formData.notable_clients);
  }
  
  // Update contact links
  if (formData.linkedin) {
    const linkedinLink = document.querySelector('a[href*="linkedin"]');
    if (linkedinLink) {
      linkedinLink.href = formData.linkedin;
    }
  }
  
  if (formData.website) {
    const websiteLink = Array.from(document.querySelectorAll('a')).find(a => a.textContent.includes('Visit Website'));
    if (websiteLink) {
      websiteLink.href = formData.website;
    }
  }
  
  if (formData.email) {
    const emailLink = document.querySelector('a[href^="mailto:"]');
    if (emailLink) {
      emailLink.href = `mailto:${formData.email}`;
    }
  }
}

// Helper function to update pill sections (Specialties, Notable Clients)
function updatePillSection(sectionName, data) {
  const section = Array.from(document.querySelectorAll('h2')).find(h => h.textContent.includes(sectionName));
  if (section && data) {
    const pillContainer = section.parentElement.querySelector('div.flex.flex-wrap.gap-2');
    if (pillContainer) {
      // Clear existing pills
      pillContainer.innerHTML = '';
      
      // Add new pills
      const items = data.split(',');
      items.forEach(item => {
        const trimmedItem = item.trim();
        if (trimmedItem) {
          const pill = document.createElement('span');
          pill.className = 'px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium';
          pill.textContent = trimmedItem;
          pillContainer.appendChild(pill);
        }
      });
    }
  }
}

// Handle form submission
async function handleFormSubmit(event) {
  event.preventDefault();
  
  const submitBtn = document.getElementById('submit-btn');
  const errorMessage = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');
  
  // Show loading state
  submitBtn.textContent = 'Updating...';
  submitBtn.disabled = true;
  errorMessage.classList.add('hidden');
  
  try {
    // Collect form data
    const formData = {
      id: recruiterData.id,
      userEmail: 'jculbertson@gmail.com', // Admin email for testing
      name: document.getElementById('edit-name').value,
      agency: document.getElementById('edit-agency').value,
      email: document.getElementById('edit-email').value,
      website: document.getElementById('edit-website').value,
      linkedin: document.getElementById('edit-linkedin').value,
      about: document.getElementById('edit-about').value,
      specialties: document.getElementById('edit-specialties').value,
      philosophy: document.getElementById('edit-philosophy').value,
      approach: document.getElementById('edit-approach').value,
      notable_clients: document.getElementById('edit-notable-clients').value
    };

    console.log('Submitting form data:', formData);

    // Call the API
    const response = await fetch('/api/recruiters.json', {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(formData)
    });

    console.log('API Response status:', response.status);
    console.log('API Response headers:', response.headers);

    let result;
    try {
      result = await response.json();
      console.log('API Response data:', result);
    } catch (parseError) {
      console.error('Failed to parse API response:', parseError);
      const text = await response.text();
      console.log('Raw response:', text);
      throw new Error(`API returned invalid JSON. Status: ${response.status}, Response: ${text.substring(0, 200)}`);
    }

    if (!response.ok) {
      console.error('API Error:', result);
      throw new Error(result.error || `API Error: ${response.status} - ${JSON.stringify(result)}`);
    }

    console.log('Profile updated successfully:', result.data);
    
    // Update the page content immediately with the new data
    updatePageContent(formData);
    
    // Close modal and show success
    closeEditModal();
    
    // Show success message
    alert('Profile updated successfully! Your changes are now live.');
    
    // No need to reload since we updated the content directly
    
  } catch (error) {
    console.error('Failed to update profile:', error);
    errorText.textContent = error.message || 'Failed to update profile. Please try again.';
    errorMessage.classList.remove('hidden');
  } finally {
    // Reset button state
    submitBtn.textContent = 'Update Profile';
    submitBtn.disabled = false;
  }
}

// Set up event listeners
document.addEventListener('DOMContentLoaded', function() {
  const editBtn = document.getElementById('edit-profile-btn');
  const editForm = document.getElementById('editForm');
  const modal = document.getElementById('editModal');
  const closeBtn = document.getElementById('close-modal-btn');
  
  console.log('Edit button found:', editBtn);
  console.log('Close button found:', closeBtn);
  console.log('Has access:', hasAccess);
  console.log('Recruiter data:', recruiterData);
  
  // Edit button click
  if (editBtn && hasAccess) {
    editBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      console.log('Edit button clicked! Opening modal...');
      openEditModal();
    });
  }
  
  // Close button click
  if (closeBtn) {
    closeBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      console.log('Close button clicked!');
      closeEditModal();
    });
  }
  
  // Form submission
  if (editForm) {
    editForm.addEventListener('submit', handleFormSubmit);
  }
  
  // Close modal when clicking outside
  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) {
        console.log('Clicked outside modal, closing...');
        closeEditModal();
      }
    });
  }
  
  // Close modal on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      console.log('Escape key pressed, closing modal...');
      closeEditModal();
    }
  });
});
</script>