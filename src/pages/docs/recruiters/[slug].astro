// Helper function to update pill sections (Specialties, Notable Clients)
function updatePillSection(sectionName, data) {
  const section = Array.from(document.querySelectorAll('h2')).find(h => h.textContent.includes(sectionName));
  if (section && data) {
    const pillContainer = section.parentElement.querySelector('div.flex.flex-wrap.gap-2');
    if (pillContainer) {
      // Clear existing pills
      pillContainer.innerHTML = '';
      
      // Add new pills
      const items = data.split(',');
      items.forEach(item => {
        const trimmedItem = item.trim();
        if (trimmedItem) {
          const pill = document.createElement('span');
          pill.className = 'px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium';
          pill.textContent = trimmedItem;
          pillContainer.appendChild(pill);
        }
      });
    }
  }
}

