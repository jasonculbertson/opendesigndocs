  console.log('Window currentRecruiterData ID:', window.currentRecruiterData?.id);
  console.log('Data match check:', window.currentRecruiterData?.id === validRecruiterData.id);
  console.log('Full current data:', currentData);
  console.log('Full page validRecruiterData:', validRecruiterData);
  console.log('Full window currentRecruiterData:', window.currentRecruiterData);
  console.log('========================');

  // Populate form fields with current data (including any updates)
  document.getElementById('edit-name').value = currentData.displayName || currentData.name || '';
  document.getElementById('edit-agency').value = currentData.agency || '';
  document.getElementById('edit-title').value = currentData.title || '';
  document.getElementById('edit-email').value = currentData.email || '';
  document.getElementById('edit-website').value = currentData.website || '';
  document.getElementById('edit-linkedin').value = currentData.linkedin || '';
  document.getElementById('edit-about').value = currentData.about || '';
