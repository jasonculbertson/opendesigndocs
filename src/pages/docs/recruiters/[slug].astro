---
import WideLayout from '../../../layouts/WideLayout.astro';
import RecruiterEditModalWrapper from '../../../components/ui/RecruiterEditModalWrapper.tsx';

// Check for access parameter
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
const hasAccess = accessKey === 'recruit2024';
const backToRecruitersUrl = hasAccess ? '/docs/recruiters?access=recruit2024' : '/docs/recruiters';

// Get the slug from the URL params
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/docs/recruiters');
}

// Fetch recruiter data from the API
let recruiter = null;
try {
  const apiUrl = new URL('/api/recruiters.json', Astro.url);
  apiUrl.searchParams.set('slug', slug);
  
  const response = await fetch(apiUrl);
  const result = await response.json();
  
  if (response.ok && result.success) {
    recruiter = result.data;
  }
} catch (error) {
  console.error('Error fetching recruiter:', error);
}

// If still no recruiter found, redirect
if (!recruiter) {
  return Astro.redirect('/docs/recruiters');
}

// Convert database column names to match the component expectations
const recruiterData = {
  id: recruiter.id,
  name: recruiter.name,
  agency: recruiter.agency,
  title: recruiter.title,
  image: recruiter.image,
  linkedin: recruiter.linkedin,
  website: recruiter.website,
  email: recruiter.email,
  loginEmail: recruiter.login_email,
  about: recruiter.about,
  specialties: recruiter.specialties,
  philosophy: recruiter.philosophy,
  approach: recruiter.approach,
  notableClients: recruiter.notable_clients,
};

const title = `${recruiterData.name} - ${recruiterData.agency}`;
const description = `Connect with ${recruiterData.name} from ${recruiterData.agency}. Specializing in ${recruiterData.specialties}.`;
---

<WideLayout title={title} description={description}>
  <div class="py-8">
    <!-- Back Button -->
    <div class="mb-8">
      <a 
        href={backToRecruitersUrl}
        class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Recruiters
      </a>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-8 gap-16">
      <!-- Left Column - Profile -->
      <div class="lg:col-span-3 lg:pr-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 sticky top-8" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
          <!-- Profile Image -->
          <div class="flex justify-center mb-6">
            <img
              src={recruiterData.image}
              alt={`${recruiterData.name} profile`}
              class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
            />
          </div>
          
          <!-- Name & Agency -->
          <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-gray-900 mb-2">{recruiterData.name}</h1>
            <p class="text-sm text-gray-500 mb-4">{recruiterData.title} at {recruiterData.agency}</p>
            
            <!-- Edit Button - Only visible to authorized users -->
            {hasAccess && (
              <button 
                id="edit-profile-btn"
                data-recruiter-id={recruiterData.id}
                class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit Profile
              </button>
            )}
          </div>



          <!-- Contact Buttons -->
          <div class="space-y-3">
            <a
              href={recruiterData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
              style="background-color: #f9fafb"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
            {recruiterData.website && (
              <a
                href={recruiterData.website}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Visit Website
              </a>
            )}
            {recruiterData.email && (
              <a
                href={`mailto:${recruiterData.email}`}
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Send Email
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column - Details -->
      <div class="lg:col-span-5">
        <!-- About -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mt-8 mb-4">About</h2>
          <p class="text-[15px]">{recruiterData.about}</p>
        </div>

        {recruiterData.specialties && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Specialties</h2>
              <div class="flex flex-wrap gap-2">
                {recruiterData.specialties.split(',').map(specialty => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {specialty.trim()}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

        {recruiterData.philosophy && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Philosophy</h2>
              <p class="text-[15px] italic">"{recruiterData.philosophy}"</p>
            </div>
          </>
        )}

        {recruiterData.approach && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Approach</h2>
              <p class="text-[15px]">{recruiterData.approach}</p>
            </div>
          </>
        )}

        {recruiterData.notableClients && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Notable Clients</h2>
              <div class="flex flex-wrap gap-2">
                {recruiterData.notableClients.split(',').map(client => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {client.trim()}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

      </div>
    </div>
  </div>

  <!-- Edit Modal Component -->
  {hasAccess && (<RecruiterEditModalWrapper client:load />)}
</WideLayout>

<script define:vars={{ recruiterData, hasAccess }}>
// Make recruiter data globally available for the edit modal
window.currentRecruiterData = recruiterData;
window.hasAccess = hasAccess;

// Admin emails that can edit recruiters
const adminEmails = ["jculbertson@gmail.com", "jason@opendesigndocs.com"];

document.addEventListener('DOMContentLoaded', function() {
  const editBtn = document.getElementById('edit-profile-btn');
  
  console.log('Edit button found:', editBtn);
  console.log('Has access:', hasAccess);
  console.log('Recruiter data:', recruiterData);
  
  if (editBtn && hasAccess) {
    console.log('Adding click listener to edit button');
    editBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      
      console.log('Edit button clicked! Dispatching event...');
      
      // Dispatch event to open the edit modal
      const event = new CustomEvent('openRecruiterEditModal', { 
        detail: { recruiter: recruiterData },
        bubbles: true
      });
      
      console.log('Dispatching event:', event);
      document.dispatchEvent(event);
    });
  } else {
    console.log('Edit button not found or no access');
  }
  
  // Debug: Listen for the custom event
  document.addEventListener('openRecruiterEditModal', function(event) {
    console.log('Event received on document:', event.detail?.recruiter?.name);
  });
});
</script>