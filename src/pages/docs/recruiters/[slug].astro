  if (window.currentRecruiterData && window.currentRecruiterData.id === validRecruiterData.id) {
    currentData = window.currentRecruiterData;
  } else {
    // Reset window data to match current page
    window.currentRecruiterData = validRecruiterData;
    currentData = validRecruiterData;
  }
  
