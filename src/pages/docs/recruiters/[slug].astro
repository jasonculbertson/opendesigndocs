// Upload image function
async function uploadImage(file) {
  return new Promise((resolve, reject) => {
    // For now, we'll use a data URL for immediate preview
    // In production, you'd want to upload to a cloud storage service
    const reader = new FileReader();
    reader.onload = function(e) {
      // Use the data URL for immediate preview
      // In production, this would be the actual uploaded file path
      resolve(e.target.result);
    };
    reader.onerror = function() {
      reject(new Error('Failed to read file'));
    };
    reader.readAsDataURL(file);
  });
}

// Handle form submission
async function handleFormSubmit(event) {
  event.preventDefault();
  
  const submitBtn = document.getElementById('submit-btn');
  const errorMessage = document.getElementById('error-message');
  const errorText = document.getElementById('error-text');
  
  // Show loading state
  submitBtn.textContent = 'Updating...';
  submitBtn.disabled = true;
  errorMessage.classList.add('hidden');
  
  try {
    let imagePath = (window.currentRecruiterData || validRecruiterData).image; // Default to current image
    
    // Handle image upload if a new file was selected
    if (window.selectedImageFile) {
      console.log('Processing new image upload...', window.selectedImageFile.name);
      showUploadProgress(true);
      updateUploadProgress(10);
      
      try {
        imagePath = await uploadImage(window.selectedImageFile);
        updateUploadProgress(90);
        console.log('Image processed successfully. Data URL length:', imagePath.length);
      } catch (uploadError) {
        console.error('Image processing failed:', uploadError);
        throw new Error('Failed to process image: ' + uploadError.message);
      }
      
      updateUploadProgress(100);
      showUploadProgress(false);
    } else {
      console.log('No new image selected, keeping existing image:', imagePath);
    }
    
    // Collect form data (userEmail will be handled by server-side authentication)
    const formData = {
      id: validRecruiterData.id,
      name: document.getElementById('edit-name').value,
      agency: document.getElementById('edit-agency').value,
      title: document.getElementById('edit-title').value,
      email: document.getElementById('edit-email').value,
      website: document.getElementById('edit-website').value,
      linkedin: document.getElementById('edit-linkedin').value,
      about: document.getElementById('edit-about').value,
      specialties: document.getElementById('edit-specialties').value,
      philosophy: document.getElementById('edit-philosophy').value,
      approach: document.getElementById('edit-approach').value,
      notable_clients: document.getElementById('edit-notable-clients').value,
      image: imagePath // Include the image path
    };

    console.log('Submitting form data:', formData);

    // Get user email from Clerk for API authentication  
    let userEmail = null;
    if (typeof window !== 'undefined' && window.Clerk?.user) {
      userEmail = window.Clerk.user.primaryEmailAddress?.emailAddress;
    }

    // Call the API
    const response = await fetch('/api/recruiters.json', {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json',
        ...(userEmail && { 'x-user-email': userEmail })
      },
      body: JSON.stringify(formData)
    });

    console.log('API Response status:', response.status);
    console.log('API Response headers:', response.headers);

    let result;
    try {
      result = await response.json();
      console.log('API Response data:', result);
    } catch (parseError) {
      console.error('Failed to parse API response:', parseError);
      const text = await response.text();
      console.log('Raw response:', text);
      throw new Error(`API returned invalid JSON. Status: ${response.status}, Response: ${text.substring(0, 200)}`);
    }

    if (!response.ok) {
      console.error('API Error:', result);
      throw new Error(result.error || `API Error: ${response.status} - ${JSON.stringify(result)}`);
    }

    console.log('Profile updated successfully:', result.data);
    
    // Update the page content immediately with the new data
    console.log('Updating page content with form data:', formData);
    updatePageContent(formData);
    
    // Update the stored recruiter data so modal shows updated values next time
    updateRecruiterData(formData);
    
    // Clear the selected image file since it's been processed
    window.selectedImageFile = null;
    
    // Close modal - changes are already visible on page
    closeEditModal();
    
    console.log('Profile update completed successfully');
    
  } catch (error) {
    console.error('Failed to update profile:', error);
    errorText.textContent = error.message || 'Failed to update profile. Please try again.';
    errorMessage.classList.remove('hidden');
  } finally {
    // Reset button state
    submitBtn.textContent = 'Update Profile';
    submitBtn.disabled = false;
  }
}

// Check if current user can edit this profile
async function checkEditPermission() {
  const editBtn = document.getElementById('edit-profile-btn');
  if (!editBtn) return;

  const recruiterEmail = editBtn.getAttribute('data-recruiter-email');
  const adminEmails = ['jculbertson@gmail.com', 'jason@opendesigndocs.com'];
  
  try {
    // Check if user is signed in with Clerk
    if (typeof window !== 'undefined' && window.Clerk) {
      await window.Clerk.load();
      
      if (window.Clerk.user) {
        const userEmail = window.Clerk.user.primaryEmailAddress?.emailAddress;
        const isAdmin = adminEmails.includes(userEmail || '');
        const isOwner = userEmail === recruiterEmail;
        
        console.log('Authorization check:', { userEmail, recruiterEmail, isAdmin, isOwner });
        
        if (isAdmin || isOwner) {
          editBtn.style.display = 'inline-flex';
          console.log('Edit permission granted:', isAdmin ? 'admin' : 'owner');
        } else {
          console.log('Edit permission denied: not owner or admin');
        }
      } else {
        console.log('User not signed in');
      }
    }
  } catch (error) {
    console.error('Error checking edit permission:', error);
  }
}

// Set up event listeners function that works with both direct loads and View Transitions
function setupEventListeners() {
  const editBtn = document.getElementById('edit-profile-btn');
  const editForm = document.getElementById('editForm');
  const modal = document.getElementById('editModal');
  const closeBtn = document.getElementById('close-modal-btn');
  const uploadBtn = document.getElementById('upload-button');
  const imageInput = document.getElementById('image-upload');
  
  console.log('Setting up event listeners - Edit button found:', editBtn);
  console.log('Close button found:', closeBtn);
  console.log('Recruiter data:', validRecruiterData);
  
  // Check edit permissions
  checkEditPermission();
  
  // Remove any existing event listeners to prevent duplicates
  if (editBtn) {
    editBtn.removeEventListener('click', handleEditClick);
    editBtn.addEventListener('click', handleEditClick);
  }
  
  if (closeBtn) {
    closeBtn.removeEventListener('click', handleCloseClick);
    closeBtn.addEventListener('click', handleCloseClick);
  }
  
  if (uploadBtn && imageInput) {
    uploadBtn.removeEventListener('click', handleUploadClick);
    uploadBtn.addEventListener('click', handleUploadClick);
    
    imageInput.removeEventListener('change', handleImageChange);
    imageInput.addEventListener('change', handleImageChange);
  }
  
  if (editForm) {
    editForm.removeEventListener('submit', handleFormSubmit);
    editForm.addEventListener('submit', handleFormSubmit);
  }
  
  if (modal) {
    modal.removeEventListener('click', handleModalClick);
    modal.addEventListener('click', handleModalClick);
  }
  
  // Remove existing keydown listener and add new one
  document.removeEventListener('keydown', handleEscapeKey);
  document.addEventListener('keydown', handleEscapeKey);
}

// Event handler functions
function handleEditClick(e) {
  e.preventDefault();
  e.stopPropagation();
  console.log('Edit button clicked! Opening modal...');
  openEditModal();
}

function handleCloseClick(e) {
  e.preventDefault();
  e.stopPropagation();
  console.log('Close button clicked!');
  closeEditModal();
}

function handleUploadClick(e) {
  e.preventDefault();
  console.log('Upload button clicked!');
  const imageInput = document.getElementById('image-upload');
  if (imageInput) imageInput.click();
}

function handleImageChange(e) {
  console.log('Image selected:', e.target.files[0]);
  handleImageUpload();
}

function handleModalClick(e) {
  const modal = document.getElementById('editModal');
  if (e.target === modal) {
    console.log('Clicked outside modal, closing...');
    closeEditModal();
  }
}

function handleEscapeKey(e) {
  if (e.key === 'Escape') {
    console.log('Escape key pressed, closing modal...');
    closeEditModal();
  }
}

