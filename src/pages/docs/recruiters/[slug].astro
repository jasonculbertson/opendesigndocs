---
import WideLayout from '../../../layouts/WideLayout.astro';

// Check for access parameter
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
const hasAccess = accessKey === 'recruit2024';
const backToRecruitersUrl = hasAccess ? '/docs/recruiters?access=recruit2024' : '/docs/recruiters';

// Function to create URL-friendly slugs
function createSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

// Define recruiters data - we'll use this for fast loading and reading, but save to database
const recruitersData = [
  {
    id: 1,
    name: "Laura Hunting",
    agency: "Found By",
    title: "Founding Partner",
    image: "/images/laura.jpeg",
    linkedin: "https://www.linkedin.com/in/laurahunting/",
    website: "https://www.foundby.co/",
    email: "laura@foundby.co",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Laura is a founding partner at Found By, a boutique talent agency and executive search firm specialized in design. With over a decade of experience building design leadership teams, Found By has placed talent at industry leaders including Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, and Squarespace.",
    specialties: "Design Leadership, Executive Search, UX Design, Product Design",
    philosophy: "I focus on building diverse teams thoughtfully and effectively, understanding that great design teams are built on a foundation of varied perspectives and complementary skills.",
    approach: "My approach involves deep discovery sessions with both clients and candidates to understand cultural fit, growth trajectory, and long-term career goals. I believe in transparent communication and building lasting relationships rather than just filling positions.",
    notableClients: "Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, Squarespace",
  },
  {
    id: 2,
    name: "Garrett Fowler",
    agency: "Offsite",
    title: "Founder",
    image: "/images/garrett.jpeg",
    linkedin: "https://www.linkedin.com/in/garrettfowler/",
    website: "https://www.off.site",
    email: "garrett@off.site",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Garrett is the Founder of Offsite, a new kind of creative talent community focused on the intersection of career and creative practice. As a Design & Executive Talent Agent, he specializes in connecting exceptional design professionals with opportunities that align with their creative vision and career goals.",
    specialties: "Product Design, UX Design, Design Leadership",
    philosophy: "I believe in going beyond traditional recruiting to build meaningful relationships within the creative community. Design talent deserves more than just job placement—they deserve career partnership.",
    approach: "My approach centers on understanding both the creative and business sides of design roles. I focus on long-term career trajectory matching rather than quick placements, ensuring both candidates and companies find the right cultural and skill alignment.",
    notableClients: "Various SaaS, FinTech, E-commerce, and Enterprise Software companies",
  },
  {
    id: 4,
    name: "Dirk Cleveland",
    agency: "Fusion",
    title: "Executive Recruiter",
    image: "/images/dirk.jpeg",
    linkedin: "https://www.linkedin.com/in/dirkcleveland/",
    website: "https://www.fusiontalent.com",
    email: "dirk@fusiontalent.com",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Dirk specializes in Design Leadership Recruiting at Fusion, a 100% referral-based executive search firm focused exclusively on Engineering, Product, and Design leadership roles. With extensive experience placing executives at companies like Uber, Airbnb, Atlassian, and many more, Dirk focuses on long-term career growth and cultural alignment for senior design positions.",
    specialties: "UX Design, Product Design, Design Systems, Design Leadership",
    philosophy: "I believe in the power of referral-based recruiting and building long-term relationships. Great design leaders aren't just found—they're cultivated through trust and understanding of their career aspirations.",
    approach: "My approach is exclusively referral-based, focusing on quality over quantity. I invest time in understanding both the cultural dynamics of client organizations and the career motivations of design leaders to ensure sustainable, long-term placements.",
    notableClients: "Uber, Airbnb, Atlassian, and other leading SaaS, Enterprise Software, FinTech, and Healthcare Tech companies",
  },
  {
    id: 6,
    name: "Jared Tredly",
    agency: "Bamboo X",
    title: "Design Recruiter",
    image: "/images/jared.jpeg",
    linkedin: "https://www.linkedin.com/in/jaredtredly/",
    website: "https://bamboo-x.com",
    email: "jared@bamboocrowd.com",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Jared is a Design Recruiter at Bamboo X, a recruiting partner for disruptive startups and companies building what's next. Since 2013, Bamboo X has been supporting VC-backed startups from pre-seed to IPO in acquiring top design talent. They specialize in recruiting for AI, fintech, health-tech, and other innovative sectors.",
    specialties: "Product Design, UX Design, UI Design, Design Leadership",
    philosophy: "I believe in supporting disruptive startups and innovative companies that are building the future. Great design talent thrives in environments where they can make meaningful impact and drive product innovation.",
    approach: "I focus on understanding the unique challenges and opportunities that come with startup environments. My approach involves matching design talent not just with roles, but with companies where they can grow alongside revolutionary products and teams.",
    notableClients: "200+ VC-backed startups across AI & Machine Learning, FinTech, HealthTech, B2B SaaS, and Consumer Tech sectors",
  },
  {
    id: 7,
    name: "MJ", // Keep this for URL slug generation
    displayName: "Monica (MJ) Jin", // Use this for display
    agency: "Offsite",
    title: "Talent Director",
    image: "/images/mj.jpeg",
    linkedin: "https://www.linkedin.com/in/monjin/",
    website: "https://www.off.site",
    email: "mj@off.site",
    loginEmail: "jculbertson@gmail.com", // TEMP: Admin access for testing
    about: "Monica (MJ) Jin is the Talent Director at Offsite, a creative talent community focused on the intersection of career and creative practice. With expertise in talent acquisition and team building across multiple design disciplines, Monica helps connect exceptional design professionals with opportunities that align with their creative vision and career goals.",
    specialties: "Design Talent Acquisition, Team Building, Creative Recruiting, Design Leadership",
    philosophy: "I believe in empowering design professionals across all disciplines to find their ideal career paths. Great design happens when talented individuals are matched with the right opportunities and teams.",
    approach: "My approach is holistic, considering not just design skills but also career aspirations, creative growth, and cultural fit. I work closely with both candidates and companies to ensure sustainable, long-term placements that benefit everyone involved.",
    notableClients: "Various SaaS, FinTech, E-commerce, and Enterprise Software companies",
  }
];

export async function getStaticPaths() {
  return recruitersData.map((recruiter) => ({
    params: { slug: createSlug(recruiter.name) },
    props: { recruiter },
  }));
}

// Define types for recruiter data
type RecruiterData = {
  id: number;
  name: string;
  displayName?: string;
  agency: string;
  title: string;
  image: string;
  linkedin: string;
  website: string;
  email: string;
  loginEmail: string;
  about: string;
  specialties: string;
  philosophy: string;
  approach: string;
  notableClients: string;
};

// Get the slug from the URL params
const { slug } = Astro.params;
let recruiterData: RecruiterData | null = Astro.props.recruiter || null;

// If no recruiter from props (dev mode), look it up by slug
if (!recruiterData && slug) {
  recruiterData = recruitersData.find(r => createSlug(r.name) === slug) || null;
}

// If still no recruiter found, redirect
if (!recruiterData) {
  return Astro.redirect('/docs/recruiters');
}

// TypeScript now knows recruiterData is not null here
const validRecruiterData: RecruiterData = recruiterData;
const displayName = validRecruiterData.displayName || validRecruiterData.name;
const title = `${displayName} - ${validRecruiterData.agency}`;
const description = `Connect with ${displayName} from ${validRecruiterData.agency}. Specializing in ${validRecruiterData.specialties}.`;
---

<WideLayout title={title} description={description}>
  <div class="py-8">
    <!-- Back Button -->
    <div class="mb-8">
      <a 
        href={backToRecruitersUrl}
        class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Recruiters
      </a>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-8 gap-16">
      <!-- Left Column - Profile -->
      <div class="lg:col-span-3 lg:pr-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 sticky top-8" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
          <!-- Profile Image -->
          <div class="flex justify-center mb-6">
            <img
              src={validRecruiterData.image}
              alt={`${displayName} profile`}
              class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
            />
          </div>
          
          <!-- Name & Agency -->
          <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-gray-900 mb-2">{displayName}</h1>
            <p class="text-sm text-gray-500 mb-4">{validRecruiterData.title} at {validRecruiterData.agency}</p>
            
            <!-- Edit Button - Only visible to authorized users -->
            {hasAccess && (
              <button 
                id="edit-profile-btn"
                data-recruiter-id={validRecruiterData.id}
                class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-100 px-3 py-2 rounded-lg transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                </svg>
                Edit Profile
              </button>
            )}
          </div>



          <!-- Contact Buttons -->
          <div class="space-y-3">
            <a
              href={validRecruiterData.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
              style="background-color: #f9fafb"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
            {validRecruiterData.website && (
              <a
                href={validRecruiterData.website}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Visit Website
              </a>
            )}
            {validRecruiterData.email && (
              <a
                href={`mailto:${validRecruiterData.email}`}
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Send Email
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column - Details -->
      <div class="lg:col-span-5">
        <!-- About -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mt-8 mb-4">About</h2>
          <p class="text-[15px]">{validRecruiterData.about}</p>
        </div>

        {validRecruiterData.specialties && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Specialties</h2>
              <div class="flex flex-wrap gap-2">
                {validRecruiterData.specialties.split(',').map(specialty => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {specialty.trim()}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

        {validRecruiterData.philosophy && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Philosophy</h2>
              <p class="text-[15px] italic">"{validRecruiterData.philosophy}"</p>
            </div>
          </>
        )}

        {validRecruiterData.approach && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Approach</h2>
              <p class="text-[15px]">{validRecruiterData.approach}</p>
            </div>
          </>
        )}

        {validRecruiterData.notableClients && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Notable Clients</h2>
              <div class="flex flex-wrap gap-2">
                {validRecruiterData.notableClients.split(',').map(client => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {client.trim()}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

      </div>
    </div>
  </div>

  <!-- Edit Modal - Pure HTML/JS Implementation -->
  {hasAccess && (
    <div id="editModal" class="fixed inset-0 bg-black bg-opacity-50 z-[100] items-center justify-center p-4" style="display: none;">
      <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 max-w-4xl w-full max-h-[90vh] overflow-y-auto relative flex flex-col">
        <!-- Header -->
        <div class="flex items-start justify-between px-8 pt-6 pb-4">
          <h2 class="mb-0 text-xl md:text-[24px] font-semibold text-[#1a1f36] tracking-[-0.4px] pt-2">
            Edit Your Profile
          </h2>
          <button
            id="close-modal-btn"
            class="p-2 hover:bg-gray-100 transition -mt-2 -mr-4 md:-mt-2 md:-mr-2 rounded-lg"
            aria-label="Close"
            type="button"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Form Content -->
        <div class="px-8 pb-8">
          <form id="editForm" class="space-y-7">
            
            <!-- Profile Image Upload -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Profile Photo</label>
              <div class="flex items-start gap-6">
                <!-- Current Image Preview -->
                <div class="flex-shrink-0">
                  <div id="current-image-container" class="w-24 h-24 rounded-lg overflow-hidden bg-gray-100 border border-gray-200">
                    <img id="current-image" src="" alt="Current profile" class="w-full h-full object-cover" style="display: none;">
                    <div id="image-placeholder" class="w-full h-full bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center">
                      <span id="initials-placeholder" class="text-white font-bold text-lg"></span>
                    </div>
                  </div>
                </div>
                
                <!-- Upload Controls -->
                <div class="flex-1">
                  <input
                    type="file"
                    id="image-upload"
                    accept="image/*"
                    class="hidden"
                  />
                  <button
                    type="button"
                    id="upload-button"
                    class="inline-flex items-center gap-2 px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 002 2z"></path>
                    </svg>
                    Upload New Photo
                  </button>
                  <p class="text-sm text-gray-500 mt-2">JPG, PNG or GIF. Max 5MB. Recommended: 400x400px square image.</p>
                  <div id="upload-progress" class="hidden mt-2">
                    <div class="bg-gray-200 rounded-full h-2">
                      <div id="upload-progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                    <p id="upload-status" class="text-sm text-gray-600 mt-1">Uploading...</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Basic Information -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Name *</label>
                <input
                  type="text"
                  id="edit-name"
                  required
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Agency Name</label>
                <input
                  type="text"
                  id="edit-agency"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
            </div>

            <!-- Title -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Title</label>
              <input
                type="text"
                id="edit-title"
                placeholder="e.g., Talent Director, Founding Partner, Executive Recruiter"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
              />
            </div>

            <!-- Contact Information -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Email *</label>
                <input
                  type="email"
                  id="edit-email"
                  required
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
              <div>
                <label class="block text-base font-semibold text-gray-900 mb-2">Website</label>
                <input
                  type="url"
                  id="edit-website"
                  placeholder="https://"
                  class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
                />
              </div>
            </div>

            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">LinkedIn Profile *</label>
              <input
                type="url"
                id="edit-linkedin"
                required
                placeholder="https://linkedin.com/in/"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base"
              />
            </div>

            <!-- About -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">About *</label>
              <textarea
                id="edit-about"
                required
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="4"
                placeholder="Tell us about your background, experience, and what makes you unique..."
              ></textarea>
            </div>

            <!-- Specialties -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Specialties</label>
              <p class="text-sm text-gray-600 mb-2">Separate each specialty with a comma (e.g., "Design Leadership, UX Design, Product Design")</p>
              <textarea
                id="edit-specialties"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="2"
                placeholder="Design Leadership, UX Design, Product Design... (Optional)"
              ></textarea>
            </div>

            <!-- Philosophy -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Philosophy *</label>
              <textarea
                id="edit-philosophy"
                required
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="3"
                placeholder="Share your core beliefs about recruiting and talent acquisition..."
              ></textarea>
            </div>

            <!-- Approach -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Approach *</label>
              <textarea
                id="edit-approach"
                required
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="3"
                placeholder="Describe your process and methodology for finding and placing candidates..."
              ></textarea>
            </div>

            <!-- Notable Clients -->
            <div>
              <label class="block text-base font-semibold text-gray-900 mb-2">Notable Clients</label>
              <p class="text-sm text-gray-600 mb-2">Separate each client with a comma (e.g., "Airbnb, Zillow, Square, Yahoo")</p>
              <textarea
                id="edit-notable-clients"
                class="w-full rounded-lg border border-gray-300 bg-gray-50 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black text-base resize-none"
                rows="3"
                placeholder="Notable companies or clients you've worked with... (Optional)"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-6">
              <button
                type="submit"
                id="submit-btn"
                class="font-semibold py-3 px-12 rounded-lg shadow-sm transition bg-black text-white hover:bg-gray-900"
              >
                Update Profile
              </button>
            </div>
          </form>

          <!-- Error/Success Messages -->
          <div id="error-message" class="mt-4 hidden">
            <div class="bg-red-50 border border-red-200 rounded-lg p-3">
              <p class="text-sm text-red-600" id="error-text"></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}
</WideLayout>

<script define:vars={{ validRecruiterData, hasAccess, displayName }}>
// Make recruiter data globally available
window.currentRecruiterData = validRecruiterData;
window.hasAccess = hasAccess;
window.displayName = displayName;

// Image handling functions
function populateCurrentImage(recruiterData) {
  const currentImage = document.getElementById('current-image');
  const imagePlaceholder = document.getElementById('image-placeholder');
  const initialsPlaceholder = document.getElementById('initials-placeholder');
  
  if (recruiterData.image && recruiterData.image.trim()) {
    // Show current image
    currentImage.src = recruiterData.image;
    currentImage.style.display = 'block';
    imagePlaceholder.style.display = 'none';
  } else {
    // Show initials placeholder
    const nameForInitials = window.displayName || recruiterData.name;
    const initials = nameForInitials
      .split(' ')
      .map(word => word.charAt(0))
      .join('')
      .toUpperCase()
      .slice(0, 2);
    initialsPlaceholder.textContent = initials;
    currentImage.style.display = 'none';
    imagePlaceholder.style.display = 'flex';
  }
}

function handleImageUpload() {
  const fileInput = document.getElementById('image-upload');
  const file = fileInput.files[0];
  
  if (!file) return;
  
  // Validate file
  if (!validateImageFile(file)) return;
  
  // Show preview
  showImagePreview(file);
  
  // Store the file for upload when form is submitted
  window.selectedImageFile = file;
}

function validateImageFile(file) {
  const maxSize = 5 * 1024 * 1024; // 5MB
  const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
  
  if (file.size > maxSize) {
    alert('File size must be less than 5MB');
    return false;
  }
  
  if (!allowedTypes.includes(file.type)) {
    alert('Please select a valid image file (JPG, PNG, or GIF)');
    return false;
  }
  
  return true;
}

function showImagePreview(file) {
  const currentImage = document.getElementById('current-image');
  const imagePlaceholder = document.getElementById('image-placeholder');
  
  console.log('Showing image preview for file:', file.name);
  
  const reader = new FileReader();
  reader.onload = function(e) {
    currentImage.src = e.target.result;
    currentImage.style.display = 'block';
    imagePlaceholder.style.display = 'none';
    console.log('Image preview loaded successfully');
  };
  reader.onerror = function() {
    console.error('Failed to load image preview');
  };
  reader.readAsDataURL(file);
}

function showUploadProgress(show) {
  const progressContainer = document.getElementById('upload-progress');
  const progressBar = document.getElementById('upload-progress-bar');
  const statusText = document.getElementById('upload-status');
  
  if (show) {
    progressContainer.classList.remove('hidden');
    progressBar.style.width = '0%';
    statusText.textContent = 'Uploading...';
  } else {
    progressContainer.classList.add('hidden');
  }
}

function updateUploadProgress(percent) {
  const progressBar = document.getElementById('upload-progress-bar');
  const statusText = document.getElementById('upload-status');
  
  progressBar.style.width = percent + '%';
  
  if (percent < 100) {
    statusText.textContent = `Uploading... ${percent}%`;
  } else {
    statusText.textContent = 'Processing...';
  }
}

