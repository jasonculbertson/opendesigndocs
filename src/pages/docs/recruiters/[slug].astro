---
import WideLayout from '../../../layouts/WideLayout.astro';

// Check for access parameter
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
const hasAccess = accessKey === 'recruit2024';
const backToRecruitersUrl = hasAccess ? '/docs/recruiters?access=recruit2024' : '/docs/recruiters';

// Function to create URL-friendly slugs
function createSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

// Define recruiters data - this should match the main recruiters page
const recruitersData = [
  {
    id: 1,
    name: "Laura Hunting",
    agency: "Found By",
    title: "Founding Partner",
    image: "/images/laura.jpeg",
    specialties: ["Design Leadership", "Executive Search", "UX Design", "Product Design"],
    linkedin: "https://www.linkedin.com/in/laurahunting/",
    website: "https://www.foundby.co/",
    email: "contact@foundby.co",
    bio: "Laura is a founding partner at Found By, a boutique talent agency and executive search firm specialized in design. With over a decade of experience building design leadership teams, Found By has placed talent at industry leaders including Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, and Squarespace. Laura is LinkedIn Certified Professional–Recruiter and focuses on building diverse teams thoughtfully and effectively for companies ranging from seed stage to Fortune 500.",
    philosophy: "Talent is the foundation of a company's culture and success. A strong design team will change your business for the better.",
    approach: ["Partnership-focused collaboration", "Quality over quantity placements", "Deep understanding of design community", "Transparent communication throughout process"],
    notableClients: ["Airbnb", "Zillow", "Square", "Yahoo", "Nike", "Calendly", "GoodRx", "Pinterest", "Duolingo", "Squarespace", "Nextdoor", "Hinge", "Monarch"],

    socialMedia: {
      linkedin: "/company/found-by-inc",
      instagram: "@foundby_co", 
      twitter: "@foundby_co"
    }
  },
  {
    id: 2,
    name: "Garrett Fowler",
    agency: "Offsite",
    title: "Founder",
    image: "/images/garrett.jpeg",
    specialties: ["Product Design", "UX Design", "Design Leadership"],
    linkedin: "https://www.linkedin.com/in/garrettfowler/",
    website: "https://www.off.site",
    email: "garrett@off.site",
    bio: "Garrett is the Founder of Offsite, a new kind of creative talent community focused on the intersection of career and creative practice. As a Design & Executive Talent Agent, he specializes in connecting exceptional design professionals with opportunities that align with their creative vision and career goals. His approach goes beyond traditional recruiting to build meaningful relationships within the creative community.",
    philosophy: "I believe that great design talent is the cornerstone of successful products. My role is to find not just skilled designers, but creative problem-solvers who can drive meaningful impact.",
    approach: "I take time to understand both the technical requirements and team dynamics before making introductions. Every placement should be a win-win for both designer and company.",

    socialMedia: {
      linkedin: "/in/garrettfowler",
      twitter: "@garrettfowler", 
      website: "off.site"
    }
  },
  {
    id: 3,
    name: "Daniel Wert",
    agency: "Wert&Co",
    title: "Founder",
    image: "/images/wert.jpeg",
    specialties: ["Engineering", "Product Design", "Design Leadership"],
    linkedin: "https://www.linkedin.com/in/qwertyresume/",
    website: "https://www.wertco.com",
    email: "daniel@wertco.com",
    bio: "Daniel is the founder of Wert&Co, a talent agency that has worked with some of the world's most influential companies. With proven expertise in attracting and closing top talent across engineering, product, and design, Daniel is known for his ability to zero in on the exact profile managers are looking for while building strong connections with candidates.",
    philosophy: "I believe in building genuine relationships with both candidates and clients. Great talent acquisition is about understanding not just skills, but cultural fit and career aspirations.",
    approach: "I take a consultative approach, diving deep into team dynamics and growth trajectories. Every placement should be a catalyst for mutual success.",

    socialMedia: {
      linkedin: "/in/qwertyresume",
      medium: "wertco.medium.com", 
      instagram: "@wertandco"
    }
  },
  {
    id: 4,
    name: "Dirk Cleveland",
    agency: "Fusion",
    title: "Executive Recruiter",
    image: "/images/dirk.jpeg",
    specialties: ["UX Design", "Product Design", "Design Systems"],

    linkedin: "https://www.linkedin.com/in/dirkcleveland/",
    website: "https://www.fusiontalent.com",
    email: "dirk@fusiontalent.com",
    bio: "Dirk specializes in Design Leadership Recruiting at Fusion, a 100% referral-based executive search firm focused exclusively on Engineering, Product, and Design leadership roles. With extensive experience placing executives at companies like Uber, Airbnb, Atlassian, and many more, Dirk focuses on long-term career growth and cultural alignment for senior design positions.",
    experience: "12+ years",
    placements: "350+",
    industries: ["SaaS", "Enterprise Software", "FinTech", "Healthcare Tech"],
    philosophy: "Success in design recruiting comes from understanding both the craft and the person. Every designer has a unique story and career trajectory that deserves thoughtful consideration.",
    approach: "I take time to understand each designer's career goals, work style, and values before making introductions. This ensures placements that lead to long-term satisfaction and growth.",
    notableClients: ["Uber", "Airbnb", "Atlassian", "Benchling", "Cohere", "Confluent", "Datadog", "Grammarly", "HubSpot", "Ironclad", "Okta", "Webflow", "Xero"],

    socialMedia: {
      linkedin: "/in/dirkcleveland",
      twitter: "@dirkcleveland", 
      website: "fusiontalent.com"
    }
  },
  {
    id: 5,
    name: "Dany Lennon",
    agency: "The Creative Register Inc.",
    title: "Talent Representative",
    image: "/images/dany.jpeg",
    specialties: ["Creative Management", "Talent Representation", "Multimedia Storytelling"],
    linkedin: "https://www.linkedin.com/in/danylennon/",
    website: "https://www.linkedin.com/company/the-creative-register-inc./",
    email: "hello@danylennon.com",
    bio: "Dany works at The Creative Register Inc., a creative management and representation company founded in 1987. The company specializes in promoting the representation of the finest creative talent available throughout the world, and negotiating their contracts and career prospects for alternative positioning within multimedia businesses across all platforms of storytelling.",
    philosophy: "Great creative talent deserves exceptional representation. We focus on positioning artists and creators for meaningful career advancement across all media disciplines.",
    approach: "I take a comprehensive approach to creative talent management, understanding both the artistic vision and business opportunities to create sustainable career paths for our represented talent.",

    socialMedia: {
      linkedin: "/in/danylennon",
      company: "/company/the-creative-register-inc"
    }
  }
];

export async function getStaticPaths() {
  return recruitersData.map((recruiter) => ({
    params: { slug: createSlug(recruiter.name) },
    props: { recruiter },
  }));
}

// Get the slug from the URL params
const { slug } = Astro.params;
let recruiter = Astro.props.recruiter;

// If no recruiter from props (dev mode), look it up by slug
if (!recruiter && slug) {
  recruiter = recruitersData.find(r => createSlug(r.name) === slug);
}

// If still no recruiter found, redirect
if (!recruiter) {
  return Astro.redirect('/docs/recruiters');
}

const title = `${recruiter!.name} - ${recruiter!.agency}`;
const description = `Connect with ${recruiter!.name} from ${recruiter!.agency}. Specializing in ${recruiter!.specialties.join(', ')}.`;
---

<WideLayout title={title} description={description}>
  <div class="py-8">
    <!-- Back Button -->
    <div class="mb-8">
      <a 
        href={backToRecruitersUrl}
        class="inline-flex items-center text-sm text-gray-600 hover:text-gray-900 transition-colors"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
        Back to Recruiters
      </a>
    </div>

    <!-- Main Content -->
    <div class="grid grid-cols-1 lg:grid-cols-8 gap-16">
      <!-- Left Column - Profile -->
      <div class="lg:col-span-3 lg:pr-8">
        <div class="bg-white rounded-2xl border border-gray-200 p-6 sticky top-8" style="box-shadow: 0 2px 8px -2px rgba(0,0,0,0.05)">
          <!-- Profile Image -->
          <div class="flex justify-center mb-6">
            <img
              src={recruiter.image}
              alt={`${recruiter.name} profile`}
              class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
            />
          </div>
          
          <!-- Name & Agency -->
          <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-gray-900 mb-2">{recruiter.name}</h1>
            <p class="text-sm text-gray-500 mb-4">{recruiter.title} at {recruiter.agency}</p>
          </div>



          <!-- Contact Buttons -->
          <div class="space-y-3">
            <a
              href={recruiter.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
              style="background-color: #f9fafb"
            >
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              Connect on LinkedIn
            </a>
            {recruiter.website && (
              <a
                href={recruiter.website}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Visit Website
              </a>
            )}
            {recruiter.email && (
              <a
                href={`mailto:${recruiter.email}`}
                class="flex items-center justify-center w-full border border-gray-300 text-gray-700 py-3 px-4 rounded-lg font-medium text-sm hover:bg-gray-100 transition-colors"
                style="background-color: #f9fafb"
              >
                Send Email
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column - Details -->
      <div class="lg:col-span-5">
        <!-- Bio -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mt-8 mb-4">About</h2>
          <p class="text-[15px]">{recruiter.bio}</p>
        </div>

        <hr class="border-gray-200 mb-8" />

        <!-- Specialties -->
        <div class="mb-8">
          <h2 class="text-xl font-semibold mt-8 mb-4">Specialties</h2>
          <div class="flex flex-wrap gap-2">
            {recruiter.specialties.map(specialty => (
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                {specialty}
              </span>
            ))}
          </div>
        </div>

        {recruiter.philosophy && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Philosophy</h2>
              <p class="text-[15px] italic">"{recruiter.philosophy}"</p>
            </div>
          </>
        )}

        {recruiter.approach && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Approach</h2>
              <p class="text-[15px]">{recruiter.approach}</p>
            </div>
          </>
        )}

        {recruiter.notableClients && (
          <>
            <hr class="border-gray-200 mb-8" />
            <div class="mb-8">
              <h2 class="text-xl font-semibold mt-8 mb-4">Notable Clients</h2>
              <div class="flex flex-wrap gap-2">
                {recruiter.notableClients.map(client => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium">
                    {client}
                  </span>
                ))}
              </div>
            </div>
          </>
        )}

      </div>
    </div>
  </div>
</WideLayout> 