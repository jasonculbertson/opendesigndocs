---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';

const entry = await getEntry('docs', 'levels/level-competencies');
const { Content } = await entry.render();

const productRoles = [
  {
    title: "Product Designer Competencies",
    description: "Skills and expectations for product designers at each level",
    href: "/docs/levels/level-competencies/product-designer",
    image: "🎨"
  },
  {
    title: "Content Designer Competencies",
    description: "Skills and expectations for content designers at each level",
    href: "/docs/levels/level-competencies/content-designer",
    image: "✍️"
  },
  {
    title: "UX Researcher Competencies",
    description: "Skills and expectations for researchers at each level",
    href: "/docs/levels/level-competencies/researcher",
    image: "🔬"
  },
  {
    title: "Design Ops Competencies",
    description: "Skills and expectations for design operations at each level",
    href: "/docs/levels/level-competencies/design-ops",
    image: "⚙️"
  }
];

const creativeRoles = [
  {
    title: "Graphic Designer Competencies",
    description: "Skills and expectations for graphic designers at each level",
    href: "/docs/levels/level-competencies/graphic-designer",
    image: "🎨"
  },
  {
    title: "Copywriter Competencies",
    description: "Skills and expectations for copywriters at each level",
    href: "/docs/levels/level-competencies/copywriter",
    image: "✍️"
  },
  {
    title: "Photographer Competencies",
    description: "Skills and expectations for photographers at each level",
    href: "/docs/levels/level-competencies/photographer",
    image: "📸"
  }
];

const careerPaths = [
  {
    title: "IC1 Competencies",
    description: "Core competencies for individual contributors",
    href: "/docs/levels/level-competencies/ic1",
    image: "👤"
  },
  {
    title: "Manager Competencies",
    description: "Skills and expectations for design managers",
    href: "/docs/levels/level-competencies/manager",
    image: "👥"
  }
];
---

<Layout title={entry.data.title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <div class="mb-12">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{entry.data.title}</h1>
      </div>

      <Content />

      <div class="space-y-12">
        <section>
          <h2 class="text-xl font-semibold text-[#1a1f36] mb-6">Product Role Competencies</h2>
          <div class="grid grid-cols-1 gap-4">
            {productRoles.map(role => (
              <Card {...role} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-[#1a1f36] mb-6">Creative Role Competencies</h2>
          <div class="grid grid-cols-1 gap-4">
            {creativeRoles.map(role => (
              <Card {...role} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-[#1a1f36] mb-6">Career Path Competencies</h2>
          <div class="grid grid-cols-1 gap-4">
            {careerPaths.map(role => (
              <Card {...role} />
            ))}
          </div>
        </section>
      </div>
    </article>
  </main>
</Layout>
