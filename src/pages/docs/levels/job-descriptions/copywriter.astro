---
import { getEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/ui/Card.astro';

const entry = await getEntry('docs', 'levels/job-descriptions/copywriter');

const title = "Copywriter";
const breadcrumbs = [
  { text: 'Job Descriptions', href: '/docs/levels/job-descriptions' }
];
const copywriterLevels = [
  { 
    title: "Jr. Copywriter",
    description: "Skills and expectations for junior copywriters",
    href: "/docs/levels/job-descriptions/copywriter/junior-copywriter",
    image: "🌱"
  },
  { 
    title: "Copywriter",
    description: "Skills and expectations for mid-level copywriters",
    href: "/docs/levels/job-descriptions/copywriter/copywriter",
    image: "⚡"
  },
  { 
    title: "Sr. Copywriter",
    description: "Skills and expectations for senior copywriters",
    href: "/docs/levels/job-descriptions/copywriter/sr-copywriter",
    image: "🚀"
  },
  { 
    title: "Copy Director",
    description: "Skills and expectations for lead copywriters",
    href: "/docs/levels/job-descriptions/copywriter/copy-director",
    image: "👥"
  },
  { 
    title: "Sr. Copy Director",
    description: "Skills and expectations for staff copywriters",
    href: "/docs/levels/job-descriptions/copywriter/sr-copy-director",
    image: "⭐"
  },
  { 
    title: "Associate Creative Director",
    description: "Skills and expectations for principal copywriters",
    href: "/docs/levels/job-descriptions/copywriter/associate-creative-director",
    image: "🎯"
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {copywriterLevels.map(level => (
          <Card {...level} />
        ))}
      </div>
    </article>
  </main>
</Layout>
