---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Product Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Designer', href: '/docs/levels/interview-panels/product-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Product Designer (L5)</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership, Influence, Career Intent</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you shaped direction or strategy beyond your immediate team.</li>
            <li>How do you build influence without formal authority?</li>
            <li>Tell me about a time you helped your team zoom out and rethink the problem space.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Leadership, Systems Thinking, Communication</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you identified a systemic problem and drove a holistic solution.</li>
            <li>How do you scale your impact across multiple squads or initiatives?</li>
            <li>Tell me about a situation where you had to navigate strong disagreement to move forward.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Strategic Framing, Systems Leadership</p>
          <p>The candidate should present <strong>two case studies</strong> that demonstrate their ability to set direction across teams or initiatives, influence senior stakeholders, and ship with high quality. They should articulate both the user impact and organizational impact of their work.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategy, Influence, Trade-offs</p>
            <ul class="list-disc pl-6">
              <li>Describe a time you co-owned a strategy with a PM or product leader.</li>
              <li>How do you frame design work to connect with business metrics?</li>
              <li>Tell me about a situation where you drove clarity through ambiguity.</li>
              <li>What's your approach when leadership alignment is fractured?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Quality Leadership, Coaching, Scalable Systems</p>
            <ul class="list-disc pl-6">
              <li>How have you influenced the design culture or bar across a team or org?</li>
              <li>Describe how you elevate junior or mid-level designers in a non-manager role.</li>
              <li>What does "vision work" mean to you — and when is it effective?</li>
              <li>Tell me about a design pattern or system you helped create or evolve.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Partnership, Architecture Awareness, Tech Trade-offs</p>
            <ul class="list-disc pl-6">
              <li>How do you collaborate with engineering leaders to align on scalable solutions?</li>
              <li>Describe a time when design drove or challenged a foundational technical direction.</li>
              <li>How do you support engineering teams in delivering quality outcomes at speed?</li>
              <li>What role do you play in shaping long-term technical vision?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Design Org Influence, Mentorship, Strategic Mindset</p>
          <ul class="list-disc pl-6">
            <li>What's your role in helping a design org grow and evolve?</li>
            <li>How do you create opportunities for others while increasing your own impact?</li>
            <li>Describe a time you pushed a team to reframe their assumptions or approach.</li>
            <li>Where are you trying to grow as a Staff-level IC?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
