---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Sr. Product Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Designer', href: '/docs/levels/interview-panels/product-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Sr. Product Designer (L3)</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Growth Trajectory, Motivation, Communication</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you stepped up to lead a part of a project.</li>
            <li>What kind of feedback helps you grow the most?</li>
            <li>Tell me about a time you helped your team zoom out and rethink the problem space.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Ownership, Autonomy, Strategic Craft</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you owned a feature or product area from discovery through delivery.</li>
            <li>How do you balance advocating for design with adapting to business or time constraints?</li>
            <li>How do you decide what "good enough" looks like at different stages?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Craft Maturity, Storytelling, Decision-Making</p>
          <p>The candidate should walk through <strong>two end-to-end case studies</strong> where they had a meaningful impact on the outcome. They should highlight decisions they made independently, how they handled ambiguity, and how they collaborated across disciplines.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Thinking, Prioritization, Influence</p>
            <ul class="list-disc pl-6">
              <li>Describe a time you challenged or reshaped product requirements.</li>
              <li>How do you approach trade-offs between design quality and timeline?</li>
              <li>Share an example where you had to drive clarity on a vague or shifting product goal.</li>
              <li>How do you build trust with PMs while advocating for design?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Systems Thinking, Feedback, Ownership</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you introduced a new pattern or proposed a change to a design system.</li>
              <li>How do you help more junior designers grow during crit or reviews?</li>
              <li>What does "designing at scale" mean to you?</li>
              <li>How have you balanced consistency vs. innovation in your work?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design-to-Dev Process, Technical Awareness, Velocity</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you collaborated early with engineering to influence architecture or feasibility.</li>
              <li>What's your approach to file management and handoff on a project you lead?</li>
              <li>How do you ensure design intent survives implementation?</li>
              <li>How have you handled scope cuts while preserving the core user experience?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Team Contribution, Growth Potential, Leadership Signals</p>
          <ul class="list-disc pl-6">
            <li>How do you contribute to design culture beyond your projects?</li>
            <li>What's something you're actively trying to improve as a designer right now?</li>
            <li>What does strong IC leadership mean to you?</li>
            <li>Describe a time you supported a teammate in a difficult situation.</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
