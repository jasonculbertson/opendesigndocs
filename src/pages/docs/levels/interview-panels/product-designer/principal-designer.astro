---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Principal Product Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Designer', href: '/docs/levels/interview-panels/product-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Principal Product Designer (L6)</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Maturity, Influence, Career Vision</p>
          <ul class="list-disc pl-6">
            <li>How do you define success in a Principal-level IC role?</li>
            <li>Tell me about a time you influenced change at an organizational or platform level.</li>
            <li>Can you describe a time you received feedback and how you acted on it?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision Setting, Cross-Org Influence, Strategic Leadership</p>
          <ul class="list-disc pl-6">
            <li>Describe a time you created or championed a vision that spanned multiple teams or product areas.</li>
            <li>How do you identify and prioritize which problems to solve at a systems level?</li>
            <li>Tell me about a time you helped an org shift direction or mindset.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Systems Thinking, Strategic Framing</p>
          <p>The candidate should present <strong>two case studies</strong> that show how they've influenced product and design direction at a multi-team or company level. They should highlight their thinking frameworks, cross-functional leadership, and long-term outcomes driven.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Business Strategy, Product Vision, Influence</p>
            <ul class="list-disc pl-6">
              <li>Share a time when you shaped product direction in collaboration with senior product leadership.</li>
              <li>How do you connect user-centered design decisions to business priorities or market shifts?</li>
              <li>Tell me about a time you helped reframe or redirect a company initiative through design.</li>
              <li>How do you approach prioritization and focus at a strategic level?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Strategy, Mentorship, Org-Level Impact</p>
            <ul class="list-disc pl-6">
              <li>How do you create alignment across a team of senior or staff-level designers?</li>
              <li>Tell me about a time your leadership materially evolved the way your team designed or operated.</li>
              <li>What role do you play in defining or evolving a design system used company-wide?</li>
              <li>How do you scale your thinking without diluting clarity?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Architecture-Aware Design, Long-Term Collaboration, Tech-Design Alignment</p>
            <ul class="list-disc pl-6">
              <li>Describe a time you partnered with engineering leadership on scalable technical direction.</li>
              <li>How do you balance immediate delivery needs with the integrity of a long-term vision?</li>
              <li>What's your approach to navigating disagreement between product, design, and engineering?</li>
              <li>How do you ensure your designs are resilient to change?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Influence, Culture Shaping, Thought Leadership</p>
          <ul class="list-disc pl-6">
            <li>What does "Principal Designer" mean to you in practice?</li>
            <li>How do you invest in the growth of others while increasing your own impact?</li>
            <li>Share a time you helped shape the values, norms, or rituals of a design org.</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Principal Product Designer Interview Panel" />
    </article>
  </main>
</Layout>
