---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Design Ops 1 Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops', href: '/docs/levels/interview-panels/design-ops' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Design Ops 1</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Organization, Curiosity, Communication</p>
          <ul class="list-disc pl-6">
            <li>What types of systems or tools do you enjoy organizing or managing?</li>
            <li>Tell me about a time you supported a team behind the scenes — what did you do?</li>
            <li>What kind of problems do you like solving?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Process Awareness, Follow-Through, Adaptability</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you coordinated a project or event — what was your role?</li>
            <li>How do you manage your time when multiple teams need your help at once?</li>
            <li>What do you do when a task or system is unclear or ambiguous?</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Collaboration, Communication, Prioritization</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure stakeholders stay informed on logistics or updates?</li>
              <li>Tell me about a time you helped a team meet a deadline or stay on track.</li>
              <li>What do you do when priorities suddenly change?</li>
              <li>How do you keep teams aligned without micromanaging?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Support Mindset, Workflow Awareness, Systems Thinking</p>
            <ul class="list-disc pl-6">
              <li>What's your role in helping designers do their best work?</li>
              <li>Tell me about a time you helped improve or organize a design-related workflow.</li>
              <li>How do you collect or organize team resources?</li>
              <li>What tools or templates have you helped maintain or improve?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Functional Communication, Detail Orientation, Adaptability</p>
            <ul class="list-disc pl-6">
              <li>How do you make sure you're communicating effectively across different functions?</li>
              <li>What systems or processes have you helped document or standardize?</li>
              <li>Tell me about a time you helped solve a small but meaningful pain point.</li>
              <li>How do you respond when something falls through the cracks?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Team Fit, Values, Growth Mindset</p>
          <ul class="list-disc pl-6">
            <li>What does being a "glue person" mean to you, and do you see yourself that way?</li>
            <li>How do you contribute to a positive and supportive team culture?</li>
            <li>What's something you've learned recently that you're proud of?</li>
            <li>Where are you hoping to grow in the next year?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
