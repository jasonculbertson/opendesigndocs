---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Principal Design Ops Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops', href: '/docs/levels/interview-panels/design-ops' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Principal Design Ops</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Organizational Influence, Vision, Systems Thinking</p>
          <ul class="list-disc pl-6">
            <li>What is a systems-level change you led that required cross-org alignment?</li>
            <li>How do you prioritize your time at the Principal level?</li>
            <li>What makes Design Ops impactful at the company-wide scale?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Executive Partnership, Cross-Org Design Enablement, Thought Leadership</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you reshaped how a design org was structured or operated.</li>
            <li>How do you help senior leadership define and implement strategy through operational systems?</li>
            <li>What long-term investments have you made that changed how people work, collaborate, or grow?</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Company-Level Integration, Executive Alignment, Business Fluency</p>
            <ul class="list-disc pl-6">
              <li>How do you align design with product and business goals through operational infrastructure?</li>
              <li>Tell me about a time you brought product, engineering, and design execs into sustained alignment.</li>
              <li>How do you integrate Ops thinking into company-wide planning or reorg cycles?</li>
              <li>What role do you play in narrative, communication, and visibility for design?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Culture Strategy, Design Principles, Quality Systems</p>
            <ul class="list-disc pl-6">
              <li>What systems have you built that permanently raised the bar for design craft?</li>
              <li>How do you help a distributed or scaled team feel aligned, cohesive, and empowered?</li>
              <li>Share an example where you codified or evolved design principles in partnership with leadership.</li>
              <li>What is your philosophy for design culture at scale — and how do you bring it to life?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Systems Integration, Tech Collaboration, Infrastructure</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you partnered with engineering leadership to implement operational systems at scale.</li>
              <li>How do you support cross-functional rituals across teams with very different cadences and structures?</li>
              <li>What role have you played in evolving internal tooling, process platforms, or shared services?</li>
              <li>How do you operationalize insight from technical delivery back into org strategy?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Legacy Thinking, Strategic Mentorship, Vision</p>
          <ul class="list-disc pl-6">
            <li>What kind of organizational legacy do you want to leave?</li>
            <li>How do you mentor and support Staff or Lead-level Ops partners?</li>
            <li>Tell me about a time you helped reimagine what Design Ops could be in your org.</li>
            <li>What do you want to build that hasn't existed before?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
