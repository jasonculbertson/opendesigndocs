---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Design Ops Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops', href: '/docs/levels/interview-panels/design-ops' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Design Ops</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Scope, Leadership Influence, Systemic Thinking</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you shaped how an entire design org operated.</li>
            <li>What makes you most effective as a strategic operator?</li>
            <li>How do you identify where your time and energy are most valuable?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Org Design, Systems Leadership, Executive Partnership</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a program or initiative that transformed a core part of the design org's ways of working.</li>
            <li>How do you influence org priorities, especially when they aren't aligned across disciplines?</li>
            <li>How do you balance short-term delivery support with long-term systems building?</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Executive Planning, Vision Translation, Business Alignment</p>
            <ul class="list-disc pl-6">
              <li>How do you work with PM leadership to ensure design is set up for success?</li>
              <li>Share an example where you helped translate a design or product vision into operational structure.</li>
              <li>What's your role in strategic planning cycles, roadmap reviews, or cross-org communication?</li>
              <li>How do you elevate design's role in company-wide execution?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Culture, Quality Systems, Mentorship</p>
            <ul class="list-disc pl-6">
              <li>How do you define and scale practices that support design quality?</li>
              <li>What rituals or systems have you built that designers still use today?</li>
              <li>How do you mentor or coach design managers and seniors to adopt better Ops practices?</li>
              <li>What role have you played in shaping levels, roles, or team norms?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Delivery Systems, Cross-Disciplinary Alignment, Tech Collaboration</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you helped reduce friction between design and engineering.</li>
              <li>How do you ensure shared rituals and tooling serve both design and engineering needs?</li>
              <li>What role do you play in platform, infra, or design systems operations?</li>
              <li>How do you negotiate trade-offs when delivery pressures conflict with design goals?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Identity, Cultural Stewardship, Strategic Impact</p>
          <ul class="list-disc pl-6">
            <li>What does Staff-level leadership mean to you in Ops?</li>
            <li>How do you use rituals, storytelling, or infrastructure to shape culture?</li>
            <li>Tell me about a time you helped unlock growth or clarity for a team in transition.</li>
            <li>What do you want your impact to look like a year from now?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
