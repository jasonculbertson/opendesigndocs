---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Design Ops Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops', href: '/docs/levels/interview-panels/design-ops' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Design Ops</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Strategic Case Study</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: Design Leadership</td><td>[Design Leaders]</td><td>45 min</td></tr>
              <tr><td>Round 2: Team Leadership</td><td>[Team Leaders]</td><td>45 min</td></tr>
              <tr><td>Round 2: Cross-functional</td><td>[Cross-functional Partners]</td><td>45 min</td></tr>
              <tr><td>Final/Executive Round</td><td>Executive Team Members</td><td>45 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership, Strategic Vision, Communication</p>
          <ul class="list-disc pl-6">
            <li>What drew you to design operations leadership, and what excites you about this opportunity?</li>
            <li>Tell me about a time when you led a strategic design operations initiative across multiple teams.</li>
            <li>How do you approach building and leading a design operations team?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Leadership, Team Development, Organizational Impact</p>
          <ul class="list-disc pl-6">
            <li>How do you approach creating a long-term vision and strategy for design operations?</li>
            <li>Tell me about a time you built or transformed a design operations function.</li>
            <li>How do you measure and communicate the business impact of design operations?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Strategic Case Study</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Organizational Change, Impact Measurement</p>
          <p>The candidate should present a comprehensive case study of a strategic design operations initiative they led that had significant organizational impact. The presentation should cover their vision, how they built alignment with leadership, their approach to implementation, how they led their team through the change, and the measurable business outcomes. The case study should demonstrate their ability to think strategically, lead teams, drive organizational change, and deliver measurable results.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Leadership Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Partnership, Design Enablement, Organizational Influence</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with design leadership to enable design excellence at scale?</li>
              <li>Tell me about a time you influenced design strategy through operational improvements.</li>
              <li>How do you balance standardization with the need for creative flexibility?</li>
              <li>What approaches have you used to scale design operations across a growing organization?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Team Leadership Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Team Building, Talent Development, Operational Excellence</p>
            <ul class="list-disc pl-6">
              <li>How do you approach building and developing a high-performing design ops team?</li>
              <li>Tell me about a time you had to make difficult decisions about team structure or resources.</li>
              <li>How do you foster a culture of continuous improvement in your team?</li>
              <li>What's your approach to setting goals and measuring success for your team?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Cross-functional Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Partnerships, Organizational Influence, Change Management</p>
            <ul class="list-disc pl-6">
              <li>How do you build strategic partnerships across the organization?</li>
              <li>Tell me about a time you led a cross-functional initiative that required significant change.</li>
              <li>How do you align design operations with broader organizational goals and strategies?</li>
              <li>What's your approach to navigating organizational politics and building consensus?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Executive Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Business Impact, Leadership</p>
          <ul class="list-disc pl-6">
            <li>What's your vision for how design operations can drive business success?</li>
            <li>How do you approach building relationships with executive stakeholders?</li>
            <li>Tell me about a time you had to make a difficult strategic decision with limited information.</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
