---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Senior Design Ops Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops', href: '/docs/levels/interview-panels/design-ops' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Senior Design Ops</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Case Study Presentation</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: Design Leadership</td><td>[Design Leader]</td><td>45 min</td></tr>
              <tr><td>Round 2: Design Team</td><td>[Designer Interviewers]</td><td>45 min</td></tr>
              <tr><td>Round 2: Cross-functional</td><td>[Cross-functional Partners]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Communication, Strategic Thinking, Leadership</p>
          <ul class="list-disc pl-6">
            <li>What drew you to design operations, and what excites you about this opportunity?</li>
            <li>Tell me about a time when you led a significant operational improvement for a design team.</li>
            <li>How do you approach balancing strategic initiatives with day-to-day operational needs?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Planning, Team Leadership, Problem-solving</p>
          <ul class="list-disc pl-6">
            <li>How do you approach creating a strategic roadmap for design operations?</li>
            <li>Tell me about a time you led a team through a significant operational change.</li>
            <li>How do you measure the impact of design operations on team effectiveness?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Case Study Presentation</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Thinking, Process Design, Impact Measurement</p>
          <p>The candidate should present a case study of a significant design operations initiative they led. The presentation should cover the problem they identified, their approach to solving it, how they implemented the solution, and the measurable impact it had on the design team and business. The case study should demonstrate their ability to think strategically, lead change, and measure outcomes.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Leadership Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Alignment, Resource Management, Team Development</p>
            <ul class="list-disc pl-6">
              <li>How do you align design operations with broader design and business strategy?</li>
              <li>Tell me about a time you had to make difficult resource allocation decisions.</li>
              <li>How do you approach developing and mentoring more junior design ops team members?</li>
              <li>What frameworks or methodologies do you use to evaluate and improve design operations?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Team Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Designer Advocacy, Process Improvement, Change Management</p>
            <ul class="list-disc pl-6">
              <li>How do you balance designer needs with operational efficiency?</li>
              <li>Tell me about a time you implemented a significant process change. How did you get buy-in?</li>
              <li>How do you gather and incorporate feedback from designers at different levels?</li>
              <li>What approaches have you used to scale design operations as teams grow?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Cross-functional Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Collaboration, Stakeholder Management, Organizational Influence</p>
            <ul class="list-disc pl-6">
              <li>How do you build strategic partnerships across the organization?</li>
              <li>Tell me about a time you had to influence without authority to drive an operational change.</li>
              <li>How do you align design operations with the needs of other departments?</li>
              <li>What's your approach to managing complex cross-functional initiatives?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Cultural Leadership, Strategic Vision, Organizational Impact</p>
          <ul class="list-disc pl-6">
            <li>How do you contribute to building a positive team culture?</li>
            <li>What's your vision for how design operations can drive organizational success?</li>
            <li>How do you approach balancing immediate needs with long-term strategic goals?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
