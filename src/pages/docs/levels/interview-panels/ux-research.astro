---
import { getEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';

const title = "UX Research Interview Panels";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' }
];

const designerLevels = [
  { 
    title: "Researcher I",
    description: "Interview panel for entry-level researchers",
    href: "/docs/levels/interview-panels/ux-research/researcher-1",
    image: "🌱"
  },
  { 
    title: "Researcher II",
    description: "Interview panel for mid-level researchers",
    href: "/docs/levels/interview-panels/ux-research/researcher-2",
    image: "⚡"
  },
  { 
    title: "Sr. Researcher",
    description: "Interview panel for senior researchers",
    href: "/docs/levels/interview-panels/ux-research/senior-researcher",
    image: "🚀"
  },
  { 
    title: "Lead Researcher",
    description: "Interview panel for lead researchers",
    href: "/docs/levels/interview-panels/ux-research/lead-researcher",
    image: "👥"
  },
  { 
    title: "Staff Researcher",
    description: "Interview panel for staff researchers",
    href: "/docs/levels/interview-panels/ux-research/staff-researcher",
    image: "⭐"
  },
  { 
    title: "Principal Researcher",
    description: "Interview panel for principal researchers",
    href: "/docs/levels/interview-panels/ux-research/principal-researcher",
    image: "🎯"
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {designerLevels.map(level => (
          <Card
            title={level.title}
            description={level.description}
            href={level.href}
            image={level.image}
          />
        ))}
      </div>
    </article>
  </main>
</Layout>
