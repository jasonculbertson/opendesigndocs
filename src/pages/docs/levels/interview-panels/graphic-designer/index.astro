---
import Layout from '../../../../../layouts/Layout.astro';
import Card from '../../../../../components/ui/Card.astro';

const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' }
];

interface Role {
  title: string;
  description: string;
  href: string;
  image: string;
}

const levels: Role[] = [
  {
    title: "Jr. Designer",
    description: "Interview panel for junior graphic designers",
    href: "/docs/levels/interview-panels/graphic-designer/junior-designer",
    image: "🌱"
  },
  {
    title: "Designer",
    description: "Interview panel for mid-level graphic designers",
    href: "/docs/levels/interview-panels/graphic-designer/designer",
    image: "⚡"
  },
  {
    title: "Sr. Designer",
    description: "Interview panel for senior graphic designers",
    href: "/docs/levels/interview-panels/graphic-designer/senior-designer",
    image: "🚀"
  },
  {
    title: "Art Director",
    description: "Interview panel for art directors",
    href: "/docs/levels/interview-panels/graphic-designer/art-director",
    image: "👥"
  },
  {
    title: "Sr. Art Director",
    description: "Interview panel for senior art directors",
    href: "/docs/levels/interview-panels/graphic-designer/senior-art-director",
    image: "⭐"
  },
  {
    title: "Associate Creative Director",
    description: "Interview panel for creative directors",
    href: "/docs/levels/interview-panels/graphic-designer/associate-creative-director",
    image: "🎯"
  }
];

const title = "Graphic Designer";
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>

      <div class="grid grid-cols-1 gap-4">
        {levels.map(level => (
          <Card {...level} />
        ))}
      </div>
    </article>
  </main>
</Layout>
