---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Graphic Designer', href: '/docs/levels/interview-panels/graphic-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Designer</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Communication, Growth, Autonomy</p>
          <ul class="list-disc pl-6">
            <li>What types of design projects do you feel most confident leading?</li>
            <li>How do you balance meeting a deadline with making something visually excellent?</li>
            <li>What kind of feedback helps you grow the most?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Execution, Ownership, Creative Decision-Making</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a project you owned from start to finish — what were the key decisions you made?</li>
            <li>How do you balance creative exploration with staying on brand?</li>
            <li>Tell me about a time you had to push back on unclear or conflicting feedback.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Visual Systems, Concept Development, Consistency</p>
          <p>The candidate should present 2–3 projects that demonstrate strong typographic, compositional, and conceptual craft.
Look for clarity in storytelling, polish in execution, and an ability to adapt design for different mediums or audiences.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Business Alignment, Cross-Functional Collaboration, Clarity</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you collaborated with marketing or product to align visuals to goals.</li>
              <li>How do you clarify ambiguous briefs or missing requirements?</li>
              <li>How do you adjust design direction based on stakeholder feedback?</li>
              <li>What's your process for presenting work to non-designers?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Visual Strategy, Design Language, Iteration</p>
            <ul class="list-disc pl-6">
              <li>How do you build on existing design systems to create new, fresh visuals?</li>
              <li>Tell me about a time you had to explore multiple creative directions — how did you decide which one to move forward with?</li>
              <li>What role do you play in critique — both giving and receiving feedback?</li>
              <li>How do you maintain craft quality under fast timelines?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Collaboration, Handoff, Technical Flexibility</p>
            <ul class="list-disc pl-6">
              <li>How do you collaborate with developers on responsive or interactive visual assets?</li>
              <li>Tell me about a time you adapted your design due to technical limitations.</li>
              <li>What tools or processes do you use for clean handoff?</li>
              <li>How do you test how your visuals behave in production?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Design Advocacy, Autonomy, Creative Process</p>
          <ul class="list-disc pl-6">
            <li>How do you champion design value to non-design stakeholders?</li>
            <li>Tell me about a time you resolved creative differences with a colleague.</li>
            <li>What does "good design" mean to you, and how has that evolved over time?</li>
            <li>How have you grown both personally and professionally in your last role?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
