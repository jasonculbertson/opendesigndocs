---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Junior Graphic Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Graphic Designer', href: '/docs/levels/interview-panels/graphic-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Junior Graphic Designer</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Growth Potential, Visual Communication, Curiosity</p>
          <ul class="list-disc pl-6">
            <li>What kinds of design work are you most excited to grow into?</li>
            <li>Tell me about a time you took feedback and used it to improve your work.</li>
            <li>What kinds of creative projects do you enjoy outside of your job or school?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Craft, Visual Foundations, Coachability</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a recent project — how did you approach the layout and visual direction?</li>
            <li>How do you decide what makes a design "finished"?</li>
            <li>Tell me about a time you struggled with a creative brief — how did you resolve it?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Visual Execution, Composition, Storytelling</p>
          <p>The candidate should walk through 2–3 pieces that show range and potential across layout, color, typography, or illustration.
We're looking for intent behind design decisions, openness to critique, and creative voice — not perfection.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Collaboration, Timelines, Design Communication</p>
            <ul class="list-disc pl-6">
              <li>How do you make sure your designs support a specific business or campaign goal?</li>
              <li>What do you do when you're given limited direction or vague feedback?</li>
              <li>How do you communicate your timeline or progress with non-design teammates?</li>
              <li>What's your process for clarifying a design brief?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Craft, Iteration, Design Language</p>
            <ul class="list-disc pl-6">
              <li>Tell me about your process from idea to final visual — how do you get started?</li>
              <li>How do you ensure your work aligns with a brand or design system?</li>
              <li>Show me an example where your design evolved after critique — what changed and why?</li>
              <li>How do you balance creative ideas with visual consistency?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Implementation Awareness, Handoff, Collaboration</p>
            <ul class="list-disc pl-6">
              <li>Have you ever worked with developers or engineers to bring a design to life?</li>
              <li>What file setup or tools do you use to keep your work dev-friendly?</li>
              <li>Tell me about a time your design didn't turn out as expected in implementation — what happened?</li>
              <li>How do you handle technical constraints in visual design?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Creativity, Team Fit, Growth Mindset</p>
          <ul class="list-disc pl-6">
            <li>What kind of team environment helps you do your best creative work?</li>
            <li>How do you handle creative block or feedback you disagree with?</li>
            <li>What are you most excited to learn in your next role?</li>
            <li>How do you like to contribute to a team's culture or energy?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
