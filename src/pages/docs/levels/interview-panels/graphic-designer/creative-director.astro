---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Creative Director L6 Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Graphic Designer', href: '/docs/levels/interview-panels/graphic-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Creative Director L6</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>Recruiter</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>Design Director</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM Interview</td><td>Senior PM</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer Interview</td><td>Senior Designer</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer Interview</td><td>Senior Engineer</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Influence, Executive Readiness</p>
          <ul class="list-disc pl-6">
            <li>What's your approach to setting creative direction across a company or platform?</li>
            <li>Tell me about a time you aligned multiple stakeholders behind a bold, differentiated brand idea.</li>
            <li>How do you define success as a creative leader at the Director level?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Brand Strategy, Org Leadership, Systems Thinking</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you defined a company's creative strategy across product, brand, and marketing.</li>
            <li>How do you scale brand storytelling while preserving creativity and cohesion?</li>
            <li>How do you evaluate and mentor leaders like ACDs and Art Directors?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Brand Narrative, Vision Realization, Scaled Impact</p>
          <p>The candidate should walk through 2–3 large-scale initiatives that span brand definition, campaign ecosystems, or experience vision.
Look for clarity of intent, narrative development, high craft standards, and evidence of organizational leadership.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Functional Alignment, Narrative Strategy, Business Fluency</p>
            <ul class="list-disc pl-6">
              <li>How do you bring product, design, and marketing together under a shared creative vision?</li>
              <li>Tell me about a time you helped shift the company's narrative through brand or campaign design.</li>
              <li>What's your role in quarterly or annual planning with product and business leadership?</li>
              <li>How do you ensure creative direction aligns with both vision and execution realities?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Team Leadership, Mentorship, Design Philosophy</p>
            <ul class="list-disc pl-6">
              <li>How do you grow and empower design leaders under your direction?</li>
              <li>What's your approach to developing creative principles and scaling them across teams?</li>
              <li>Tell me about a time you helped a creative team through a tough critique or directional pivot.</li>
              <li>What's your philosophy on balancing innovation, systemization, and brand heritage?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Surface Execution, Technical Collaboration, Operational Design</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure your creative direction scales across multiple platforms (web, mobile, campaign, etc.)?</li>
              <li>What systems or tools have you helped implement to ensure brand consistency in code?</li>
              <li>How do you collaborate with engineering leads on animation, performance, or asset delivery?</li>
              <li>Tell me about a time you had to evolve a design vision due to technical constraints — what changed and why?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Creative Culture, Leadership Legacy, Vision</p>
          <ul class="list-disc pl-6">
            <li>What kind of creative culture do you strive to build and protect?</li>
            <li>How do you hold space for experimentation and risk-taking across levels?</li>
            <li>Tell me about a time you helped an org rediscover or evolve its creative identity.</li>
            <li>What do you hope your creative legacy will be here?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
