---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Art Director Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Graphic Designer', href: '/docs/levels/interview-panels/graphic-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Art Director</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>Recruiter</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>Design Director</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM Interview</td><td>Senior PM</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer Interview</td><td>Senior Designer</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer Interview</td><td>Senior Engineer</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Creative Leadership, Influence, Collaboration</p>
          <ul class="list-disc pl-6">
            <li>What types of creative leadership challenges are you most excited to take on?</li>
            <li>How do you help bring cross-functional partners along when the creative vision is ambitious or unconventional?</li>
            <li>What's your personal definition of art direction?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Team Development, Strategy</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a campaign or brand system you directed — what was your role and what impact did it have?</li>
            <li>How do you approach creative direction when leading multiple designers or agencies?</li>
            <li>Tell me about a time you helped elevate design thinking or creative craft across a team.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Team Impact, Brand Development</p>
          <p>The candidate should share 2–3 projects that showcase campaign work, brand evolution, or visual systems where they acted as the art director.
Look for clarity in concept, execution across surfaces, and team leadership. Bonus if they can show how they balanced systematization with creativity.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Alignment, Stakeholder Management, Planning</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure creative and marketing/product goals are aligned from the beginning?</li>
              <li>Tell me about a time you had to advocate for creative quality when timelines or budget were constrained.</li>
              <li>How do you present creative work to senior stakeholders or execs?</li>
              <li>What's your role in creative review and sign-off rituals?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Mentorship, Quality Standards, Systems Thinking</p>
            <ul class="list-disc pl-6">
              <li>How do you support and challenge mid-level and senior designers on your team?</li>
              <li>Tell me about a time you helped a teammate move from execution to concept leadership.</li>
              <li>How do you define and evolve the creative bar for a brand or product?</li>
              <li>What systems or rituals have you built to maintain consistent visual quality?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Delivery, Brand Implementation, Collaboration</p>
            <ul class="list-disc pl-6">
              <li>Share a time you partnered with engineers to realize a campaign or interactive design.</li>
              <li>How do you balance creative ambition with technical constraints?</li>
              <li>What role do you play in the QA, testing, or post-launch refinement process?</li>
              <li>How do you ensure brand standards hold up across platforms and responsive layouts?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Philosophy, Team Culture, Creative Values</p>
          <ul class="list-disc pl-6">
            <li>What does an inclusive and inspiring creative team culture look like to you?</li>
            <li>How do you build trust with peers and direct reports?</li>
            <li>Tell me about a time you helped a team navigate creative uncertainty or a tough critique.</li>
            <li>What legacy are you hoping to leave as an Art Director?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Art Director Interview Panel" />
    </article>
  </main>
</Layout>
