---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Senior Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Graphic Designer', href: '/docs/levels/interview-panels/graphic-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Sr. Designer</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>Recruiter</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>Design Director</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>Design Lead, Design Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM Interview</td><td>Senior PM</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer Interview</td><td>Senior Designer</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering Interview</td><td>Senior Engineer</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Design Director or VP</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership, Strategic Experience, Mentorship</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you led the visual direction for a significant project. What was your approach?</li>
            <li>How have you influenced design decisions at a strategic or organizational level?</li>
            <li>What's your approach to mentoring or developing more junior designers?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Design Leadership, Business Impact</p>
          <ul class="list-disc pl-6">
            <li>How do you approach translating business goals into visual strategies that drive results?</li>
            <li>Tell me about a time you championed a design direction that was challenging but ultimately successful.</li>
            <li>How do you manage stakeholder expectations while maintaining design quality?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Brand Strategy, Design Leadership, Measurable Impact</p>
          <p>The candidate should present 3–4 projects where they led creative strategy and execution. Look for strategic process, cross-functional leadership, and measurable results from their work. Senior candidates should demonstrate clear articulation of design decisions in relation to business goals, stakeholder management skills, and innovative solutions within constraints.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Partnership, Business Alignment, Cross-Functional Leadership</p>
            <ul class="list-disc pl-6">
              <li>How do you translate business objectives into creative briefs or design strategies?</li>
              <li>Tell me about a time when you influenced product direction through visual design.</li>
              <li>What process do you use to manage multiple visual projects or campaigns with competing priorities?</li>
              <li>How do you advocate for design while navigating business constraints or stakeholder needs?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Creative Direction, Visual Systems, Team Mentorship</p>
            <ul class="list-disc pl-6">
              <li>How do you establish and maintain visual consistency across complex campaigns or products?</li>
              <li>Tell me about a time you helped another designer significantly improve their work.</li>
              <li>What's your approach to developing a visual system that others can successfully build upon?</li>
              <li>How do you balance innovation with established brand or design system constraints?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Technical Partnership, Systems Thinking, Implementation Strategy</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with engineering teams to ensure successful implementation of visual assets?</li>
              <li>Tell me about a time you solved a complex production or implementation challenge.</li>
              <li>What's your approach to designing scalable visual systems that work across different platforms?</li>
              <li>How do you balance creative vision with technical or performance constraints?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Design Leadership, Vision, Change Management</p>
          <ul class="list-disc pl-6">
            <li>How have you elevated the quality of design at your current organization?</li>
            <li>What's your approach to championing design culture across disciplines?</li>
            <li>Tell me about a time you led change or transformation in a design process or team.</li>
            <li>How does your leadership style evolve depending on the needs of different team members?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
