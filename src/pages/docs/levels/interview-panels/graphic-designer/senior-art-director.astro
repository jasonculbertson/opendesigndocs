---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Senior Art Director Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Graphic Designer', href: '/docs/levels/interview-panels/graphic-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Sr. Art Director</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>Recruiter</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>Design Director</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM Interview</td><td>Senior PM</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer Interview</td><td>Senior Designer</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer Interview</td><td>Senior Engineer</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Leadership Readiness, Communication</p>
          <ul class="list-disc pl-6">
            <li>What kinds of creative leadership challenges are you most drawn to at this stage in your career?</li>
            <li>Tell me about a time you aligned multiple stakeholders around a bold creative idea.</li>
            <li>How do you describe your leadership style when working with senior designers or art directors?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision Ownership, Strategic Impact, People Leadership</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a program or campaign you directed that required leading multiple designers or disciplines.</li>
            <li>How do you balance creative risk with business or brand constraints?</li>
            <li>What systems or standards have you implemented to ensure high craft across a growing team?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Creative Direction, Systems-Level Thinking, Brand Evolution</p>
          <p>The candidate should share 2–3 large-scale creative initiatives — ideally including campaign work, brand evolution, and creative systems.
Look for vision, scalability, cross-team influence, and clear decision-making.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Alignment, Storytelling, Influence</p>
            <ul class="list-disc pl-6">
              <li>How do you help PMs or marketers frame briefs for maximum creative potential?</li>
              <li>Share an example where your creative direction helped a product or campaign achieve broader reach or success.</li>
              <li>How do you influence creative prioritization at the roadmap or planning level?</li>
              <li>How do you balance business, audience, and creative needs in launch planning?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Creative Mentorship, Craft Standards, Systems Leadership</p>
            <ul class="list-disc pl-6">
              <li>How do you help designers transition from executional roles to creative leads?</li>
              <li>Share a time you elevated the design system or brand standard without creating rigidity.</li>
              <li>How do you support experimentation while maintaining cohesion?</li>
              <li>What feedback or critique practices do you consider essential at this level?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Technical Fluency, Collaboration, Brand Execution</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure your creative direction holds up across engineering execution?</li>
              <li>Tell me about a time you collaborated with engineering to elevate the visual experience.</li>
              <li>What's your process for ensuring campaign assets and animations are delivered and implemented correctly?</li>
              <li>How do you navigate brand vision across different platforms and touchpoints?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Executive Presence, Culture Shaping, Org Impact</p>
          <ul class="list-disc pl-6">
            <li>How do you lead through influence when creative vision is questioned or under pressure?</li>
            <li>Tell me about a time you created a culture of trust or risk-taking on your team.</li>
            <li>What do you look for when building or scaling a high-performing creative team?</li>
            <li>Where do you want to grow as a creative leader over the next few years?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
