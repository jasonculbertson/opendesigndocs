---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Designer I Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Design', href: '/docs/levels/interview-panels/product-design' }
];

---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      
      <div class="prose max-w-none">
        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Plan</h2>
        
        <div class="overflow-x-auto">
          <table class="min-w-full border-collapse">
            <thead>
              <tr>
                <th class="p-4 text-left text-xs font-semibold text-[#1a1f36] border border-[#E6E8EB] bg-[#F8F9FB]">Stage</th>
                <th class="p-4 text-left text-xs font-semibold text-[#1a1f36] border border-[#E6E8EB] bg-[#F8F9FB]">Interviewer</th>
                <th class="p-4 text-left text-xs font-semibold text-[#1a1f36] border border-[#E6E8EB] bg-[#F8F9FB]">Competencies</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-4 text-xs leading-7 text-[#1a1f36] border border-[#E6E8EB] align-top">Recruiter Screen</td>
                <td class="p-4 text-xs leading-7 text-[#1a1f36] border border-[#E6E8EB] align-top">[Recruiter Name]</td>
                <td class="p-4 text-xs leading-7 text-[#1a1f36] border border-[#E6E8EB]">
                  <ul class="list-none pl-0 my-0 space-y-2">
                    <li>Basic product design principles</li>
                    <li>Visual design elements (typography, layout, information prioritization)</li>
                    <li>Adherence to design systems and best practices</li>
                    <li>Basic prototyping skills</li>
                  </ul>
                </td>
              </tr>
              <tr>
                <td class="p-4 text-xs leading-7 text-[#1a1f36] border border-[#E6E8EB] align-top">Hiring Manager Screen</td>
                <td class="p-4 text-xs leading-7 text-[#1a1f36] border border-[#E6E8EB] align-top">Jason Culbertson</td>
                <td class="p-4 text-xs leading-7 text-[#1a1f36] border border-[#E6E8EB]">
                  <ul class="list-none pl-0 my-0 space-y-2">
                    <li>Collaboration with PMs and engineers</li>
                    <li>Understanding of project scope and context</li>
                    <li>Iterative design process</li>
                    <li>Basic understanding of product strategy</li>
                  </ul>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      </div>
    </article>
  </main>
</Layout>
