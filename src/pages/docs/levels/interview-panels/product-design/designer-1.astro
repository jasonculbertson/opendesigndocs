---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Designer I Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Design', href: '/docs/levels/interview-panels/product-design' }
];

---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      
      <div class="prose max-w-none">
        <h2>Interview Structure</h2>
        <ul>
          <li><strong>Portfolio Review (45 mins)</strong>
            <ul>
              <li>Past work discussion</li>
              <li>Design process evaluation</li>
              <li>Problem-solving approach</li>
            </ul>
          </li>
          <li><strong>Design Exercise (45 mins)</strong>
            <ul>
              <li>Real-time problem solving</li>
              <li>Whiteboarding session</li>
              <li>Design thinking demonstration</li>
            </ul>
          </li>
          <li><strong>Technical Discussion (30 mins)</strong>
            <ul>
              <li>UI/UX principles</li>
              <li>Tool proficiency</li>
              <li>Design systems knowledge</li>
            </ul>
          </li>
          <li><strong>Team Fit (30 mins)</strong>
            <ul>
              <li>Collaboration style</li>
              <li>Communication skills</li>
              <li>Growth mindset</li>
            </ul>
          </li>
        </ul>

        <h2>Evaluation Criteria</h2>
        <ul>
          <li><strong>Design Skills</strong>
            <ul>
              <li>Understanding of basic design principles</li>
              <li>Ability to create user-centered solutions</li>
              <li>Visual design capabilities</li>
            </ul>
          </li>
          <li><strong>Technical Knowledge</strong>
            <ul>
              <li>Familiarity with design tools</li>
              <li>Understanding of design systems</li>
              <li>Basic prototyping skills</li>
            </ul>
          </li>
          <li><strong>Soft Skills</strong>
            <ul>
              <li>Communication clarity</li>
              <li>Teamwork potential</li>
              <li>Learning attitude</li>
            </ul>
          </li>
        </ul>

        <h2>Key Questions</h2>
        <ul>
          <li>Walk us through a recent project you worked on. What was your role and contribution?</li>
          <li>How do you approach gathering and incorporating user feedback into your designs?</li>
          <li>Describe a design challenge you faced and how you overcame it.</li>
          <li>How do you stay updated with the latest design trends and technologies?</li>
        </ul>
      </div>
    </article>
  </main>
</Layout>
