---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Design', href: '/docs/levels/interview-panels/product-design' }
];

---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1>Lead Designer Interview Panel</h1>
        
        <h2>Panel Overview</h2>
        <p>The Lead Designer interview panel assesses candidates for leadership roles in product design. The focus is on evaluating team leadership, strategic vision, and the ability to drive design excellence across projects.</p>

        <h2>Interview Structure</h2>
        <ul>
          <li><strong>Portfolio & Vision (60 min)</strong>
            <ul>
              <li>Strategic project leadership</li>
              <li>Team impact and influence</li>
              <li>Design vision and direction</li>
            </ul>
          </li>
          <li><strong>Leadership Exercise (60 min)</strong>
            <ul>
              <li>Team leadership scenarios</li>
              <li>Design strategy development</li>
              <li>Cross-functional alignment</li>
            </ul>
          </li>
          <li><strong>System Design (45 min)</strong>
            <ul>
              <li>Design systems leadership</li>
              <li>Scalable solutions</li>
              <li>Process improvement</li>
            </ul>
          </li>
          <li><strong>Executive Discussion (45 min)</strong>
            <ul>
              <li>Strategic alignment</li>
              <li>Business acumen</li>
              <li>Leadership philosophy</li>
            </ul>
          </li>
        </ul>

        <h2>Key Assessment Areas</h2>
        <ul>
          <li>Team leadership</li>
          <li>Strategic vision</li>
          <li>Design excellence</li>
          <li>Process optimization</li>
          <li>Cross-functional influence</li>
        </ul>

        <h2>Expected Outcomes</h2>
        <p>Successful candidates should demonstrate:</p>
        <ul>
          <li>Strong leadership capabilities</li>
          <li>Strategic thinking and vision</li>
          <li>Process improvement expertise</li>
          <li>Team development skills</li>
          <li>Business understanding</li>
        </ul>
      </div>
    </article>
  </main>
</Layout>
