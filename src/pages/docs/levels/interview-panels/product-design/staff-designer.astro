---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Staff Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Design', href: '/docs/levels/interview-panels/product-design' }
];

---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1>Staff Designer Interview Panel</h1>
        
        <h2>Panel Overview</h2>
        <p>The Staff Designer interview panel evaluates candidates for senior individual contributor roles. The focus is on assessing deep technical expertise, organizational influence, and the ability to drive large-scale design initiatives.</p>

        <h2>Interview Structure</h2>
        <ul>
          <li><strong>Technical Portfolio (60 min)</strong>
            <ul>
              <li>Deep technical expertise</li>
              <li>System-level thinking</li>
              <li>Architecture and scalability</li>
            </ul>
          </li>
          <li><strong>Design Systems (60 min)</strong>
            <ul>
              <li>Systems architecture</li>
              <li>Component design</li>
              <li>Technical implementation</li>
            </ul>
          </li>
          <li><strong>Organizational Impact (45 min)</strong>
            <ul>
              <li>Cross-team influence</li>
              <li>Mentorship and guidance</li>
              <li>Process improvement</li>
            </ul>
          </li>
          <li><strong>Strategic Vision (45 min)</strong>
            <ul>
              <li>Long-term planning</li>
              <li>Technical strategy</li>
              <li>Business alignment</li>
            </ul>
          </li>
        </ul>

        <h2>Key Assessment Areas</h2>
        <ul>
          <li>Technical excellence</li>
          <li>Systems thinking</li>
          <li>Organizational influence</li>
          <li>Strategic vision</li>
          <li>Mentorship ability</li>
        </ul>

        <h2>Expected Outcomes</h2>
        <p>Successful candidates should demonstrate:</p>
        <ul>
          <li>Deep technical expertise</li>
          <li>Strong systems thinking</li>
          <li>Organizational influence</li>
          <li>Strategic planning</li>
          <li>Technical leadership</li>
        </ul>
      </div>
    </article>
  </main>
</Layout>
