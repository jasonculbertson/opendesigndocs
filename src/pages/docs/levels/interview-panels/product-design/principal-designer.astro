---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Principal Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Design', href: '/docs/levels/interview-panels/product-design' }
];

---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1>Principal Designer Interview Panel</h1>
        
        <h2>Panel Overview</h2>
        <p>The Principal Designer interview panel evaluates candidates for the highest level of individual contributor roles. The focus is on assessing industry-leading expertise, organizational transformation capabilities, and strategic vision.</p>

        <h2>Interview Structure</h2>
        <ul>
          <li><strong>Vision & Strategy (60 min)</strong>
            <ul>
              <li>Industry vision</li>
              <li>Strategic leadership</li>
              <li>Organizational impact</li>
            </ul>
          </li>
          <li><strong>Technical Excellence (60 min)</strong>
            <ul>
              <li>Advanced systems architecture</li>
              <li>Innovation leadership</li>
              <li>Technical direction</li>
            </ul>
          </li>
          <li><strong>Organizational Leadership (45 min)</strong>
            <ul>
              <li>Cross-org influence</li>
              <li>Change management</li>
              <li>Mentorship at scale</li>
            </ul>
          </li>
          <li><strong>Executive Discussion (45 min)</strong>
            <ul>
              <li>Business strategy</li>
              <li>Industry perspective</li>
              <li>Organizational vision</li>
            </ul>
          </li>
        </ul>

        <h2>Key Assessment Areas</h2>
        <ul>
          <li>Strategic vision</li>
          <li>Technical leadership</li>
          <li>Organizational influence</li>
          <li>Industry expertise</li>
          <li>Change management</li>
        </ul>

        <h2>Expected Outcomes</h2>
        <p>Successful candidates should demonstrate:</p>
        <ul>
          <li>Industry-leading expertise</li>
          <li>Strategic thinking</li>
          <li>Organizational leadership</li>
          <li>Technical excellence</li>
          <li>Change management skills</li>
        </ul>
      </div>
    </article>
  </main>
</Layout>
