---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Sr. Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Product Design', href: '/docs/levels/interview-panels/product-design' }
];

---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1>Sr. Designer Interview Panel</h1>
        
        <h2>Panel Overview</h2>
        <p>The Senior Designer interview panel evaluates candidates for senior product design roles. The focus is on assessing advanced design skills, strategic thinking, and leadership potential.</p>

        <h2>Interview Structure</h2>
        <ul>
          <li><strong>Portfolio Review (60 min)</strong>
            <ul>
              <li>In-depth analysis of complex projects</li>
              <li>Focus on strategic impact and outcomes</li>
              <li>Discussion of design system contributions</li>
            </ul>
          </li>
          <li><strong>Design Exercise (60 min)</strong>
            <ul>
              <li>Complex design challenge</li>
              <li>Systems thinking evaluation</li>
              <li>Cross-functional considerations</li>
            </ul>
          </li>
          <li><strong>Leadership & Strategy (45 min)</strong>
            <ul>
              <li>Team leadership scenarios</li>
              <li>Strategic thinking assessment</li>
              <li>Mentorship approach</li>
            </ul>
          </li>
          <li><strong>Cross-functional Partnership (45 min)</strong>
            <ul>
              <li>Collaboration with PM and Engineering</li>
              <li>Technical understanding</li>
              <li>Project leadership</li>
            </ul>
          </li>
        </ul>

        <h2>Key Assessment Areas</h2>
        <ul>
          <li>Advanced design expertise</li>
          <li>Strategic thinking</li>
          <li>Leadership capabilities</li>
          <li>Mentorship skills</li>
          <li>Cross-functional collaboration</li>
        </ul>

        <h2>Expected Outcomes</h2>
        <p>Successful candidates should demonstrate:</p>
        <ul>
          <li>Strong strategic design thinking</li>
          <li>Ability to lead complex projects</li>
          <li>Effective mentorship capabilities</li>
          <li>Deep understanding of design systems</li>
          <li>Cross-functional leadership</li>
        </ul>
      </div>
    </article>
  </main>
</Layout>
