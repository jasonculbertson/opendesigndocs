---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Staff Researcher";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'UX Researcher', href: '/docs/levels/interview-panels/ux-researcher' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">UX Researcher 4 (L4)</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio / Project Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Thinking, Communication Style, Research Vision</p>
          <ul class="list-disc pl-6">
            <li>What's a product decision that was directly shaped by your research — and how did it happen?</li>
            <li>How do you bring cross-functional partners along when defining ambiguous research problems?</li>
            <li>What kind of influence do you try to have beyond the immediate project?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Research Leadership, Roadmap Framing, Autonomy</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you led a multi-phase or cross-functional research initiative.</li>
            <li>How do you help teams frame the right problems and questions upstream?</li>
            <li>How do you balance fast product timelines with strategic research depth?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio / Project Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Systems Thinking, Strategic Framing, Team Alignment</p>
          <ul class="list-disc pl-6">
            <li>The candidate should walk through two research case studies, each with complex product and stakeholder dynamics.</li>
            <li>They should focus on how they scoped the work, influenced strategy or planning, dealt with ambiguity, and ensured findings translated into outcomes.</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Round 2: PM</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Partnership, Planning, Influence</p>
            <ul class="list-disc pl-6">
              <li>Walk me through how you co-create research questions and plans with PMs.</li>
              <li>Tell me about a time your research changed the prioritization of a roadmap.</li>
              <li>How do you build trust with PMs when your insights challenge assumptions?</li>
              <li>How do you help PMs advocate for user needs in company-wide planning?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Round 2: Designer</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Collaboration, Content Patterns, UX Systems</p>
            <ul class="list-disc pl-6">
              <li>How do you support designers in testing or evolving a design system or pattern?</li>
              <li>Share an example where your insights elevated the design vision.</li>
              <li>What role do you play in design critiques or reviews at this level?</li>
              <li>How do you bring research into conversations about design quality and standards?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Round 2: Engineer</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Functional Collaboration, Systems Awareness, Product Thinking</p>
            <ul class="list-disc pl-6">
              <li>How do you collaborate with engineering on early technical discovery or feasibility?</li>
              <li>Tell me about a time your findings led to a shift in technical implementation.</li>
              <li>How do you translate qualitative data into insights that engineers can use?</li>
              <li>How do you advocate for users when tech and product goals are in tension?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Mentorship, Research Craft, Leadership Signals</p>
          <ul class="list-disc pl-6">
            <li>How do you help others grow in their research practice?</li>
            <li>Tell me about a time you shaped research culture or quality across a team.</li>
            <li>What are your values as a research leader — and how do you show them day to day?</li>
            <li>What are you most proud of contributing outside of any single project?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
