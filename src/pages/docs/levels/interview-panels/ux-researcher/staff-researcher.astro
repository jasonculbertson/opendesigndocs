---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Staff Researcher Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'UX Researcher', href: '/docs/levels/interview-panels/ux-researcher' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Staff Researcher</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Research</td><td>[Research Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Communication, Technical Expertise, Growth Mindset</p>
          <ul class="list-disc pl-6">
            <li>What drew you to UX research at this level, and what excites you about this opportunity?</li>
            <li>Tell me about a research area where you've developed deep expertise.</li>
            <li>How do you approach sharing your knowledge and expertise across an organization?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Technical Depth, Cross-functional Impact, Strategic Thinking</p>
          <ul class="list-disc pl-6">
            <li>How do you approach solving complex research problems that span multiple product areas?</li>
            <li>Tell me about how you've influenced research practices or methodologies in your organization.</li>
            <li>How do you balance depth of expertise with the need to have broad organizational impact?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Research Innovation, Strategic Impact, Technical Excellence</p>
          <p>The candidate should walk the interviewers through <strong>two case studies they are proud of</strong>. The presentation should focus on how they tackled complex research challenges, developed innovative approaches, and created significant organizational impact. The case studies should be relevant to the type of work they would do in this role.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Partnership, Business Impact, Cross-functional Influence</p>
            <ul class="list-disc pl-6">
              <li>How do you approach influencing product strategy through research?</li>
              <li>Tell me about a time you helped solve a complex business problem through research.</li>
              <li>How do you help product teams make decisions when research findings are ambiguous?</li>
              <li>Describe how you've helped elevate the role of research in product development.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Systems, Research Innovation, Collaborative Leadership</p>
            <ul class="list-disc pl-6">
              <li>How have you helped integrate research into design systems or design processes?</li>
              <li>Tell me about a time you developed a novel research approach to solve a design challenge.</li>
              <li>How do you help design teams develop their research capabilities?</li>
              <li>Describe how you balance being a thought partner versus a service provider to design teams.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Research Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Research Innovation, Methodological Excellence, Technical Leadership</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a research methodology or approach you've developed or significantly improved.</li>
              <li>How do you evaluate emerging research methods and determine their applicability?</li>
              <li>Describe how you've helped raise the bar for research quality across an organization.</li>
              <li>How do you approach solving research problems that don't have clear precedents?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Organizational Impact, Vision, Leadership</p>
          <ul class="list-disc pl-6">
            <li>How do you approach creating lasting change in how an organization uses research?</li>
            <li>Tell me about a time you had to navigate complex organizational dynamics to drive impact.</li>
            <li>What's your vision for how research can evolve to better serve product development?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
