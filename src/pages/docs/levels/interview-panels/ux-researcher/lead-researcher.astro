---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Researcher Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'UX Researcher', href: '/docs/levels/interview-panels/ux-researcher' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Researcher</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Research</td><td>[Research Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Communication, Leadership, Growth Mindset</p>
          <ul class="list-disc pl-6">
            <li>What drew you to UX research leadership, and what excites you about this opportunity?</li>
            <li>Tell me about a time you helped grow someone on your team.</li>
            <li>How do you approach balancing hands-on research work with leadership responsibilities?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Research Leadership, Team Development, Strategic Thinking</p>
          <ul class="list-disc pl-6">
            <li>How do you approach developing a research roadmap aligned with business objectives?</li>
            <li>Tell me about how you've built or improved research processes on your team.</li>
            <li>How do you ensure your team's research has meaningful impact on product decisions?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Research Leadership, Strategic Impact, Team Development</p>
          <p>The candidate should walk the interviewers through <strong>two case studies they are proud of</strong>. The presentation should focus on how they led research initiatives, developed team capabilities, and created strategic impact. The case studies should be relevant to the type of work they would do in this role.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-functional Leadership, Strategic Partnership, Business Impact</p>
            <ul class="list-disc pl-6">
              <li>How do you align research priorities with product and business goals?</li>
              <li>Tell me about a time you had to advocate for research resources or priorities.</li>
              <li>How do you help your team translate research insights into product strategy?</li>
              <li>Describe how you measure the impact of research on product outcomes.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Partnership, Research Integration, Collaborative Leadership</p>
            <ul class="list-disc pl-6">
              <li>How do you foster collaboration between research and design teams?</li>
              <li>Tell me about a time when research and design perspectives were in conflict and how you resolved it.</li>
              <li>How do you ensure research insights are effectively integrated into the design process?</li>
              <li>What approaches have you found successful for building design-research partnerships?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Research Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Research Leadership, Team Development, Methodological Excellence</p>
            <ul class="list-disc pl-6">
              <li>How do you approach building and developing a high-performing research team?</li>
              <li>Tell me about how you've mentored researchers and helped them grow their careers.</li>
              <li>How do you balance research quality and rigor with the need for speed and agility?</li>
              <li>Describe your approach to research operations and scaling research impact.</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Philosophy, Organizational Impact, Vision</p>
          <ul class="list-disc pl-6">
            <li>What's your philosophy on building and leading effective research teams?</li>
            <li>How do you approach creating a research culture that influences the broader organization?</li>
            <li>Tell me about a time you had to navigate organizational change or uncertainty.</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
