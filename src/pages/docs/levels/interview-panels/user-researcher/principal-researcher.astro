---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Principal User Researcher";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'User Researcher', href: '/docs/levels/interview-panels/user-researcher' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Principal User Researcher</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio / Project Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Executive Influence, Strategic Scope</p>
          <ul class="list-disc pl-6">
            <li>What kinds of problems or impact are you most excited to drive at the Principal level?</li>
            <li>Tell me about a time your research shaped company-level thinking or planning.</li>
            <li>How do you measure your influence when you're not directly attached to a single team?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Organizational Strategy, Design Partnership, Change Leadership</p>
          <ul class="list-disc pl-6">
            <li>Describe how you've shaped strategy across multiple domains or lines of business.</li>
            <li>How do you identify the highest-leverage places to invest research within a large org?</li>
            <li>Tell me about a time you had to guide or influence senior leadership through resistance or misalignment.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio / Project Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Company-Wide Strategy, Legacy Work, Systems Thinking</p>
          <ul class="list-disc pl-6">
            <li>The candidate should present two major initiatives where they operated across teams or orgs.</li>
            <li>They should explain how their research framed or redefined direction at scale, how they partnered with senior leadership, and what durable systems or structures they helped put in place.</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Business Vision, Planning Influence, Product Framing</p>
            <ul class="list-disc pl-6">
              <li>Walk me through how you shaped product strategy with a VP or CPO-level leader.</li>
              <li>How do you align research and product around ambiguous long-term bets?</li>
              <li>How do you maintain research rigor when guiding leadership through complex trade-offs?</li>
              <li>Tell me about a time you reframed the company's understanding of a user or market segment.</li>
            </ul>
          </section>
          
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Systems, Vision Crafting, Culture Setting</p>
            <ul class="list-disc pl-6">
              <li>How have you contributed to shaping the UX strategy or vision for a full platform or ecosystem?</li>
              <li>How do you guide design leadership through uncertainty or shifting narratives?</li>
              <li>What role do you play in defining design principles or patterns across teams?</li>
              <li>How do you elevate the strategic impact of content, interaction, or design decisions through research?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Infrastructure Awareness, Research at Scale, Technical Influence</p>
            <ul class="list-disc pl-6">
              <li>How have you influenced technical planning or platform investments through research?</li>
              <li>What's your approach to integrating research with engineering roadmaps?</li>
              <li>Tell me about a time you worked with engineering leadership to define scalable systems for user insight.</li>
              <li>How do you bring engineering into discovery or vision work?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Presence, Org Evolution, Coaching</p>
          <ul class="list-disc pl-6">
            <li>What does Principal-level IC leadership mean to you — and how do you embody it?</li>
            <li>Tell me about a time you helped shape a research team's long-term strategy or charter.</li>
            <li>How do you mentor Staff or Senior researchers to operate more strategically?</li>
            <li>What kind of impact do you want to have on the org's culture, people, and product?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
