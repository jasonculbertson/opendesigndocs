---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Staff User Researcher";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'User Researcher', href: '/docs/levels/interview-panels/user-researcher' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Staff User Researcher</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio / Project Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Influence, Systems Leadership, Organizational Impact</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time your research shaped long-term product or org-level strategy.</li>
            <li>What makes you successful at leading without authority?</li>
            <li>How do you define your impact beyond individual projects?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Cross-Team Leadership, Research Ops, Strategic Insight</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you led research across multiple teams or initiatives.</li>
            <li>How do you prioritize and manage multiple research requests at scale?</li>
            <li>How do you ensure research maintains quality and strategic alignment in fast-paced environments?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio / Project Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Systems Design, Multi-Squad Influence, Long-Term Thinking</p>
          <ul class="list-disc pl-6">
            <li>The candidate should present two projects where they demonstrated cross-team leadership, strategy influence, and scalable research solutions.</li>
            <li>They should speak to how they navigated ambiguity, partnered with leadership, and set long-term direction or built reusable systems.</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Vision Shaping, Planning Partnership, Impact</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you helped shape product vision through research.</li>
              <li>How do you balance long-term user value with short-term product delivery goals?</li>
              <li>How do you advocate for research when it challenges business priorities?</li>
              <li>How do you support PMs in developing their own user empathy and insight fluency?</li>
            </ul>
          </section>
          
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: UX Vision, Collaboration Systems, Craft Leadership</p>
            <ul class="list-disc pl-6">
              <li>What role do you play in co-creating or evolving the UX vision across product lines?</li>
              <li>How do you scale insights and findings to benefit multiple design teams?</li>
              <li>How do you mentor or level up senior designers around user understanding?</li>
              <li>Describe a time you helped shape the research culture within a design org.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Long-Term Collaboration, Feasibility Framing, Insight Integration</p>
            <ul class="list-disc pl-6">
              <li>How do you build strong relationships with engineering leadership over time?</li>
              <li>Share a time your research contributed to a technical architecture or migration plan.</li>
              <li>How do you make sure your research outcomes are integrated into backlogs or sprint planning?</li>
              <li>How do you influence engineering priorities without overstepping?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Presence, Culture Contribution, Mentorship</p>
          <ul class="list-disc pl-6">
            <li>What does Staff-level leadership look like to you in a research org?</li>
            <li>How do you coach other senior ICs or raise the bar across a team?</li>
            <li>What rituals, systems, or norms have you helped introduce or evolve?</li>
            <li>What kind of research legacy are you trying to leave behind?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
