---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "User Researcher I";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'User Researcher', href: '/docs/levels/interview-panels/user-researcher' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">User Researcher I</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Recruiter Screen</td>
                <td>[Recruiter Name]</td>
                <td>30 min</td>
              </tr>
              <tr>
                <td>Hiring Manager Screen</td>
                <td>[Hiring Manager Name]</td>
                <td>45 min</td>
              </tr>
              <tr>
                <td>Portfolio / Project Review</td>
                <td>All Hiring Team</td>
                <td>60 min</td>
              </tr>
              <tr>
                <td>Round 2: PM</td>
                <td>[PM Interviewer]</td>
                <td>45 min</td>
              </tr>
              <tr>
                <td>Round 2: Designer</td>
                <td>[Designer Interviewer]</td>
                <td>45 min</td>
              </tr>
              <tr>
                <td>Round 2: Engineer</td>
                <td>[Engineering Interviewer]</td>
                <td>45 min</td>
              </tr>
              <tr>
                <td>Final/Culture Round</td>
                <td>Executive or Culture Team Member</td>
                <td>30 min</td>
              </tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Curiosity, Learning Mindset, Communication</p>
          <ul class="list-disc pl-6">
            <li>What part of UX research are you most excited to learn or improve?</li>
            <li>Tell me about a time you had to quickly learn something unfamiliar.</li>
            <li>How do you ask questions when you don't fully understand a product or process?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Foundations, Collaboration, Judgment</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you ran or supported a user study — what was your role, and what did you learn?</li>
            <li>How do you decide what methods to use when you're new to the space or problem?</li>
            <li>What would you do if a teammate challenged your research plan or conclusions?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio / Project Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Method Familiarity, Clarity of Thought, Impact Awareness</p>
          <ul class="list-disc pl-6">
            <li>The candidate should walk through two research projects, even if they're from academic settings, internships, or personal work.</li>
            <li>They should explain their goals, process, and what changed as a result. Focus on how they collaborated, how they handled data, and how clearly they can explain their reasoning.</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>

        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Communication, Influence, Collaboration</p>
            <ul class="list-disc pl-6">
              <li>How do you help PMs think through what they want to learn from research?</li>
              <li>Tell me about a time you helped a team reframe a product idea or question.</li>
              <li>How do you communicate findings in a way that sticks with the team?</li>
              <li>What do you do when you don't feel confident about a recommendation?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Collaboration, Insight Translation, UX Understanding</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you worked closely with a designer — what was your role and impact?</li>
              <li>How do you make sure your findings are actionable for design?</li>
              <li>How do you approach user flows or prototypes during a study?</li>
              <li>What do you do when a designer wants to move fast and skip research?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Technical Empathy, Systems Thinking, Flexibility</p>
            <ul class="list-disc pl-6">
              <li>How do you help engineers understand user problems they're solving for?</li>
              <li>Tell me about a time engineering constraints impacted what you could study — how did you adapt?</li>
              <li>How do you make sure insights are accessible to technical teammates?</li>
              <li>What's your approach to collaborating with engineers when writing a research plan?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Team Fit, Curiosity, Growth Potential</p>
          <ul class="list-disc pl-6">
            <li>What kind of research team or environment helps you thrive?</li>
            <li>Tell me about a time you weren't sure what to do — how did you figure it out?</li>
            <li>What excites you about building a research practice from the ground up?</li>
            <li>Where do you want to grow over the next year?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
