---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Principal Content Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Content Designer', href: '/docs/levels/interview-panels/content-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Principal Content Designer</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Organizational Influence, Content Systems</p>
          <ul class="list-disc pl-6">
            <li>Describe a content initiative you led that shaped or transformed how multiple teams worked.</li>
            <li>How do you approach defining the scope of your influence at the Principal level?</li>
            <li>In what ways do you measure your success in this role?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Enterprise-Level Strategy, Executive Collaboration, Change Leadership</p>
          <ul class="list-disc pl-6">
            <li>Describe a time you influenced executive stakeholders through a language or content initiative.</li>
            <li>How do you identify and prioritize systemic issues in product language or user understanding?</li>
            <li>What's your approach to driving organizational change through content design?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Multi-Team Impact, Long-Term Thinking, Systemic Language Design</p>
          <p>The candidate should present <strong>two case studies demonstrating how they led initiatives that spanned multiple teams, business units, or platforms</strong>. These projects should reflect impact on user understanding, internal alignment, or long-term infrastructure for content at scale. The candidate should articulate strategic framing, execution across disciplines, and ongoing evolution of the work.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Business Alignment, Organizational Influence, Product Direction</p>
            <ul class="list-disc pl-6">
              <li>Describe a time when you helped reframe a company initiative using product language.</li>
              <li>How do you integrate language and narrative strategy into product vision or roadmap planning?</li>
              <li>How do you manage relationships with executive product or marketing leaders?</li>
              <li>Provide an example where you resolved competing business goals through content framing.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Systems Leadership, Pattern Stewardship, Cross-Functional Mentorship</p>
            <ul class="list-disc pl-6">
              <li>What role have you played in defining or evolving a content design system at scale?</li>
              <li>How do you guide cross-functional teams in using shared language effectively?</li>
              <li>Describe how you've helped establish shared standards across disciplines.</li>
              <li>How do you assess and raise the quality of content design across the org?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Infrastructure Integration, Technical Strategy, Scalability</p>
            <ul class="list-disc pl-6">
              <li>Describe your role in building infrastructure for scalable content delivery (e.g., CMS, tokens, APIs).</li>
              <li>How do you collaborate with engineering leadership to align content systems with architecture?</li>
              <li>How do you balance real-time content needs with the long-term tech stack constraints?</li>
              <li>Provide an example of resolving system limitations that impacted global content or localization.</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Executive Presence, Cross-Team Leadership, Thought Partnership</p>
          <ul class="list-disc pl-6">
            <li>What does Principal-level leadership mean to you in a content design org?</li>
            <li>Describe a time you influenced cultural change through how teams approach communication or language.</li>
            <li>How do you mentor and support Staff-level peers?</li>
            <li>What are you focused on growing or evolving at this stage in your career?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Principal Content Designer Interview Panel" />
    </article>
  </main>
</Layout>
