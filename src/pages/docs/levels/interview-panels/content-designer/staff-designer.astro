---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Staff Content Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Content Designer', href: '/docs/levels/interview-panels/content-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Staff Content Designer</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Systems Leadership, Strategic Impact, Influence</p>
          <ul class="list-disc pl-6">
            <li>What's a content system or cross-team initiative you've led, and what changed because of it?</li>
            <li>How do you build alignment across multiple product teams or partners?</li>
            <li>What kind of influence do you aim to have at this level?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Design Strategy, Content Systems, Leadership Without Authority</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you led a high-impact initiative without direct ownership.</li>
            <li>How do you prioritize and scale your impact across teams or surfaces?</li>
            <li>When have you had to navigate senior-level disagreement around product language or strategy?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Systems Thinking, Multi-Team Strategy, Language Leadership</p>
          <p>The candidate should present <strong>two case studies where they drove content direction or language systems across products or teams</strong>. They should demonstrate strategic framing, partnering across disciplines, and long-term thinking — not just launch results.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Influence, Roadmap Integration, Business Impact</p>
            <ul class="list-disc pl-6">
              <li>How do you shape product direction or roadmap planning through content?</li>
              <li>Tell me about a time you helped reframe an entire product initiative using language.</li>
              <li>What's your process for identifying risk or misalignment early in a product cycle?</li>
              <li>How do you measure the business value of content at this level?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Quality Bar, Systems Evolution, Peer Mentorship</p>
            <ul class="list-disc pl-6">
              <li>How do you help raise the craft of content across an organization?</li>
              <li>Describe a time you coached or mentored other designers on content.</li>
              <li>What principles or frameworks guide your work on design systems or reusable patterns?</li>
              <li>How do you partner with design leadership to shape design language or philosophy?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Architecture-Aware Design, Cross-Functional Strategy, Long-Term Vision</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you worked with engineering leadership to build or influence infrastructure supporting content.</li>
              <li>How do you ensure your content strategy remains sustainable across tech stack changes?</li>
              <li>What's your role in shaping reusable content components, tokens, or CMS logic?</li>
              <li>How do you advocate for content integrity in cross-platform builds?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Design Org Impact, Strategic Presence, Mentorship</p>
          <ul class="list-disc pl-6">
            <li>How do you mentor other senior ICs or staff-level peers?</li>
            <li>What are your personal principles for leading through influence?</li>
            <li>Tell me about a time you helped shape org culture or design rituals.</li>
            <li>Where do you still want to grow as a Staff-level contributor?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Staff Content Designer Interview Panel" />
    </article>
  </main>
</Layout>
