---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Sr. Content Designer Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Content Designer', href: '/docs/levels/interview-panels/content-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Sr. Content Designer</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Ownership, Clarity, Growth Trajectory</p>
          <ul class="list-disc pl-6">
            <li>How do you know when content is working — and how do you improve it when it's not?</li>
            <li>Tell me about a time you took initiative to learn something new.</li>
            <li>How do you handle feedback that conflicts with your content direction?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Autonomy, Strategy Awareness, Collaboration</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you led content strategy on a feature or product area.</li>
            <li>How do you navigate feedback from multiple stakeholders with competing priorities?</li>
            <li>How do you decide when to push back vs. go with the flow?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: End-to-End Ownership, User-Centered Framing, Measurable Impact</p>
          <p>The candidate should present <strong>two projects where they were the primary content owner</strong>. They should share their process, how they worked with product/design, what trade-offs they made, and what the impact was — even if qualitative.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Alignment, Influence, Content Framing</p>
            <ul class="list-disc pl-6">
              <li>How do you advocate for content in planning conversations?</li>
              <li>Tell me about a time you used content to shift how a team understood the problem.</li>
              <li>How do you define "success" when writing for a new feature or flow?</li>
              <li>What's your approach when you inherit unclear or inconsistent copy?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Systems Thinking, UX Patterns, Design Partnership</p>
            <ul class="list-disc pl-6">
              <li>How do you contribute to pattern libraries or content guidelines?</li>
              <li>Tell me about a time you helped improve a user journey beyond just words.</li>
              <li>How do you manage consistency across multiple screens or surfaces?</li>
              <li>What's your role in critiques — and what kind of feedback do you give?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Scale, Technical Awareness, Cross-Surface Writing</p>
            <ul class="list-disc pl-6">
              <li>How do you write for components or flows that show up across different parts of the product?</li>
              <li>What's your approach to content in APIs, tokens, or naming systems?</li>
              <li>Tell me about a time engineering constraints forced you to rethink your content.</li>
              <li>How do you stay aligned with engineering during fast-paced builds?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Team Contribution, Initiative, Self-Awareness</p>
          <ul class="list-disc pl-6">
            <li>What kind of content culture do you try to build or support on your team?</li>
            <li>How do you give and receive feedback across functions?</li>
            <li>What kind of legacy or impact are you trying to have through your work?</li>
            <li>What does great IC leadership look like to you at this stage?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
