---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Content Designer I Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Content Designer', href: '/docs/levels/interview-panels/content-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Content Designer I</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Curiosity, Growth Mindset, Communication</p>
          <ul class="list-disc pl-6">
            <li>What part of writing or communication are you most curious to grow in professionally?</li>
            <li>Tell me about a time you were new to something. How did you go about learning it?</li>
            <li>How do you usually approach feedback on your writing?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Collaboration, Writing Foundations, Problem Solving</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a time you helped clarify something confusing for others.</li>
            <li>What do you do when you're not sure how to write about something new?</li>
            <li>How do you approach working with someone who thinks differently than you?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Writing Clarity, Structure, Intent</p>
          <p>The candidate should walk through <strong>two writing or UX content projects they're proud of</strong>, even if school-based or self-initiated. They should explain the audience, the goals, how they approached structure or tone, and what they learned from the process.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Communication, Context Awareness, Collaboration</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure your writing supports product or user goals?</li>
              <li>Tell me about a time you asked questions to better understand what you were writing about.</li>
              <li>How do you collaborate with non-writers like PMs or engineers?</li>
              <li>What role do you think content plays in product development?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: UX Thinking, Craft, Feedback</p>
            <ul class="list-disc pl-6">
              <li>How do you and visual designers work together to make a flow or screen feel clear?</li>
              <li>How do you give feedback on visual designs when you're not the expert?</li>
              <li>Tell me about a time you and a designer disagreed — how did you move forward?</li>
              <li>How do you use writing to make designs more usable?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Simplicity, Systems Thinking, Flexibility</p>
            <ul class="list-disc pl-6">
              <li>What do you do when your writing doesn't fit in the interface the way you planned?</li>
              <li>How do you handle last-minute changes that impact your content?</li>
              <li>Tell me how you might simplify something technical for a new user.</li>
              <li>Have you ever written for an empty state, error, or system message?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Learning Mindset, Communication Style, Team Fit</p>
          <ul class="list-disc pl-6">
            <li>What's something you've learned recently that changed how you write?</li>
            <li>How do you like to receive and give feedback on your work?</li>
            <li>What kind of environment helps you do your best writing?</li>
            <li>What's your favorite example of clear writing in everyday life?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Content Designer I Interview Panel" />
    </article>
  </main>
</Layout>