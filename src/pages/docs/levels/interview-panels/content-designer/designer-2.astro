---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Content Designer II Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Content Designer', href: '/docs/levels/interview-panels/content-designer' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Content Designer II</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineering</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Growth Potential, Ownership, Communication</p>
          <ul class="list-disc pl-6">
            <li>What's one part of content design or UX writing you've grown stronger in recently — and how did that happen?</li>
            <li>Tell me about a time you took initiative to learn something new.</li>
            <li>How do you handle feedback that challenges your original approach?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: UX Writing Process, Collaboration, Autonomy</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a project you helped shape from early idea to final content.</li>
            <li>How do you get alignment with stakeholders when there are multiple opinions on tone or messaging?</li>
            <li>What's your process when writing for a new or unfamiliar product area?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Structure, User Focus, Outcomes</p>
          <p>The candidate should present <strong>two end-to-end content projects</strong> (ideally live work or realistic prototypes). They should walk through the problem, the user and product goals, content decisions they made, and how they collaborated across disciplines.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Product Understanding, Content Strategy Basics, Influence</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you shaped messaging to support a specific user or product goal.</li>
              <li>How do you define success for the words you write?</li>
              <li>What do you do when a PM and designer disagree on your content approach?</li>
              <li>How do you bring product partners into your thinking early?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: UX Collaboration, Content Patterns, Clarity</p>
            <ul class="list-disc pl-6">
              <li>Walk me through how you collaborate with a designer on a complex flow.</li>
              <li>How do you make decisions about tone, hierarchy, or consistency across a UI?</li>
              <li>What's a pattern you reused or created to keep the experience consistent?</li>
              <li>How do you help a team make tough trade-offs between clarity and space?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Feasibility, Flexibility, Systems Awareness</p>
            <ul class="list-disc pl-6">
              <li>How do you work with engineers to make sure your content fits and works?</li>
              <li>Tell me about a time you had to revise your content late in the development process.</li>
              <li>How do you write for components or content that's reused in multiple places?</li>
              <li>How do you ensure your content is technically feasible without losing clarity?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Collaboration, Empathy, Communication Style</p>
          <ul class="list-disc pl-6">
            <li>What's your approach to working with stakeholders who aren't familiar with content design?</li>
            <li>How do you advocate for users while staying flexible to business needs?</li>
            <li>What are you looking for in a content design team or community?</li>
            <li>Tell me about a time your values showed up in your work.</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
