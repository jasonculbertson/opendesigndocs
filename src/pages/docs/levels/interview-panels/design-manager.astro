---
import { getEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';

const title = "Design Manager Interview Panels";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' }
];

const managerLevels = [
  { 
    title: "Design Manager",
    description: "Interview panel for design managers",
    href: "/docs/levels/interview-panels/design-manager/manager",
    image: "👥"
  },
  { 
    title: "Sr. Design Manager",
    description: "Interview panel for senior design managers",
    href: "/docs/levels/interview-panels/design-manager/senior-manager",
    image: "🚀"
  },
  { 
    title: "Director of Design",
    description: "Interview panel for design directors",
    href: "/docs/levels/interview-panels/design-manager/director",
    image: "⭐"
  },
  { 
    title: "Sr. Director of Design",
    description: "Interview panel for senior design directors",
    href: "/docs/levels/interview-panels/design-manager/senior-director",
    image: "🌟"
  },
  { 
    title: "VP of Design",
    description: "Interview panel for design vice presidents",
    href: "/docs/levels/interview-panels/design-manager/vp",
    image: "👑"
  },
  { 
    title: "Head of Design",
    description: "Interview panel for heads of design",
    href: "/docs/levels/interview-panels/design-manager/head",
    image: "🎯"
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {managerLevels.map(level => (
          <Card
            title={level.title}
            description={level.description}
            href={level.href}
            image={level.image}
          />
        ))}
      </div>
    </article>
  </main>
</Layout>
