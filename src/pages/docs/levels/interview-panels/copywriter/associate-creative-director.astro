---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Associate Creative Director Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Associate Creative Director</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Executive Leadership, Storytelling Vision, Organizational Impact</p>
          <ul class="list-disc pl-6">
            <li>What kinds of storytelling systems or teams have you built at scale?</li>
            <li>How do you think about narrative as a tool for company differentiation?</li>
            <li>What are you most proud of shaping as a creative leader?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Narrative Architecture, Team Leadership, Systems Strategy</p>
          <ul class="list-disc pl-6">
            <li>Walk me through how you've defined or evolved voice across a large, complex product or brand.</li>
            <li>How do you structure a team or process that supports both experimentation and consistency?</li>
            <li>What's your approach to growing and guiding other creative leaders?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Narrative Vision, Strategic Leadership, Enduring Systems</p>
          <p>The candidate should share 2–3 enterprise-level projects that demonstrate how they've defined voice, led cross-org messaging strategy, and elevated a brand's or company's identity. Look for legacy-level work, not just campaigns.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Company Narrative, Executive Collaboration, Strategic Framing</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with PMs, CPOs, or GMs to help shape the product's long-term narrative?</li>
              <li>Tell me about a time you helped the company rethink its language or positioning at the highest level.</li>
              <li>How do you use storytelling to align vision across disciplines or initiatives?</li>
              <li>How do you navigate business tension or pushback on creative ideas?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Disciplinary Creative Direction, Rituals, Systems Thinking</p>
            <ul class="list-disc pl-6">
              <li>How do you define a shared creative vision between design, content, and brand?</li>
              <li>Share a time you helped a design org evolve its creative culture.</li>
              <li>What role do you play in critiques, creative reviews, and leadership planning?</li>
              <li>How do you balance consistency, innovation, and accessibility?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Platform Thinking, Content Infrastructure, Scalable Language</p>
            <ul class="list-disc pl-6">
              <li>How do you work with engineering leadership to ensure language systems are scalable and reliable?</li>
              <li>Tell me about a time you helped improve infrastructure for localization, tokens, or modular copy.</li>
              <li>What role do you play in building tools or processes that enable faster, better content delivery?</li>
              <li>How do you evaluate and iterate on language in live environments?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Philosophy, Culture Building, Creative Legacy</p>
          <ul class="list-disc pl-6">
            <li>What kind of creative culture do you aim to build and protect?</li>
            <li>How do you lead during uncertain, politically sensitive, or rapidly changing moments?</li>
            <li>Tell me about a time you helped reframe a team or company's creative identity.</li>
            <li>What do you want your leadership legacy to be here?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Associate Creative Director Interview Panel" />
    </article>
  </main>
</Layout>
