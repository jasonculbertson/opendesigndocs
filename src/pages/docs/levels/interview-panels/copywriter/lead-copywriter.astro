---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Copywriter L4 Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Copywriter L4</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Readiness, Strategic Ownership, Cross-Functional Maturity</p>
          <ul class="list-disc pl-6">
            <li>What types of writing challenges are you most excited to lead at this stage of your career?</li>
            <li>Tell me about a time you helped shape the voice or tone for a brand or product.</li>
            <li>How do you lead through ambiguity?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: System Thinking, Creative Direction, Team Collaboration</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you led the content direction across multiple surfaces or teams.</li>
            <li>How do you maintain quality and voice when multiple people are contributing copy?</li>
            <li>How do you partner with product, design, or brand leads to align on messaging strategy?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Brand Leadership, Strategic Writing, Cross-Surface Systems</p>
          <p>The candidate should present 2–3 projects showing how they led narrative development, evolved voice or tone, and supported large-scale launches, rebrands, or product ecosystems. Look for system-level thinking, content architecture, and clarity of decision-making.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Narrative Strategy, Stakeholder Partnership, Cross-Org Alignment</p>
            <ul class="list-disc pl-6">
              <li>How do you shape messaging strategy during product or feature planning?</li>
              <li>What's your approach when business, user, and brand goals conflict?</li>
              <li>Share an example of aligning multiple teams (e.g. marketing, product, support) on shared language.</li>
              <li>How do you balance input from research, PM, and creative teams?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Voice Systems, Brand Cohesion, Creative Direction</p>
            <ul class="list-disc pl-6">
              <li>How do you evolve brand voice without breaking consistency or trust?</li>
              <li>Tell me about a time you helped a team elevate writing quality across a large-scale system or product.</li>
              <li>How do you collaborate with visual design and brand to build cohesive storytelling?</li>
              <li>What rituals or frameworks have you implemented to support shared creative quality?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Componentization, Implementation, Design Systems</p>
            <ul class="list-disc pl-6">
              <li>How do you work with engineers or systems teams to structure scalable content?</li>
              <li>Share a time you wrote for modular or logic-based content patterns.</li>
              <li>How do you manage voice and clarity within components, templates, or string-based content?</li>
              <li>What tools or workflows do you use to hand off complex content projects?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Mentorship, Content Philosophy, Creative Culture</p>
          <ul class="list-disc pl-6">
            <li>What's your leadership style when mentoring other writers?</li>
            <li>Tell me about a time you helped raise the creative or operational bar for content design.</li>
            <li>How do you handle moments when tone, vision, or goals are unclear?</li>
            <li>What legacy do you want to build as a Lead Copywriter?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
