---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Lead Copywriter Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Copywriter</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Writing & Strategy Presentation</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: Creative Director</td><td>[Creative Director]</td><td>45 min</td></tr>
              <tr><td>Round 2: Content Leadership</td><td>[Content Leaders]</td><td>45 min</td></tr>
              <tr><td>Round 2: Marketing/Brand Strategy</td><td>[Marketing/Brand Leaders]</td><td>45 min</td></tr>
              <tr><td>Final/Executive Round</td><td>Department Head or Executive</td><td>45 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Experience, Content Strategy, Team Management</p>
          <ul class="list-disc pl-6">
            <li>What drew you to content leadership, and what excites you about this opportunity?</li>
            <li>Tell me about your experience leading content teams and directing writing projects.</li>
            <li>How do you approach balancing creative excellence with business objectives?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Content Leadership, Project Management</p>
          <ul class="list-disc pl-6">
            <li>How do you develop and communicate content strategy for projects or campaigns?</li>
            <li>Tell me about a significant project where you led the content direction. What was your approach?</li>
            <li>How do you manage multiple content projects while maintaining quality and meeting deadlines?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Writing & Strategy Presentation</h3>
          <p class="italic text-sm mb-2">Focus Areas: Content Direction, Strategic Thinking, Leadership Vision</p>
          <p>The candidate should present their portfolio highlighting projects where they provided content leadership, along with their content strategy approach. The presentation should demonstrate their ability to develop messaging frameworks, lead content teams, and align writing with business objectives. They should showcase their strategic process, decision-making, and the measurable impact of their work across various content initiatives.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Creative Director Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Creative Vision, Content Excellence, Strategic Direction</p>
            <ul class="list-disc pl-6">
              <li>How do you develop a content direction that balances innovation with brand consistency?</li>
              <li>Tell me about a time you had to pivot a messaging strategy based on feedback or changing requirements.</li>
              <li>How do you ensure writing excellence across all deliverables in a project?</li>
              <li>What's your approach to developing and maintaining a distinctive brand voice?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Content Leadership Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Team Development, Creative Guidance, Collaboration</p>
            <ul class="list-disc pl-6">
              <li>How do you approach building and developing a high-performing content team?</li>
              <li>Tell me about your process for providing creative guidance while empowering writers.</li>
              <li>How do you foster collaboration and creativity within your team?</li>
              <li>What's your approach to handling creative disagreements within a team?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Marketing/Brand Strategy Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Brand Strategy, Marketing Integration, Business Alignment</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure content strategy aligns with and enhances brand strategy?</li>
              <li>Tell me about your experience translating marketing objectives into content plans.</li>
              <li>How do you approach developing messaging for different channels or audience segments?</li>
              <li>What's your process for measuring the effectiveness of content?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Executive Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Vision, Business Impact, Leadership</p>
          <ul class="list-disc pl-6">
            <li>What's your vision for how content leadership can drive business success?</li>
            <li>How do you approach building relationships with executive stakeholders?</li>
            <li>Tell me about a time your content leadership had a significant impact on business results.</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
