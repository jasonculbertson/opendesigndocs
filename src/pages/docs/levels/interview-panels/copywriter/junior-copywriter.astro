---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Jr. Copywriter Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Jr. Copywriter</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>Recruiter</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>Content Lead</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM Interview</td><td>Senior PM</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer Interview</td><td>Senior Designer</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer Interview</td><td>Senior Engineer</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Team Lead or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Curiosity, Communication, Growth Mindset</p>
          <ul class="list-disc pl-6">
            <li>What kind of writing excites you most — and where do you want to grow next?</li>
            <li>Tell me about a time you took feedback that changed your approach.</li>
            <li>How do you stay inspired or expand your creative vocabulary?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Copy Craft, Openness to Feedback, Creative Thinking</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a recent writing assignment — what was the goal and how did you approach it?</li>
            <li>What do you do when you're stuck or uninspired by a brief?</li>
            <li>How do you know when your writing is working?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Clarity, Tone, Conceptual Thinking</p>
          <p>The candidate should walk through 2–3 writing samples that show range across tone, medium, or goal (marketing, product, social, etc.).
Look for energy in the writing, understanding of the audience, and thoughtful copy choices — even if the work is from school or freelance.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Message Framing, Stakeholder Collaboration, Delivery</p>
            <ul class="list-disc pl-6">
              <li>How do you make sure your writing supports a business or campaign goal?</li>
              <li>What do you do when a PM or stakeholder gives unclear feedback on your work?</li>
              <li>How do you keep your writing on track across drafts or changing priorities?</li>
              <li>Tell me about a time you helped clarify or simplify a message.</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Visual Collaboration, Voice, Writing in Context</p>
            <ul class="list-disc pl-6">
              <li>How do you work with designers to balance copy and layout?</li>
              <li>Share an example of when your words helped improve the flow of a visual experience.</li>
              <li>How do you make writing feel consistent across different screens or materials?</li>
              <li>What do you do when space is tight or you're asked to cut your words in half?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Collaboration, Flexibility, Practical Awareness</p>
            <ul class="list-disc pl-6">
              <li>Have you ever worked with engineers or developers on implementation?</li>
              <li>What's your process for writing in Figma or other design tools?</li>
              <li>How do you make your copy handoff-ready?</li>
              <li>Tell me about a time tech constraints required you to change or simplify your copy.</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Team Fit, Creative Identity, Growth Trajectory</p>
          <ul class="list-disc pl-6">
            <li>What's your favorite piece of copy or brand voice — and why?</li>
            <li>How do you want to contribute to a team beyond your writing?</li>
            <li>What's something you've learned recently that's made you a better writer?</li>
            <li>Where do you hope to grow in the next year?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Jr. Copywriter Interview Panel" />
    </article>
  </main>
</Layout>
