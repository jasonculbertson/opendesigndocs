---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Senior Copywriter Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Senior Copywriter</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Thinking, Leadership Signals, Craft Confidence</p>
          <ul class="list-disc pl-6">
            <li>What's a project where your writing made a strategic difference — and how did it happen?</li>
            <li>How do you define your impact beyond just the words you write?</li>
            <li>What are you looking for in a team or creative environment?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Framing, Writing Leadership, Executional Ownership</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you led the messaging for a major feature, campaign, or rebrand.</li>
            <li>How do you balance creative tone with performance or conversion goals?</li>
            <li>How do you push work forward when others aren't clear on the direction?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Narrative Depth, Messaging Systems, Brand Fluency</p>
          <p>The candidate should share 2–3 projects that demonstrate end-to-end ownership and show range in brand storytelling, product messaging, and campaign concepting. Look for voice adaptability, structure, and an ability to simplify complex ideas.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Messaging Strategy, Insight Communication, Stakeholder Alignment</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with PMs to develop messaging frameworks or naming systems?</li>
              <li>Tell me about a time you helped shift the way a product or feature was positioned.</li>
              <li>What's your process for aligning stakeholders when there are strong opinions on language?</li>
              <li>How do you handle when research and marketing voice pull in different directions?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Brand Systems, Visual Integration, Feedback Practice</p>
            <ul class="list-disc pl-6">
              <li>How do you work with design partners to evolve or apply brand voice?</li>
              <li>Share an example of a product or campaign where writing helped unify the experience.</li>
              <li>How do you participate in or lead critiques with visual designers?</li>
              <li>What's your approach to maintaining consistency across surfaces or channels?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Executional Detail, Naming Logic, System Awareness</p>
            <ul class="list-disc pl-6">
              <li>How do you structure or hand off your writing to support engineering implementation?</li>
              <li>Tell me about a time you helped fix a content problem introduced during dev.</li>
              <li>How do you write for scalable systems (e.g. templates, token-based content, components)?</li>
              <li>What do you do when you disagree with how copy is being implemented?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Mentorship, Cultural Contribution, Long-Term Growth</p>
          <ul class="list-disc pl-6">
            <li>How do you support other writers or cross-functional teammates in their craft?</li>
            <li>What are your content principles or philosophies as a senior IC?</li>
            <li>Tell me about a time you helped shape rituals, systems, or creative culture.</li>
            <li>Where are you hoping to grow next — and what kind of support helps you get there?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Senior Copywriter Interview Panel" />
    </article>
  </main>
</Layout>
