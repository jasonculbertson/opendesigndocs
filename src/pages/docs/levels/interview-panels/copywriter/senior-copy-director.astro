---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Senior Copy Director Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Sr. Copy Director</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Narrative Leadership, Strategic Vision, Executive Readiness</p>
          <ul class="list-disc pl-6">
            <li>What kinds of storytelling or brand work are you most proud of leading?</li>
            <li>What's your approach to building trust with creative, product, and marketing partners?</li>
            <li>How do you scale your impact across teams and initiatives?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision Ownership, Systems Building, Team Development</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a large-scale initiative where you led the narrative direction.</li>
            <li>How do you approach building or evolving a voice system across multiple products or channels?</li>
            <li>What's your philosophy on mentoring senior or lead writers?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Cohesion, Influence</p>
          <p>The candidate should walk through 2–3 flagship projects showing end-to-end leadership across campaigns, product surfaces, or brand systems. Look for voice development, stakeholder alignment, and strategic storytelling across surfaces.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Functional Alignment, Messaging Strategy, Influence</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with product leadership to shape voice and narrative at the roadmap level?</li>
              <li>Tell me about a time you helped reframe a product's value or feature through language.</li>
              <li>How do you align product, brand, and user needs in your content direction?</li>
              <li>What role do you play in planning cycles or go-to-market launches?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Creative Direction, Systems Thinking, Shared Ownership</p>
            <ul class="list-disc pl-6">
              <li>How do you define or evolve a cross-disciplinary creative vision?</li>
              <li>Share a time you worked with visual design, brand, or motion to build cohesive storytelling.</li>
              <li>How do you uphold content quality while empowering others to contribute to the voice?</li>
              <li>What role do you play in critiques, rituals, and creative reviews?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Content Systems, Modularity, Voice Integrity</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you collaborated on a platform or system to ensure voice was preserved at scale.</li>
              <li>How do you ensure your narrative direction holds up across technical constraints and platform limitations?</li>
              <li>What's your approach to componentized or string-based content systems?</li>
              <li>How do you evaluate writing in production to ensure quality?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Creative Legacy, Team Influence, Vision</p>
          <ul class="list-disc pl-6">
            <li>What kind of writing culture do you build — and how?</li>
            <li>Tell me about a time you helped a team find clarity in ambiguity.</li>
            <li>What are your values as a creative leader?</li>
            <li>What's the long-term narrative or legacy you want to help build here?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Senior Copy Director Interview Panel" />
    </article>
  </main>
</Layout>
