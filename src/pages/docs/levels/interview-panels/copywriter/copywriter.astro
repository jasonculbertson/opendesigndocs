---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Copywriter Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Copywriter', href: '/docs/levels/interview-panels/copywriter' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Copywriter</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>Recruiter</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>Content Lead</td><td>45 min</td></tr>
              <tr><td>Portfolio Review</td><td>All Hiring Team</td><td>60 min</td></tr>
              <tr><td>Round 2: PM Interview</td><td>Senior PM</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer Interview</td><td>Senior Designer</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer Interview</td><td>Senior Engineer</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Team Lead or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Ownership, Communication, Strategic Curiosity</p>
          <ul class="list-disc pl-6">
            <li>What types of writing projects do you feel most confident leading?</li>
            <li>How do you balance creativity with business or product goals?</li>
            <li>Tell me about a time you advocated for a better way to write or frame something.</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Craft Depth, Adaptability, Clarity</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a project you wrote from start to finish — what made it successful?</li>
            <li>How do you decide which voice or tone is right for the moment?</li>
            <li>Tell me about a time you revised your work significantly — what changed and why?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Portfolio Review</h3>
          <p class="italic text-sm mb-2">Focus Areas: Consistency, Conceptual Strength, Brand Awareness</p>
          <p>The candidate should present 2–3 cross-medium writing samples (e.g. web, product UI, campaigns, email). We're looking for fluency in brand tone, clarity of message, creative variation, and writing that supports user or business goals.</p>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Business Insight, Messaging Strategy, Feedback Loops</p>
            <ul class="list-disc pl-6">
              <li>How do you work with PMs to shape messaging and language around features or campaigns?</li>
              <li>Share a time you helped shift how something was messaged to make it more successful.</li>
              <li>How do you handle feedback that doesn't align with your writing instincts?</li>
              <li>What do you do when a brief is vague or missing key information?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Partnership, UX Sensitivity, Brand Cohesion</p>
            <ul class="list-disc pl-6">
              <li>How do you collaborate with designers on early concepts, layout, and hierarchy?</li>
              <li>Share an example of how you've helped define or refine brand voice.</li>
              <li>What's your approach to writing within UI or highly visual experiences?</li>
              <li>How do you approach naming — features, pages, CTAs, etc.?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Detail Orientation, Technical Flexibility, Handoff Quality</p>
            <ul class="list-disc pl-6">
              <li>How do you make sure engineers have everything they need from you?</li>
              <li>Tell me about a time you had to rewrite copy due to character limits or logic constraints.</li>
              <li>What tools or systems do you use for managing content handoff or strings?</li>
              <li>How do you test or review your copy once it's live?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Creative Presence, Team Collaboration, Growth Direction</p>
          <ul class="list-disc pl-6">
            <li>How do you help build a team culture of clarity, inclusivity, and creativity?</li>
            <li>What are you working on right now to grow as a writer?</li>
            <li>What role do you like to play in critiques or brainstorms?</li>
            <li>How do you stay sharp, inspired, or informed in your craft?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Copywriter Interview Panel" />
    </article>
  </main>
</Layout>
