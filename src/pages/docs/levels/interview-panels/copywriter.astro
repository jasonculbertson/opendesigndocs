---
import { getEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/Card.astro';

const title = "Copywriter Interview Panels";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' }
];

const designerLevels = [
  { 
    title: "Junior Copywriter",
    description: "Interview panel for junior copywriters",
    href: "/docs/levels/interview-panels/copywriter/junior-copywriter",
    image: "🌱"
  },
  { 
    title: "Copywriter",
    description: "Interview panel for mid-level copywriters",
    href: "/docs/levels/interview-panels/copywriter/copywriter",
    image: "⚡"
  },
  { 
    title: "Sr. Copywriter",
    description: "Interview panel for senior copywriters",
    href: "/docs/levels/interview-panels/copywriter/senior-copywriter",
    image: "🚀"
  },
  { 
    title: "Lead Copywriter",
    description: "Interview panel for lead copywriters",
    href: "/docs/levels/interview-panels/copywriter/lead-copywriter",
    image: "👥"
  },
  { 
    title: "Associate Creative Director",
    description: "Interview panel for associate creative directors",
    href: "/docs/levels/interview-panels/copywriter/associate-creative-director",
    image: "⭐"
  },
  { 
    title: "Creative Director",
    description: "Interview panel for creative directors",
    href: "/docs/levels/interview-panels/copywriter/creative-director",
    image: "🎯"
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {designerLevels.map(level => (
          <Card
            title={level.title}
            description={level.description}
            href={level.href}
            image={level.image}
          />
        ))}
      </div>
    </article>
  </main>
</Layout>
