---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

const title = "Senior Design Ops Manager Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops Manager', href: '/docs/levels/interview-panels/design-ops-manager' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Senior Design Ops Manager</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership, Systems Thinking, Influence</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a program or system you helped scale across multiple teams.</li>
            <li>What types of challenges do you love solving in a design org?</li>
            <li>How do you balance structure and flexibility in your work?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Ops Leadership, Cross-Org Execution, Coaching</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you helped a design org evolve a key workflow, ritual, or system.</li>
            <li>How do you ensure operational efforts are aligned with org priorities and design quality?</li>
            <li>How do you support the growth and success of other Ops partners or team coordinators?</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Alignment, Planning, Strategic Collaboration</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with PMs to ensure design has what it needs to succeed?</li>
              <li>Share an example of a time you influenced planning or prioritization decisions.</li>
              <li>How do you ensure that progress, blockers, and goals are visible across disciplines?</li>
              <li>What role do you play in cross-functional rituals and cadence?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Design Advocacy, Process Stewardship, Enablement</p>
            <ul class="list-disc pl-6">
              <li>What's your approach to building systems that improve design quality or speed?</li>
              <li>Share a time you introduced a change to a design team's ways of working — how did you roll it out?</li>
              <li>How do you balance the needs of junior and senior designers in the systems you create?</li>
              <li>What role do you play in onboarding, documentation, or leveling frameworks?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Delivery, Communication, Systems Integration</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with engineering to improve collaboration and reduce delivery friction?</li>
              <li>Share a time you helped resolve misalignment between design and engineering timelines or expectations.</li>
              <li>How do you ensure your operational systems work across disciplines?</li>
              <li>What kinds of cross-functional roadmapping or coordination have you supported?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Presence, Cultural Impact, Strategic Growth</p>
          <ul class="list-disc pl-6">
            <li>What does senior-level leadership in Design Ops look like to you?</li>
            <li>How do you build psychological safety and operational clarity across a team?</li>
            <li>Tell me about a time you shaped team culture or created a lasting ritual.</li>
            <li>What are you most proud of operationally — and what are you hoping to evolve next?</li>
          </ul>
        </section>
      </div>
    </article>
  </main>
</Layout>
