---
import Layout from '../../../../../layouts/Layout.astro';
import Card from '../../../../../components/ui/Card.astro';

const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' }
];

interface Role {
  title: string;
  description: string;
  href: string;
  image: string;
}

const levels: Role[] = [
  {
    title: "Design Ops Manager I",
    description: "Interview panel for entry-level design operations",
    href: "/docs/levels/interview-panels/design-ops-manager/design-ops-1",
    image: "🌱"
  },
  {
    title: "Design Ops Manager II",
    description: "Interview panel for mid-level design operations",
    href: "/docs/levels/interview-panels/design-ops-manager/design-ops-2",
    image: "⚡"
  },
  {
    title: "Sr. Design Ops Manager",
    description: "Interview panel for senior design operations",
    href: "/docs/levels/interview-panels/design-ops-manager/senior-design-ops",
    image: "🚀"
  },
  {
    title: "Lead Design Ops Manager",
    description: "Interview panel for lead design operations",
    href: "/docs/levels/interview-panels/design-ops-manager/lead-design-ops",
    image: "👥"
  },
  {
    title: "Staff Design Ops Manager",
    description: "Interview panel for staff design operations",
    href: "/docs/levels/interview-panels/design-ops-manager/staff-design-ops",
    image: "⭐"
  },
  {
    title: "Principal Design Ops Manager",
    description: "Interview panel for principal design operations",
    href: "/docs/levels/interview-panels/design-ops-manager/principal-design-ops",
    image: "🎯"
  }
];

const title = "Design Ops";
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>

      <div class="grid grid-cols-1 gap-4">
        {levels.map(level => (
          <Card {...level} />
        ))}
      </div>
    </article>
  </main>
</Layout>
