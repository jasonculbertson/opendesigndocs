---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Design Ops Manager II Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops Manager', href: '/docs/levels/interview-panels/design-ops-manager' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Design Ops Manager II</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Ownership, Collaboration, Initiative</p>
          <ul class="list-disc pl-6">
            <li>What's a recent system, tool, or process you improved — and how did you identify the need?</li>
            <li>How do you prioritize when you're supporting multiple stakeholders?</li>
            <li>What kind of role do you want to play on a design team?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Execution, Self-Direction, Partnership</p>
          <ul class="list-disc pl-6">
            <li>Tell me about a program or project you owned end-to-end.</li>
            <li>How do you build alignment with cross-functional teams around a new process or workflow?</li>
            <li>How do you balance speed with sustainability when improving team operations?</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Communication, Planning, Team Support</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure that program status, blockers, and goals are clear across teams?</li>
              <li>Share an example of a process you built or improved to help delivery or coordination.</li>
              <li>How do you support PMs in maintaining cross-functional accountability?</li>
              <li>What do you do when timelines or priorities shift mid-way through a program?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Design Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Workflow Awareness, Tooling, Empowerment</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you improved or streamlined the design team's workflow.</li>
              <li>How do you gather and act on feedback from designers about their operational pain points?</li>
              <li>What tooling or documentation systems have you helped set up or scale?</li>
              <li>How do you advocate for design needs in broader company processes?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Cross-Functional Collaboration, Planning Rigor, Clarity</p>
            <ul class="list-disc pl-6">
              <li>How do you ensure design and engineering are working in sync across sprints?</li>
              <li>Share a time when you helped improve coordination between disciplines.</li>
              <li>What role do you play in keeping timelines realistic and scoped well?</li>
              <li>How do you adapt your communication style when working with technical teams?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Team Contribution, Communication Style, Growth Mindset</p>
          <ul class="list-disc pl-6">
            <li>What rituals or ways-of-working have you helped implement that stuck?</li>
            <li>How do you support inclusion and accessibility through your operational work?</li>
            <li>What do you want to grow toward as a Design Ops partner or program manager?</li>
            <li>What's one habit or process that's helped you be effective on a fast-moving team?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Design Ops Manager II Interview Panel" />
    </article>
  </main>
</Layout>
