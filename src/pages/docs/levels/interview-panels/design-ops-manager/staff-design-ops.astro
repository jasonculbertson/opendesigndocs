---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Staff Design Ops Manager Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops Manager', href: '/docs/levels/interview-panels/design-ops-manager' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Staff Design Ops Manager</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Strategic Influence, Vision Execution, Leadership Identity</p>
          <ul class="list-disc pl-6">
            <li>What kinds of systems-level problems do you gravitate toward — and why?</li>
            <li>How do you define Staff-level leadership in Design Ops?</li>
            <li>What's an initiative you led that fundamentally changed how a design org functioned?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Multi-Org Strategy, Long-Term Thinking, Operational Innovation</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a high-stakes, cross-functional program you led from concept to adoption.</li>
            <li>How do you choose where to focus when everything feels high-impact?</li>
            <li>Tell me about a time you influenced executive decision-making without direct authority.</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Executive Alignment, Business Integration, Scaling Impact</p>
            <ul class="list-disc pl-6">
              <li>How do you bring design and product leadership into operational alignment?</li>
              <li>Tell me about a time you used operational insights to influence company- or org-level planning.</li>
              <li>How do you balance business constraints with design principles when building systems?</li>
              <li>What role do you play in ensuring delivery velocity doesn't compromise long-term product health?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Vision Crafting, Craft Infrastructure, Cultural Stewardship</p>
            <ul class="list-disc pl-6">
              <li>How do you scale systems that improve quality across a wide range of product teams?</li>
              <li>Tell me about a time you influenced design leadership strategy through operational insight.</li>
              <li>What is your philosophy for design enablement — and how have you put it into practice?</li>
              <li>How do you help designers feel connected, supported, and effective at scale?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Structural Alignment, Execution Rigor, Workflow Integration</p>
            <ul class="list-disc pl-6">
              <li>What operational systems have you built that made cross-functional collaboration more effective?</li>
              <li>Tell me about a time you helped engineering and design navigate a delivery or architectural shift.</li>
              <li>How do you ensure alignment between design intent and engineering implementation across teams?</li>
              <li>What rituals or planning frameworks have you introduced that stuck?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Mentorship, Strategic Legacy</p>
          <ul class="list-disc pl-6">
            <li>What does "leaving systems better than you found them" mean to you?</li>
            <li>How do you mentor and grow Design Ops talent across levels?</li>
            <li>Tell me about a time your operational leadership changed how a team showed up or felt.</li>
            <li>What kind of legacy do you want to leave behind in the design org?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Staff Design Ops Manager Interview Panel" />
    </article>
  </main>
</Layout>
