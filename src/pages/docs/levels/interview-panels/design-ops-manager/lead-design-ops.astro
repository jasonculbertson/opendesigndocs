---
import { getEntry } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import SocialFeatures from '../../../../../components/SocialFeatures';

const title = "Lead Design Ops Manager Interview Panel";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' },
  { text: 'Design Ops Manager', href: '/docs/levels/interview-panels/design-ops-manager' }
];
---

<style>
  .role-section h2 {
    margin: 0 0 0.75rem 0;
    font-size: 1.5rem;
    color: #111827;
  }

  .role-table {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    margin: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 0;
  }

  thead tr {
    background: #f9fafb;
    border-bottom: 1px solid #e5e7eb;
  }

  th {
    text-align: left;
    padding: 1rem 1.5rem;
    font-weight: 500;
    color: #4b5563;
    margin: 0;
  }

  td {
    padding: 0.875rem 1.5rem;
    border-top: 1px solid #f3f4f6;
  }

  tr:hover td {
    background: #f9fafb;
  }
</style>

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      
      <div class="prose max-w-none">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Lead Design Ops Manager</h1>

        <h2 class="text-xl font-semibold mt-8 mb-4">Interview Stages</h2>
        <div class="role-table mb-6">
          <table>
            <thead>
              <tr>
                <th>Stage</th>
                <th>Interviewer(s)</th>
                <th>Duration</th>
              </tr>
            </thead>
            <tbody>
              <tr><td>Recruiter Screen</td><td>[Recruiter Name]</td><td>30 min</td></tr>
              <tr><td>Hiring Manager Screen</td><td>[Hiring Manager Name]</td><td>45 min</td></tr>
              <tr><td>Round 2: PM</td><td>[PM Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Designer</td><td>[Designer Interviewer]</td><td>45 min</td></tr>
              <tr><td>Round 2: Engineer</td><td>[Engineering Interviewer]</td><td>45 min</td></tr>
              <tr><td>Final/Culture Round</td><td>Executive or Culture Team Member</td><td>30 min</td></tr>
            </tbody>
          </table>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Recruiter Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Leadership Readiness, Systems Thinking, Strategic Influence</p>
          <ul class="list-disc pl-6">
            <li>What's an example of a system or initiative you've led that transformed how a design org operates?</li>
            <li>What does "leadership without management" mean to you in an operations context?</li>
            <li>How do you define impact at a lead level?</li>
          </ul>
        </section>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Hiring Manager Screen</h3>
          <p class="italic text-sm mb-2">Focus Areas: Cross-Org Strategy, Operational Vision, Coaching</p>
          <ul class="list-disc pl-6">
            <li>Walk me through a time you shaped team operations, rituals, or systems across an entire org.</li>
            <li>How do you prioritize what work to take on when supporting multiple leaders or teams?</li>
            <li>How do you mentor or elevate others while still executing at a high level?</li>
          </ul>
        </section>

        <h3 class="text-lg font-medium text-gray-700 mt-8 mb-3">Round 2 Interviews</h3>
        <div class="pl-4 border-l-2 border-gray-200">
          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">PM Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Strategic Planning, Partnership, Execution Support</p>
            <ul class="list-disc pl-6">
              <li>How do you partner with PMs and design leaders during roadmap or planning cycles?</li>
              <li>Tell me about a time you helped clarify ownership and accountability across multiple functions.</li>
              <li>What's your role in keeping timelines on track while upholding design quality?</li>
              <li>How do you advocate for design in a cross-functional leadership context?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Designer Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Culture, Enablement, Design Quality</p>
            <ul class="list-disc pl-6">
              <li>What role do you play in improving or protecting design quality through operations?</li>
              <li>Share a time you helped reshape or rebuild a team's rituals, cadences, or practices.</li>
              <li>How do you support both junior and senior designers in doing their best work?</li>
              <li>What's your approach to improving creative velocity and team health at the same time?</li>
            </ul>
          </section>

          <section class="mb-6">
            <h3 class="text-lg font-semibold mt-6 mb-2">Engineering Interview</h3>
            <p class="italic text-sm mb-2">Focus Areas: Multi-Team Coordination, System Design, Communication</p>
            <ul class="list-disc pl-6">
              <li>Tell me about a time you helped reduce friction between design and engineering at scale.</li>
              <li>What systems or rituals have you co-created to ensure smooth cross-functional delivery?</li>
              <li>How do you balance the needs of engineers with design team processes and timelines?</li>
              <li>What operational documentation or tooling have you built that improved transparency?</li>
            </ul>
          </section>
        </div>

        <section class="mb-6">
          <h3 class="text-lg font-semibold mt-6 mb-2">Final/Culture Round</h3>
          <p class="italic text-sm mb-2">Focus Areas: Vision, Influence, Leadership Maturity</p>
          <ul class="list-disc pl-6">
            <li>What's your leadership philosophy as a Design Ops Lead?</li>
            <li>How do you shape org culture through systems, storytelling, or operational practices?</li>
            <li>Tell me about a time you made things better for others behind the scenes.</li>
            <li>What are you building toward — and how do you want to grow in the next 1–2 years?</li>
          </ul>
        </section>
      </div>
      <SocialFeatures client:load title="Lead Design Ops Manager Interview Panel" />
    </article>
  </main>
</Layout>
