---
import { getEntry } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/ui/Card.astro';

const title = "Product Design Interview Panels";
const breadcrumbs = [
  { text: 'Interview Panels', href: '/docs/levels/interview-panels' }
];

const designerLevels = [
  { 
    title: "Designer I",
    description: "Interview panel for entry-level designers",
    href: "/docs/levels/interview-panels/product-design/designer-1",
    image: "🌱"
  },
  { 
    title: "Designer II",
    description: "Interview panel for mid-level designers",
    href: "/docs/levels/interview-panels/product-design/designer-2",
    image: "⚡"
  },
  { 
    title: "Sr. Designer",
    description: "Interview panel for senior designers",
    href: "/docs/levels/interview-panels/product-design/senior-designer",
    image: "🚀"
  },
  { 
    title: "Lead Designer",
    description: "Interview panel for lead designers",
    href: "/docs/levels/interview-panels/product-design/lead-designer",
    image: "👥"
  },
  { 
    title: "Staff Designer",
    description: "Interview panel for staff designers",
    href: "/docs/levels/interview-panels/product-design/staff-designer",
    image: "⭐"
  },
  { 
    title: "Principal Designer",
    description: "Interview panel for principal designers",
    href: "/docs/levels/interview-panels/product-design/principal-designer",
    image: "🎯"
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb, index) => (
            <li class="flex items-center">
              {index > 0 && <span class="mx-2 text-gray-400">/</span>}
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {designerLevels.map(level => (
          <Card {...level} />
        ))}
      </div>
    </article>
  </main>
</Layout>
