---
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/ui/Card.astro';

const title = "Level Competencies";

// Define the breadcrumb type structure
type Breadcrumb = {
  text: string;
  href: string;
};

const breadcrumbs: Breadcrumb[] = [];

const resources = [
  {
    title: "Product Designer",
    description: "Skills and expectations for product designers at each level",
    href: "/docs/levels/level-competencies/product-designer",
    image: '🎨'
  },
  {
    title: 'Content Designer',
    description: 'Level competencies for content designers',
    href: "/docs/levels/level-competencies/content-designer",
    image: '✍️'
  },
  {
    title: 'Graphic Designer',
    description: 'Level competencies for graphic designers',
    href: '/docs/levels/level-competencies/graphic-designer',
    image: '🎨'
  },
  {
    title: 'Design Ops',
    description: 'Level competencies for design operations',
    href: '/docs/levels/level-competencies/design-ops',
    image: '⚙️'
  },
  {
    title: 'Manager',
    description: 'Level competencies for design managers',
    href: '/docs/levels/level-competencies/manager',
    image: '👥'
  },
  {
    title: 'Researcher',
    description: 'Level competencies for design researchers',
    href: '/docs/levels/level-competencies/researcher',
    image: '🔍'
  },
  {
    title: 'Copywriter',
    description: 'Level competencies for copywriters',
    href: '/docs/levels/level-competencies/copywriter',
    image: '✍️'
  }
];
const productRoles = [
  {
    title: "Product Designer",
    description: "Skills and expectations for product designers at each level",
    href: "/docs/levels/level-competencies/product-designer",
    image: "🎨"
  },
  {
    title: "Content Designer",
    description: "Skills and expectations for content designers at each level",
    href: "/docs/levels/level-competencies/content-designer",
    image: "✍️"
  },
  {
    title: "User Researcher",
    description: "Skills and expectations for researchers at each level",
    href: "/docs/levels/level-competencies/user-researcher",
    image: "🔍"
  },
  {
    title: "Design Ops",
    description: "Skills and expectations for design operations at each level",
    href: "/docs/levels/level-competencies/design-ops",
    image: "⚙️"
  }
];
const creativeRoles = [
  {
    title: "Graphic Designer",
    description: "Skills and expectations for graphic designers at each level",
    href: "/docs/levels/level-competencies/graphic-designer",
    image: "🎨"
  },
  {
    title: "Copywriter",
    description: "Skills and expectations for copywriters at each level",
    href: "/docs/levels/level-competencies/copywriter",
    image: "✍️"
  },
  {
    title: 'Photographer',
    description: 'Level competencies for photographers',
    href: '/docs/levels/level-competencies/photographer',
    image: '📸'
  }
];
const managerRoles = [
  {
    title: "Design Manager",
    description: "Skills and expectations for design managers at each level",
    href: "/docs/levels/level-competencies/manager",
    image: "👥"
  }
];
---

<Layout title={title}>
  <main class="py-8 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto px-4 sm:px-0">
      <nav class="flex mb-2" aria-label="Breadcrumb">
        <ol class="flex items-center">
          {breadcrumbs.map((crumb) => (
            <li>
              <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                {crumb.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="space-y-8">
        <section>
          <h2 class="text-[20px] font-semibold text-[#1a1f36] mb-4">Product Role Competencies</h2>
          <div class="grid grid-cols-1 gap-4">
            {productRoles.map(role => (
              <Card {...role} />
            ))}
          </div>
        </section>

        <section>
          <h2 class="text-[20px] font-semibold text-[#1a1f36] mb-4">Creative Role Competencies</h2>
          <div class="grid grid-cols-1 gap-4">
            {creativeRoles.map(role => (
              <Card {...role} />
            ))}
          </div>
        </section>
        <section>
          <h2 class="text-[20px] font-semibold text-[#1a1f36] mb-4">Manager Role Competencies</h2>
          <div class="grid grid-cols-1 gap-4">
            {managerRoles.map(role => (
              <Card {...role} />
            ))}
          </div>
        </section>
      </div>
    </article>
  </main>
</Layout>