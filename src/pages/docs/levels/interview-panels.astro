---
import { getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/Card.astro';

const entry = await getEntry('docs', 'levels/interview-panels');
const { Content } = await entry.render();

const panels = [
  {
    title: "Product Design Panel",
    description: "Interview structure and questions for Product Design roles",
    href: "/docs/levels/interview-panels/product-design",
    image: "🎨"
  },
  {
    title: "Content Design Panel",
    description: "Interview structure and questions for Content Design roles",
    href: "/docs/levels/interview-panels/content-design",
    image: "✍️"
  }
];
---

<Layout title={entry.data.title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <div class="mb-12">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{entry.data.title}</h1>
      </div>

      <Content />

      <div class="space-y-12">
        <section>
          <h2 class="text-xl font-semibold text-[#1a1f36] mb-6">Role-Specific Interview Guides</h2>
          <div class="grid grid-cols-1 gap-4">
            {panels.map(panel => (
              <Card {...panel} />
            ))}
          </div>
        </section>
      </div>
    </article>
  </main>
</Layout>
