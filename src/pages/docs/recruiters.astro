---
import WideLayout from '../../layouts/WideLayout.astro';
import RecruiterSubmissionModal from '../../components/ui/RecruiterSubmissionModal.tsx';

const title = "Design Recruiters Directory";
const description = "Find specialized design recruiters to help build your team";

// Sample recruiter data - this would come from a database in production
const recruiters = [
  {
    id: 1,
    name: "Sarah Chen",
    agency: "Design Talent Partners",
    image: "https://images.unsplash.com/photo-1494790108755-2616b612b786?w=150&h=150&fit=crop&crop=face",
    specialties: ["UX Design", "Product Design", "Research"],
    regions: ["North America", "Europe"],
    companySize: ["Startup", "Mid-market"],
    designerLevels: ["Senior", "Mid-level", "Executive"],
    linkedin: "https://linkedin.com/in/sarahchen",
    website: "https://designtalentpartners.com",
    email: "sarah@designtalentpartners.com",
    description: "Specialized in UX and product design roles for high-growth startups and scale-ups."
  },
  {
    id: 2,
    name: "Marcus Rodriguez",
    agency: "Creative Recruiters Co.",
    image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=150&h=150&fit=crop&crop=face",
    specialties: ["Visual Design", "Brand Design", "Illustration"],
    regions: ["North America"],
    companySize: ["Enterprise", "Mid-market"],
    designerLevels: ["Mid-level", "Senior", "Junior"],
    linkedin: "https://linkedin.com/in/marcusrodriguez",
    website: "https://creativerecruiters.co",
    email: "marcus@creativerecruiters.co",
    description: "Focused on creative and visual design roles for established brands and agencies."
  },
  {
    id: 3,
    name: "Emma Thompson",
    agency: "DesignOps Recruiters",
    image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=150&h=150&fit=crop&crop=face",
    specialties: ["Design Operations", "Design Systems", "UX Leadership"],
    regions: ["North America", "Europe", "Asia"],
    companySize: ["Enterprise", "Mid-market", "Startup"],
    designerLevels: ["Executive", "Senior", "Mid-level"],
    linkedin: "https://linkedin.com/in/emmathompson",
    website: "https://designopsrecruiters.com",
    email: "emma@designopsrecruiters.com",
    description: "Specialized in design operations, systems, and leadership roles across all company sizes."
  }
];

// Available filters
const allSpecialties = ["UX Design", "Product Design", "Visual Design", "Brand Design", "Research", "Design Operations", "Design Systems", "Content Design", "Illustration", "Motion Design"];
const allRegions = ["North America", "Europe", "Asia", "Australia", "South America", "Africa"];
const allCompanySizes = ["Startup", "Mid-market", "Enterprise"];

// Dynamically generate unique filter options from recruiter data
const uniqueSpecialties = Array.from(new Set(recruiters.flatMap(r => r.specialties))).sort();
const uniqueLevels = Array.from(new Set(recruiters.flatMap(r => r.designerLevels))).sort();
const uniqueRegions = Array.from(new Set(recruiters.flatMap(r => r.regions))).sort();
const uniqueCompanySizes = Array.from(new Set(recruiters.flatMap(r => r.companySize))).sort();

// Serialize data for JavaScript
const serializedRecruiters = JSON.stringify(recruiters);
const uniqueSpecialtiesJson = JSON.stringify(uniqueSpecialties);
const uniqueLevelsJson = JSON.stringify(uniqueLevels);
const uniqueRegionsJson = JSON.stringify(uniqueRegions);
const uniqueCompanySizesJson = JSON.stringify(uniqueCompanySizes);
---

<WideLayout title={title} description={description}>

  
  <div class="py-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      <p class="mt-2 text-[15px] text-[#3c4257] mb-6">
        Browse vetted recruiters who specialize in design roles.
      </p>
    </div>

    <!-- Filters Section -->
    <style>
    .filter-bar { 
      display: flex; 
      flex-wrap: nowrap; 
      gap: 1rem; 
      align-items: flex-start; 
      margin-bottom: 4rem;
      overflow-x: auto;
      overflow-y: visible;
    }
    
    .filter-pills-container {
      display: flex;
      gap: 1rem;
      flex: 1;
      align-items: flex-start;
    }
    
    .filter-pill { 
      position: relative;
      display: flex; 
      align-items: center; 
      gap: 0.5rem; 
      padding: 0.75rem 1rem; 
      background: #ffffff; 
      border: 2px solid #e5e7eb; 
      border-radius: 2rem; 
      cursor: pointer; 
      transition: all 0.2s ease; 
      font-size: 0.875rem; 
      font-weight: 500; 
      color: #374151; 
      white-space: nowrap;
      min-height: 44px;
      outline: none;
    }
    
    .filter-pill:hover {
      border-color: #d1d5db;
    }
    

    
    .filter-pill.open {
      border-color: #111;
      box-shadow: 0 4px 16px rgba(0,0,0,0.12);
      z-index: 1000;
    }
    
    .filter-pill-content { 
      display: flex; 
      align-items: center; 
      gap: 0.5rem; 
      min-width: 0; 
    }
    
    .filter-pill .arrow { 
      margin-left: 0.75rem; 
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
      display: flex; 
      align-items: center; 
      opacity: 0.7;
    }
    
    .filter-pill.open .arrow { 
      transform: rotate(180deg); 
      opacity: 1;
    }
    
    .filter-count-badge { 
      margin-left: 0.5rem; 
      background: #6b7280; 
      color: #fff; 
      border-radius: 9999px; 
      font-size: 0.75rem; 
      min-width: 1.25rem; 
      height: 1.25rem; 
      display: flex; 
      align-items: center; 
      justify-content: center; 
      padding: 0 0.375rem; 
      font-weight: 600;
      animation: fadeIn 0.2s ease-out;
    }
    
    .filter-pill.active .filter-count-badge {
      background: #1d4ed8;
    }
    
    .filter-dropdown { 
      position: fixed; 
      z-index: 9999; 
      min-width: 280px; 
      width: max-content; 
      max-width: 400px;
      background: #fff; 
      border: 1px solid #e5e7eb; 
      border-radius: 1rem; 
      box-shadow: 0 10px 30px rgba(0,0,0,0.15); 
      padding: 0.75rem 0; 
      display: none;
    }
    
    .filter-pill.open .filter-dropdown { 
      display: block;
    }
    
    .filter-dropdown-option { 
      padding: 0.75rem 1.5rem; 
      cursor: pointer; 
      transition: all 0.15s ease; 
      display: flex; 
      align-items: center; 
      gap: 0.75rem; 
      position: relative;
      min-height: 44px; /* Touch-friendly */
    }
    
    .filter-dropdown-option:hover {
      background: #f9fafb;
    }
    
    .filter-dropdown-option.selected {
      background: #eff6ff;
      color: #1d4ed8;
      font-weight: 600;
    }
    
    .filter-dropdown-option-label { 
      flex: 1;
      padding-right: 1rem;
    }
    
    .filter-dropdown-count { 
      background: #f1f5f9;
      color: #64748b;
      border-radius: 0.5rem;
      font-size: 0.875rem;
      min-width: 2rem;
      height: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 0.5rem;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }
    
    .filter-dropdown-option.selected .filter-dropdown-count {
      background: #dbeafe;
      color: #1d4ed8;
    }
    
    .filter-reset { 
      color: #6b7280; 
      text-decoration: underline; 
      margin-left: 1.5rem; 
      cursor: pointer; 
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      transition: all 0.2s ease;
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    
    .filter-reset:hover {
      background: #f3f4f6;
      color: #374151;
      text-decoration: none;
    }
    
    .filter-checkbox { 
      accent-color: #000; 
      width: 1.25rem; 
      height: 1.25rem; 
      border-radius: 0.25rem;
      cursor: pointer;
    }
    
    /* Mobile Styles */
    @media (max-width: 768px) {
      .filter-bar {
        gap: 0.75rem;
        position: relative;
      }
      
      .filter-pills-container {
        gap: 0.75rem;
      }
      
      .filter-pill {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        flex-shrink: 0;
        white-space: nowrap;
      }
      
      .filter-dropdown {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100vw;
        max-width: 100vw;
        height: 100vh;
        border-radius: 0;
        padding: 2rem 1rem 1rem;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(20px);
        transform: translateY(100%);
        box-shadow: none;
        border: none;
        overflow-y: auto;
      }
      
      .filter-pill.open .filter-dropdown {
        transform: translateY(0);
      }
      
      .filter-dropdown::before {
        content: '';
        position: absolute;
        top: 1rem;
        left: 50%;
        transform: translateX(-50%);
        width: 2rem;
        height: 0.25rem;
        background: #d1d5db;
        border-radius: 9999px;
      }
      
      .filter-dropdown-option {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f3f4f6;
      }
      
      .filter-dropdown-option:last-child {
        border-bottom: none;
      }
      
      .filter-reset {
        margin-left: 0;
        margin-top: 0.5rem;
        justify-content: center;
      }
    }
    
    @media (max-width: 480px) {
      .filter-bar {
        gap: 0.5rem;
      }
      
      .filter-pills-container {
        gap: 0.5rem;
      }
      
      .filter-pill {
        padding: 0.625rem 0.75rem;
        font-size: 0.8125rem;
        flex-shrink: 0;
      }
    }
    
    /* Animations */
    @keyframes fadeIn {
      from { opacity: 0; transform: scale(0.8); }
      to { opacity: 1; transform: scale(1); }
    }
    
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    /* Focus styles for accessibility */
    .filter-pill:focus {
      outline: none;
    }
    
    .filter-checkbox:focus {
      outline: none;
    }
    </style>
    <div class="filter-bar" id="filterBar">
      <div class="filter-pills-container">
        <div class="filter-pill" tabindex="0" data-filter="specialty">
          <span class="filter-pill-content">
            <span id="specialty-pill-label">Specialty</span>
            <span class="filter-count-badge" id="specialty-count-badge" style="display:none">0</span>
          </span>
          <span class="arrow"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></span>
          <div class="filter-dropdown">
            <div class="filter-dropdown-option">
              <input type="checkbox" class="filter-checkbox" value="UX Design" data-filter="specialty" onchange="onFilterCheckboxChange(event)">
              <span class="filter-dropdown-option-label">UX Design</span>
              <span class="filter-dropdown-count">3</span>
            </div>
            <div class="filter-dropdown-option">
              <input type="checkbox" class="filter-checkbox" value="Product Design" data-filter="specialty" onchange="onFilterCheckboxChange(event)">
              <span class="filter-dropdown-option-label">Product Design</span>
              <span class="filter-dropdown-count">2</span>
            </div>
            <div class="filter-dropdown-option">
              <input type="checkbox" class="filter-checkbox" value="Visual Design" data-filter="specialty" onchange="onFilterCheckboxChange(event)">
              <span class="filter-dropdown-option-label">Visual Design</span>
              <span class="filter-dropdown-count">1</span>
            </div>
          </div>
        </div>
        <div class="filter-pill" tabindex="0" data-filter="level">
          <span class="filter-pill-content">
            <span id="level-pill-label">Level</span>
            <span class="filter-count-badge" id="level-count-badge" style="display:none">0</span>
          </span>
          <span class="arrow"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></span>
          <div class="filter-dropdown">
            {uniqueLevels.map(l => <label class="filter-dropdown-option"><input type="checkbox" class="filter-checkbox" value={l} data-filter="level" onchange="onFilterCheckboxChange(event)"><span class="filter-dropdown-option-label">{l}</span><span class="filter-dropdown-count" id={`count-level-${l.replace(/\W/g,'_')}`}>0</span></label>)}
          </div>
        </div>
        <div class="filter-pill" tabindex="0" data-filter="region">
          <span class="filter-pill-content">
            <span id="region-pill-label">Region</span>
            <span class="filter-count-badge" id="region-count-badge" style="display:none">0</span>
          </span>
          <span class="arrow"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></span>
          <div class="filter-dropdown">
            {uniqueRegions.map(r => <label class="filter-dropdown-option"><input type="checkbox" class="filter-checkbox" value={r} data-filter="region" onchange="onFilterCheckboxChange(event)"><span class="filter-dropdown-option-label">{r}</span><span class="filter-dropdown-count" id={`count-region-${r.replace(/\W/g,'_')}`}>0</span></label>)}
          </div>
        </div>
        <div class="filter-pill" tabindex="0" data-filter="companySize">
          <span class="filter-pill-content">
            <span id="companySize-pill-label">Company Size</span>
            <span class="filter-count-badge" id="companySize-count-badge" style="display:none">0</span>
          </span>
          <span class="arrow"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg></span>
          <div class="filter-dropdown">
            {uniqueCompanySizes.map(c => <label class="filter-dropdown-option"><input type="checkbox" class="filter-checkbox" value={c} data-filter="companySize" onchange="onFilterCheckboxChange(event)"><span class="filter-dropdown-option-label">{c}</span><span class="filter-dropdown-count" id={`count-companySize-${c.replace(/\W/g,'_')}`}>0</span></label>)}
          </div>
        </div>
      </div>
      <span class="filter-reset" id="resetFilters" style="display:none">Reset filters</span>
    </div>

    <!-- Recruiters Grid -->
    <div id="recruiters-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {recruiters.map(recruiter => (
        <div class="recruiter-card bg-white rounded-2xl border border-gray-200 p-6 transition-all duration-200 hover:shadow-lg hover:-translate-y-1"
          data-specialties={JSON.stringify(recruiter.specialties)}
          data-levels={JSON.stringify(recruiter.designerLevels)}
          data-regions={JSON.stringify(recruiter.regions)}
          data-company-size={JSON.stringify(recruiter.companySize)}
        >
          <div class="flex items-start gap-4 mb-4">
            <img src={recruiter.image} alt={recruiter.name} class="w-16 h-16 rounded-full object-cover">
            <div class="flex-1">
              <h3 class="font-semibold text-lg text-gray-900">{recruiter.name}</h3>
              <p class="text-gray-600 text-sm">{recruiter.agency}</p>
            </div>
          </div>
          
          <p class="text-gray-700 text-sm mb-4">{recruiter.description}</p>
          
          <div class="mb-4">
            <h4 class="font-medium text-sm text-gray-900 mb-2">Specialties</h4>
            <div class="flex flex-wrap gap-1">
              {recruiter.specialties.map(specialty => (
                <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded-full text-xs">{specialty}</span>
              ))}
            </div>
          </div>
          
          <div class="mb-4">
            <h4 class="font-medium text-sm text-gray-900 mb-2">Regions</h4>
            <div class="flex flex-wrap gap-1">
              {recruiter.regions.map(region => (
                <span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs">{region}</span>
              ))}
            </div>
          </div>
          
          <div class="mb-4">
            <h4 class="font-medium text-sm text-gray-900 mb-2">Company Size</h4>
            <div class="flex flex-wrap gap-1">
              {recruiter.companySize.map(size => (
                <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs">{size}</span>
              ))}
            </div>
          </div>
          
          <div class="mb-4">
            <h4 class="font-medium text-sm text-gray-900 mb-2">Designer Levels</h4>
            <div class="flex flex-wrap gap-1">
              {recruiter.designerLevels?.map(level => (
                <span class="px-2 py-1 bg-purple-100 text-purple-700 rounded-full text-xs">{level}</span>
              ))}
            </div>
          </div>
          
          <div class="flex gap-2 pt-4 border-t border-gray-200">
            {recruiter.linkedin && (
              <a href={recruiter.linkedin} target="_blank" class="flex-1 bg-blue-600 text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors">
                LinkedIn
              </a>
            )}
            {recruiter.website && (
              <a href={recruiter.website} target="_blank" class="flex-1 bg-gray-800 text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-gray-900 transition-colors">
                Website
              </a>
            )}
            {recruiter.email && (
              <a href={`mailto:${recruiter.email}`} class="flex-1 bg-green-600 text-white text-center py-2 px-4 rounded-lg text-sm font-medium hover:bg-green-700 transition-colors">
                Email
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Move Submit Your Agency button to the bottom -->
    <div class="flex justify-center mt-8">
      <button 
        id="open-submission-modal"
        class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-[rgb(79,70,229)] hover:bg-[rgb(67,56,202)] rounded-md transition-colors cursor-pointer no-underline"
      >
        Submit Your Agency
      </button>
    </div>
  </div>

  <!-- Modal Component -->
  <RecruiterSubmissionModal client:load />
</WideLayout>

<script is:inline define:vars={{ recruiters, uniqueSpecialties, uniqueLevels, uniqueRegions, uniqueCompanySizes }}>
const filterState = { specialty: [], level: [], region: [], companySize: [] };
let openDropdown = null;

function anyFilterActive() {
  return filterState.specialty.length || filterState.level.length || filterState.region.length || filterState.companySize.length;
}

function showOrHideReset() {
  document.getElementById('resetFilters').style.display = anyFilterActive() ? '' : 'none';
}

function closeDropdowns(e) {
  // Only close if click is outside any filter-pill or dropdown
  if (e && (e.target.closest('.filter-pill') || e.target.closest('.filter-dropdown'))) return;
  document.querySelectorAll('.filter-pill').forEach(pill => pill.classList.remove('open'));
  openDropdown = null;
}

function updatePillLabelsAndBadges() {
  // Update pill labels with counts and active states
  const filterLabels = {
    specialty: 'Specialty',
    level: 'Level', 
    region: 'Region',
    companySize: 'Company Size'
  };
  
  Object.keys(filterLabels).forEach(filterType => {
    const count = filterState[filterType].length;
    const label = document.getElementById(`${filterType}-pill-label`);
    const badge = document.getElementById(`${filterType}-count-badge`);
    const pill = document.querySelector(`[data-filter="${filterType}"]`);
    
    if (count > 0) {
      label.textContent = `${filterLabels[filterType]} (${count})`;
      badge.textContent = count;
      badge.style.display = 'flex';
      pill.classList.add('active');
    } else {
      label.textContent = filterLabels[filterType];
      badge.style.display = 'none';
      pill.classList.remove('active');
    }
  });
  
  showOrHideReset();
}

function getFilteredRecruiters() {
  return recruiters.filter(r => {
    if (filterState.specialty.length && !filterState.specialty.some(s => r.specialties.includes(s))) return false;
    if (filterState.level.length && !filterState.level.some(l => (r.designerLevels||[]).includes(l))) return false;
    if (filterState.region.length && !filterState.region.some(reg => r.regions.includes(reg))) return false;
    if (filterState.companySize.length && !filterState.companySize.some(c => r.companySize.includes(c))) return false;
    return true;
  });
}

function updateDropdownCounts() {
  const filtered = getFilteredRecruiters();
  uniqueSpecialties.forEach((value, i) => {
    const id = `count-specialty-${value.replace(/\W/g,'_')}`;
    const count = filtered.filter(r => r.specialties.includes(value)).length;
    const el = document.getElementById(id);
    if (el) el.textContent = count.toString();
  });
  uniqueLevels.forEach((value, i) => {
    const id = `count-level-${value.replace(/\W/g,'_')}`;
    const count = filtered.filter(r => (r.designerLevels||[]).includes(value)).length;
    const el = document.getElementById(id);
    if (el) el.textContent = count.toString();
  });
  uniqueRegions.forEach((value, i) => {
    const id = `count-region-${value.replace(/\W/g,'_')}`;
    const count = filtered.filter(r => r.regions.includes(value)).length;
    const el = document.getElementById(id);
    if (el) el.textContent = count.toString();
  });
  uniqueCompanySizes.forEach((value, i) => {
    const id = `count-companySize-${value.replace(/\W/g,'_')}`;
    const count = filtered.filter(r => r.companySize.includes(value)).length;
    const el = document.getElementById(id);
    if (el) el.textContent = count.toString();
  });
}

function filterRecruiters() {
  document.querySelectorAll('.recruiter-card').forEach(card => {
    const specialties = JSON.parse(card.dataset.specialties || '[]');
    const levels = JSON.parse(card.dataset.levels || '[]');
    const regions = JSON.parse(card.dataset.regions || '[]');
    const companySizes = JSON.parse(card.dataset.companySize || '[]');
    let show = true;
    if (filterState.specialty.length && !filterState.specialty.some(s => specialties.includes(s))) show = false;
    if (filterState.level.length && !filterState.level.some(l => levels.includes(l))) show = false;
    if (filterState.region.length && !filterState.region.some(r => regions.includes(r))) show = false;
    if (filterState.companySize.length && !filterState.companySize.some(c => companySizes.includes(c))) show = false;
    card.style.display = show ? '' : 'none';
  });
  updatePillLabelsAndBadges();
  updateDropdownCounts();
}

function updateDropdownSelectedStates() {
  // Update selected states for all dropdown options
  document.querySelectorAll('.filter-dropdown-option').forEach(option => {
    const checkbox = option.querySelector('.filter-checkbox');
    if (checkbox && checkbox.checked) {
      option.classList.add('selected');
    } else {
      option.classList.remove('selected');
    }
  });
}

function onFilterCheckboxChange(e) {
  e.stopPropagation();
  const filter = e.target.getAttribute('data-filter');
  const value = e.target.value;
  
  if (e.target.checked) {
    if (!filterState[filter].includes(value)) filterState[filter].push(value);
  } else {
    filterState[filter] = filterState[filter].filter(v => v !== value);
  }
  
  // Update visual states
  updateDropdownSelectedStates();
  filterRecruiters();
}

document.addEventListener('DOMContentLoaded', () => {
  console.log('Filter pills initialized');
  document.querySelectorAll('.filter-pill').forEach(pill => {
    console.log('Adding click listener to pill:', pill.dataset.filter);
    pill.addEventListener('click', function(e) {
      console.log('Pill clicked:', pill.dataset.filter, e.target);
      // Only open/close if not clicking a checkbox
      if (e.target.tagName === 'INPUT') {
        console.log('Checkbox clicked, ignoring');
        return;
      }
      e.stopPropagation();
      
      // Close other dropdowns
      document.querySelectorAll('.filter-pill').forEach(otherPill => {
        if (otherPill !== pill) {
          otherPill.classList.remove('open');
        }
      });
      
      // Toggle current dropdown
      const isOpen = pill.classList.contains('open');
      if (isOpen) {
        pill.classList.remove('open');
      } else {
        // Calculate position for fixed dropdown
        const dropdown = pill.querySelector('.filter-dropdown');
        const rect = pill.getBoundingClientRect();
        dropdown.style.top = (rect.bottom + 8) + 'px';
        dropdown.style.left = rect.left + 'px';
        
        pill.classList.add('open');
      }
    });
    pill.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        pill.click();
      }
    });
    // Prevent dropdown from closing when clicking inside dropdown
    pill.querySelector('.filter-dropdown').addEventListener('click', function(ev) {
      ev.stopPropagation();
    });
  });
  // Close dropdowns on outside click
  document.body.addEventListener('click', closeDropdowns);
  // Reset filters
  document.getElementById('resetFilters').addEventListener('click', () => {
    filterState.specialty = [];
    filterState.level = [];
    filterState.region = [];
    filterState.companySize = [];
    document.querySelectorAll('.filter-checkbox').forEach(cb => cb.checked = false);
    updateDropdownSelectedStates();
    filterRecruiters();
  });
  
  // Close dropdowns when clicking outside (enhanced for mobile)
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.filter-pill')) {
      closeDropdowns();
    }
  });
  
  // Handle mobile swipe to close
  let startY = 0;
  document.addEventListener('touchstart', (e) => {
    startY = e.touches[0].clientY;
  });
  
  document.addEventListener('touchmove', (e) => {
    if (!e.target.closest('.filter-dropdown')) return;
    
    const currentY = e.touches[0].clientY;
    const diff = startY - currentY;
    
    // If swiping down significantly, close the dropdown
    if (diff < -100) {
      closeDropdowns();
    }
  });
  
  // Initialize
  updateDropdownSelectedStates();
  filterRecruiters();
});
</script>

