// Note: Filtering has been simplified since recruiters now have text-based categories

// Function to create URL-friendly slugs
function createSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

// Check for access parameter
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
const hasAccess = accessKey === 'recruit2024';
---

<WideLayout title={title} description={description}>
  <div class="py-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
        </div>
      </div>
      <div class="flex flex-col md:flex-row md:justify-between md:items-baseline">
        <p class="mt-2 text-[15px] text-[#3c4257] mb-4 md:mb-6">
          Design recruiters personally vetted by me for exceptional results.
        </p>
        {false && hasAccess && (
          <div class="flex-shrink-0 md:ml-8">
            <button 
              id="open-submission-modal"
              class="inline-flex items-center gap-1.5 text-sm font-normal text-gray-600 underline md:hover:bg-gray-100 md:hover:no-underline md:hover:text-gray-900 py-1 md:px-2 rounded transition-all cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              Submit Your Agency
            </button>
          </div>
        )}
      </div>
    </div>

    {!hasAccess ? (
      <!-- Access Denied Message -->
      <div class="flex flex-col items-center justify-center min-h-[400px] text-center">
        <div class="max-w-md mx-auto">
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">Private Directory</h2>
          <p class="text-gray-600 mb-6">
            This recruiter directory is currently private. If you're a recruiter looking to be listed, please contact me directly.
          </p>
          <a 
            href="/docs" 
            class="inline-flex items-center px-4 py-2 bg-black text-white font-medium rounded-lg hover:bg-gray-900 transition-colors"
          >
            Back to Documentation
          </a>
        </div>
      </div>
    ) : (

    <!-- Filters have been removed with the new simplified data structure -->

    <!-- Recruiters Grid -->
    <RecruiterGridSimple 
      recruiters={recruiters}
      hasAccess={hasAccess}
      createSlug={createSlug}
      client:load
    />

    )}

  </div>

  <!-- Modal Components -->
  {hasAccess && (<RecruiterSubmissionModal client:load />)}
</WideLayout>



<script>
  // Modal functionality
  document.addEventListener('DOMContentLoaded', function() {
    const openModalBtn = document.getElementById('open-submission-modal');
    if (openModalBtn) {
      openModalBtn.addEventListener('click', () => {
        // Dispatch a custom event to open the modal
        document.dispatchEvent(new CustomEvent('openRecruiterModal'));
      });
    }
  });
</script> 