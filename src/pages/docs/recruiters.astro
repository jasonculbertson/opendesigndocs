---
import WideLayout from '../../layouts/WideLayout.astro';
import RecruiterSubmissionModal from '../../components/ui/RecruiterSubmissionModal.tsx';

const title = "Recruiter Directory";
const description = "Find specialized design recruiters to help build your team";

// Sample recruiter data - this would come from a database in production
const recruiters = [
  {
    id: 1,
    name: "Laura Hunting",
    agency: "Found By",
    image: "/images/laura.jpeg",
    linkedin: "https://www.linkedin.com/in/laurahunting/",
    website: "https://www.foundby.co/",
    email: "laura@foundby.co",
    loginEmail: "laura@foundby.co",
    about: "Laura is a founding partner at Found By, a boutique talent agency and executive search firm specialized in design. With over a decade of experience building design leadership teams, Found By has placed talent at industry leaders including Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, and Squarespace.",
    specialties: "Design Leadership, Executive Search, UX Design, Product Design",
    philosophy: "I focus on building diverse teams thoughtfully and effectively, understanding that great design teams are built on a foundation of varied perspectives and complementary skills.",
    approach: "My approach involves deep discovery sessions with both clients and candidates to understand cultural fit, growth trajectory, and long-term career goals. I believe in transparent communication and building lasting relationships rather than just filling positions.",
    notableClients: "Airbnb, Zillow, Square, Yahoo, Nike, Calendly, GoodRx, Pinterest, Duolingo, Squarespace",
  },
  {
    id: 2,
    name: "Garrett Fowler",
    agency: "Offsite",
    image: "/images/garrett.jpeg",
    linkedin: "https://www.linkedin.com/in/garrettfowler/",
    website: "https://www.off.site",
    email: "garrett@off.site",
    loginEmail: "garrett@off.site",
    about: "Garrett is the Founder of Offsite, a new kind of creative talent community focused on the intersection of career and creative practice. As a Design & Executive Talent Agent, he specializes in connecting exceptional design professionals with opportunities that align with their creative vision and career goals.",
    specialties: "Product Design, UX Design, Design Leadership",
    philosophy: "I believe in going beyond traditional recruiting to build meaningful relationships within the creative community. Design talent deserves more than just job placement—they deserve career partnership.",
    approach: "My approach centers on understanding both the creative and business sides of design roles. I focus on long-term career trajectory matching rather than quick placements, ensuring both candidates and companies find the right cultural and skill alignment.",
    notableClients: "Various SaaS, FinTech, E-commerce, and Enterprise Software companies",
  },

  {
    id: 4,
    name: "Dirk Cleveland",
    agency: "Fusion",
    image: "/images/dirk.jpeg",
    linkedin: "https://www.linkedin.com/in/dirkcleveland/",
    website: "https://www.fusiontalent.com",
    email: "dirk@fusiontalent.com",
    loginEmail: "dirk@fusiontalent.com",
    about: "Dirk specializes in Design Leadership Recruiting at Fusion, a 100% referral-based executive search firm focused exclusively on Engineering, Product, and Design leadership roles. With extensive experience placing executives at companies like Uber, Airbnb, Atlassian, and many more, Dirk focuses on long-term career growth and cultural alignment for senior design positions.",
    specialties: "UX Design, Product Design, Design Systems, Design Leadership",
    philosophy: "I believe in the power of referral-based recruiting and building long-term relationships. Great design leaders aren't just found—they're cultivated through trust and understanding of their career aspirations.",
    approach: "My approach is exclusively referral-based, focusing on quality over quantity. I invest time in understanding both the cultural dynamics of client organizations and the career motivations of design leaders to ensure sustainable, long-term placements.",
    notableClients: "Uber, Airbnb, Atlassian, and other leading SaaS, Enterprise Software, FinTech, and Healthcare Tech companies",
  },


  {
    id: 7,
    name: "MJ",
    agency: "Offsite",
    image: "/images/mj.jpeg",
    linkedin: "https://www.linkedin.com/in/monjin/",
    website: "https://www.off.site",
    email: "mj@off.site",
    loginEmail: "mj@off.site",
    about: "MJ leads IC Product Design, Content Design, UX Research, and Design Ops at Offsite, a creative talent community focused on the intersection of career and creative practice. With expertise across multiple design disciplines, MJ helps connect exceptional design professionals with opportunities that align with their creative vision and career goals.",
    specialties: "Product Design, Content Design, UX Research, Design Ops",
    philosophy: "I believe in empowering design professionals across all disciplines to find their ideal career paths. Great design happens when talented individuals are matched with the right opportunities and teams.",
    approach: "My approach is holistic, considering not just design skills but also career aspirations, creative growth, and cultural fit. I work closely with both candidates and companies to ensure sustainable, long-term placements that benefit everyone involved.",
    notableClients: "Various SaaS, FinTech, E-commerce, and Enterprise Software companies",
  },

];

// Note: Filtering has been simplified since recruiters now have text-based categories

// Function to create URL-friendly slugs
function createSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

// Redirect old access URLs to clean URLs
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
if (accessKey === 'recruit2024') {
  return Astro.redirect('/docs/recruiters');
}

// Check if user has access (admin or recruiter)
const ADMIN_EMAIL = 'jculbertson@gmail.com';
const RECRUITER_EMAILS = [
  'laura@foundby.co',
  'garrett@off.site', 
  'dirk@fusiontalent.com',
  'mj@off.site'
];

// Always assume access initially for better performance
// Client-side script will hide content if user is not authorized
let hasAccess = true;
---

<WideLayout title={title} description={description}>
  <div class="py-8">


    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
        </div>
      </div>
      <div class="flex flex-col md:flex-row md:justify-between md:items-baseline">
        <p class="mt-2 text-[15px] text-[#3c4257] mb-4 md:mb-6">
          Design recruiters personally vetted by me for exceptional results.
        </p>
        {false && hasAccess && (
          <div class="flex-shrink-0 md:ml-8">
            <button 
              id="open-submission-modal"
              class="inline-flex items-center gap-1.5 text-sm font-normal text-gray-600 underline md:hover:bg-gray-100 md:hover:no-underline md:hover:text-gray-900 py-1 md:px-2 rounded transition-all cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              Submit Your Agency
            </button>
          </div>
        )}
      </div>
    </div>

    <!-- Access Denied Message (hidden by default, shown by client-side script if not authorized) -->
    <div id="access-denied" class="flex flex-col items-center justify-center min-h-[400px] text-center" style="display: none;">
      <div class="max-w-md mx-auto">
        <h2 class="text-2xl font-semibold text-gray-900 mb-4">Private Directory</h2>
        <p class="text-gray-600 mb-6">
          This recruiter directory is currently private. If you're a recruiter looking to be listed, please contact me directly.
        </p>
        <a 
          href="/docs" 
          class="inline-flex items-center px-4 py-2 bg-black text-white font-medium rounded-lg hover:bg-gray-900 transition-colors"
        >
          Back to Documentation
        </a>
      </div>
    </div>

    <!-- Recruiters Grid (shown by default, hidden by client-side script if not authorized) -->
    <div id="recruiters-container">
      <div id="recruiters-grid" class="grid grid-cols-2 lg:!grid-cols-4 gap-8 mb-12">
      {recruiters.map(recruiter => (
        <div key={recruiter.id} class="recruiter-card w-full" data-recruiter-id={recruiter.id}>
          <a 
            href={`/docs/recruiters/${createSlug(recruiter.name)}`}
            class="block relative bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-lg transition-all cursor-pointer group"
          >
            <!-- Image -->
            <div class="aspect-square bg-gray-50 relative">
              {recruiter.image ? (
                <img src={recruiter.image} alt={recruiter.name} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center">
                  <span class="text-white font-bold text-4xl">
                    {recruiter.name.split(' ').map(word => word.charAt(0)).join('').toUpperCase().slice(0, 2)}
                  </span>
                </div>
              )}
            </div>
            
            <!-- Content -->
            <div class="px-4 py-3 md:px-6 md:py-5">
              <h3 class="text-base md:text-lg font-medium text-gray-900 mb-0.5 group-hover:text-black transition-colors">
                {recruiter.name}
              </h3>
              <p class="text-sm text-gray-600">
                {recruiter.agency}
              </p>
            </div>
          </a>
        </div>
      ))}
      </div>
    </div>

  </div>

  <!-- Modal Components -->
  {hasAccess && (<RecruiterSubmissionModal client:load />)}

  <!-- Fast client-side authentication check -->
  <script>
    const ADMIN_EMAIL = 'jculbertson@gmail.com';
    const RECRUITER_EMAILS = [
      'laura@foundby.co',
      'garrett@off.site', 
      'dirk@fusiontalent.com',
      'mj@off.site'
    ];
    
    function quickAuthCheck() {
      // Quick check - if Clerk is already loaded and user is available
      if (window.Clerk?.user) {
        const userEmail = window.Clerk.user.primaryEmailAddress?.emailAddress;
        
        if (userEmail === ADMIN_EMAIL || RECRUITER_EMAILS.includes(userEmail)) {
          console.log('✅ Instant access granted for:', userEmail);
          return; // Content is already visible, nothing to do
        } else {
          console.log('❌ Access denied for:', userEmail);
          hideContent();
        }
      } else {
        // Clerk not ready yet, wait a bit and try again
        setTimeout(delayedAuthCheck, 100);
      }
    }
    
    async function delayedAuthCheck() {
      try {
        if (window.Clerk) {
          await window.Clerk.load();
          const user = window.Clerk.user;
          const userEmail = user?.primaryEmailAddress?.emailAddress;
          
          if (userEmail === ADMIN_EMAIL || RECRUITER_EMAILS.includes(userEmail)) {
            console.log('✅ Access granted for:', userEmail);
            return; // Content is already visible
          } else {
            console.log('❌ Access denied for:', userEmail);
            hideContent();
          }
        } else {
          console.log('❌ Clerk not available');
          hideContent();
        }
      } catch (error) {
        console.log('❌ Auth check failed:', error);
        hideContent();
      }
    }
    
    function hideContent() {
      const recruitersContainer = document.getElementById('recruiters-container');
      const accessDenied = document.getElementById('access-denied');
      
      if (recruitersContainer) recruitersContainer.style.display = 'none';
      if (accessDenied) accessDenied.style.display = 'flex';
    }
    
    // Run immediately
    quickAuthCheck();
    
    // Also check on navigation events
    window.addEventListener('pageshow', quickAuthCheck);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) quickAuthCheck();
    });
  </script>
</WideLayout>



<script>
  // Modal functionality
  document.addEventListener('DOMContentLoaded', function() {
    const openModalBtn = document.getElementById('open-submission-modal');
    if (openModalBtn) {
      openModalBtn.addEventListener('click', () => {
        // Dispatch a custom event to open the modal
        document.dispatchEvent(new CustomEvent('openRecruiterModal'));
      });
    }
  });
</script> 