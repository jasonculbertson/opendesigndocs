---
import WideLayout from '../../layouts/WideLayout.astro';
import RecruiterSubmissionModal from '../../components/ui/RecruiterSubmissionModal.tsx';
import { createClient } from '@supabase/supabase-js';

const title = "Recruiter Directory";
const description = "Find specialized design recruiters to help build your team";

// Load recruiters from database
const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseServiceKey = import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

if (!supabaseUrl || !supabaseServiceKey) {
  throw new Error('Missing Supabase configuration');
}

const supabase = createClient(supabaseUrl, supabaseServiceKey);

// Fetch recruiters from database
let recruiters = [];
try {
  const { data: dbRecruiters, error } = await supabase
    .from('recruiters')
    .select('*')
    .eq('is_active', true)
    .order('display_order', { ascending: true })
    .order('name', { ascending: true }); // Fallback to name for any without display_order

  if (error) {
    console.error('Error fetching recruiters:', error);
  } else {
    recruiters = dbRecruiters || [];
    console.log('Loaded recruiters from database:', recruiters.length);
  }
} catch (error) {
  console.error('Database connection error:', error);
}

// If no recruiters loaded, use minimal fallback
if (recruiters.length === 0) {
  console.warn('No recruiters loaded from database, using empty array');
}

// Note: Filtering has been simplified since recruiters now have text-based categories

// Function to create URL-friendly slugs
function createSlug(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)+/g, '');
}

// Redirect old access URLs to clean URLs
const url = new URL(Astro.request.url);
const accessKey = url.searchParams.get('access');
if (accessKey === 'recruit2024') {
  return Astro.redirect('/docs/recruiters');
}

// Check if user has access (admin or recruiter)
const ADMIN_EMAIL = 'jculbertson@gmail.com';
const RECRUITER_EMAILS = [
  'laura@foundby.co',
  'garrett@off.site', 
  'dirk@fusiontalent.com',
  'mj@off.site'
];

// Always assume access initially for better performance
// Client-side script will hide content if user is not authorized
let hasAccess = true;
---

<WideLayout title={title} description={description}>
  <div class="py-8">


    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-start">
        <div class="flex-1">
          <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
        </div>
      </div>
      <div class="flex flex-col md:flex-row md:justify-between md:items-baseline">
        <p class="mt-2 text-[15px] text-[#3c4257] mb-4 md:mb-6">
          Design recruiters vetted for exceptional results.
        </p>
        {false && hasAccess && (
          <div class="flex-shrink-0 md:ml-8">
            <button 
              id="open-submission-modal"
              class="inline-flex items-center gap-1.5 text-sm font-normal text-gray-600 underline md:hover:bg-gray-100 md:hover:no-underline md:hover:text-gray-900 py-1 md:px-2 rounded transition-all cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              Submit Your Agency
            </button>
          </div>
        )}
      </div>
    </div>

    <!-- Removed access denied message - directory is now public -->

    <!-- Recruiters Grid (shown by default, hidden by client-side script if not authorized) -->
    <div id="recruiters-container">
      <div id="recruiters-grid" class="grid grid-cols-2 lg:!grid-cols-4 gap-8 mb-12">
      {recruiters.map(recruiter => (
        <div key={recruiter.id} class="recruiter-card w-full" data-recruiter-id={recruiter.id}>
          <a 
            href={`/docs/recruiters/${createSlug(recruiter.name)}`}
            class="block relative bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-lg transition-all cursor-pointer group"
          >
            <!-- Image -->
            <div class="aspect-square bg-gray-50 relative">
              {recruiter.image ? (
                <img src={recruiter.image} alt={recruiter.name} class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center">
                  <span class="text-white font-bold text-4xl">
                    {recruiter.name.split(' ').map(word => word.charAt(0)).join('').toUpperCase().slice(0, 2)}
                  </span>
                </div>
              )}
            </div>
            
            <!-- Content -->
            <div class="px-4 py-3 md:px-6 md:py-5">
              <h3 class="text-base md:text-lg font-medium text-gray-900 mb-0.5 group-hover:text-black transition-colors">
                {recruiter.name}
              </h3>
              <p class="text-sm text-gray-600">
                {recruiter.agency}
              </p>
            </div>
          </a>
        </div>
      ))}
      </div>
    </div>

  </div>

  <!-- Modal Components -->
  {hasAccess && (<RecruiterSubmissionModal client:load />)}

  <!-- Directory is now public - no authentication required -->
  <script>
    console.log('📂 Recruiter directory is now publicly accessible');
    
    // Track page view for visitor analytics
    document.addEventListener('DOMContentLoaded', function() {
      // Track directory page view
      fetch('/api/analytics', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event: 'page_view',
          properties: {
            page: '/docs/recruiters',
            page_title: 'Recruiter Directory',
            page_category: 'recruiters',
            visitor_type: 'public',
            timestamp: new Date().toISOString()
          }
        })
      }).catch(err => console.error('Analytics tracking error:', err));
      
      console.log('📊 Tracked recruiter directory page view');
    });
  </script>
</WideLayout>



<script>
  // Modal functionality
  document.addEventListener('DOMContentLoaded', function() {
    const openModalBtn = document.getElementById('open-submission-modal');
    if (openModalBtn) {
      openModalBtn.addEventListener('click', () => {
        // Dispatch a custom event to open the modal
        document.dispatchEvent(new CustomEvent('openRecruiterModal'));
      });
    }
  });
</script> 