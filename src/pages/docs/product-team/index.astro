---
import Layout from '../../../layouts/Layout.astro';
import Card from '../../../components/ui/Card.astro';

const title = "Product Team";

const resources = [
  {
    title: 'One Pagers',
    description: 'Learn how to write effective one pagers',
    href: '/docs/product-team/one-pagers',
    image: '📄'
  },
  {
    title: 'Product Spec',
    description: 'How to write a product spec',
    href: '/docs/product-team/product-spec',
    image: '📋'
  },
  {
    title: 'Project Kickoff Meeting',
    description: 'How to run a project kickoff meeting',
    href: '/docs/product-team/project-kickoff-meeting',
    image: '🚀'
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
      </div>
      <div class="grid grid-cols-1 gap-4">
        {resources.map(resource => (
          <Card {...resource} />
        ))}
      </div>
    </article>
  </main>
</Layout>