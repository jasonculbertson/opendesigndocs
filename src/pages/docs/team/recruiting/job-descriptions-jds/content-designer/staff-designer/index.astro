---
import Layout from '../../../../../../../layouts/Layout.astro';
import ContentGate from '../../../../../../../components/ContentGate';

const breadcrumbs = [
  { text: 'Recruiting Team', href: '/docs/team/recruiting' },
  { text: 'Job Descriptions', href: '/docs/team/recruiting/job-descriptions-jds' },
  { text: 'Content Designer', href: '/docs/team/recruiting/job-descriptions-jds/content-designer' }
];

---

<Layout title="Staff Designer">
  <ContentGate client:load>
    <main class="relative min-h-screen">
      <div class="py-8">
        <div class="mx-auto">
          <nav class="flex mb-2" aria-label="Breadcrumb">
            <ol class="flex items-center">
              {breadcrumbs.map((crumb, index) => (
                <li class="flex items-center">
                  {index > 0 && <span class="mx-2 text-gray-400">/</span>}
                  <a href={crumb.href} class="text-sm text-gray-600 hover:text-gray-900">
                    {crumb.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
          
          <div class="prose max-w-none prose-a:text-indigo-600 prose-a:no-underline hover:prose-a:text-indigo-700">
            <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px] mb-6">Staff Designer</h1>
            
            <h2 class="text-xl font-semibold mt-8 mb-4">About [Company Name]</h2>
            <p>Add a bit about your company here.</p>

            <h2 class="text-xl font-semibold mt-8 mb-4">Role Overview</h2>
            <p>As a Content Designer at [Company Name], you will be responsible for creating and maintaining high-quality content across multiple product areas and teams. This role requires strong writing and editing skills, as well as the ability to collaborate with designers, product managers, and other stakeholders.</p>

            <h2 class="text-xl font-semibold mt-8 mb-4">What You'll Do</h2>
            <ul>
              <li>Create and maintain high-quality content across multiple product areas</li>
              <li>Collaborate with designers, product managers, and other stakeholders to develop content strategies</li>
              <li>Develop and maintain content style guides and standards</li>
              <li>Edit and proofread content for clarity, grammar, and consistency</li>
              <li>Conduct research to stay up-to-date on industry trends and best practices</li>
            </ul>

            <h2 class="text-xl font-semibold mt-8 mb-4">What You'll Need</h2>
            <ul>
              <li>3+ years of experience in content design or a related field</li>
              <li>Strong writing and editing skills</li>
              <li>Ability to collaborate with designers, product managers, and other stakeholders</li>
              <li>Experience with content management systems and style guides</li>
              <li>Bachelor's degree in English, Communications, or a related field (or equivalent experience)</li>
            </ul>

            <h2 class="text-xl font-semibold mt-8 mb-4">Benefits</h2>
            <ul>
              <li>Competitive salary and equity package</li>
              <li>Health, dental, and vision insurance</li>
              <li>Flexible work hours and location</li>
              <li>Professional development opportunities</li>
              <li>Generous vacation policy</li>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </ContentGate>
</Layout>
