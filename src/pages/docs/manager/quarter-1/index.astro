---
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/ui/Card.astro';

const title = "Quarter 1";

const resources = [
  {
    title: 'Self Evaluation',
    description: 'Guide your team through self-assessment and growth planning',
    href: '/docs/manager/quarter-1/self-evaluation',
    image: '📝'
  },
  {
    title: 'Short-term Growth Exercise',
    description: 'Help team members identify and plan for immediate growth opportunities',
    href: '/docs/manager/quarter-1/short-term-growth-exercise',
    image: '🌱'
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
        <p class="text-lg text-gray-600 mt-4">Resources for your first quarter as a manager</p>
      </div>
      
      <div class="grid grid-cols-1 gap-4">
        {resources.map((resource) => (
          <Card {...resource} />
        ))}
      </div>
    </article>
  </main>
</Layout>