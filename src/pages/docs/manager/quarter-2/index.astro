---
import Layout from '../../../../layouts/Layout.astro';
import Card from '../../../../components/ui/Card.astro';

const title = "Quarter 2";

const resources = [
  {
    title: 'Individual Assessment',
    description: 'Conduct comprehensive performance reviews and development planning',
    href: '/docs/manager/quarter-2/individual-assessment',
    image: '📋'
  },
  {
    title: 'Long-term Goals',
    description: 'Help team members set and work toward long-term career objectives',
    href: '/docs/manager/quarter-2/long-term-goals',
    image: '🎯'
  }
];
---

<Layout title={title}>
  <main class="py-8 px-4 sm:px-6 lg:px-8">
    <article class="max-w-[680px] mx-auto">
      <div class="mb-8">
        <h1 class="text-[32px] font-semibold text-[#1a1f36] tracking-[-0.4px]">{title}</h1>
        <p class="text-lg text-gray-600 mt-4">Resources for your second quarter as a manager</p>
      </div>
      
      <div class="grid grid-cols-1 gap-4">
        {resources.map((resource) => (
          <Card {...resource} />
        ))}
      </div>
    </article>
  </main>
</Layout>