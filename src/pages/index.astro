---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeHeaderAuth from '../components/auth/HomeHeaderAuth';

const title = "Open Design Docs";
const redirectTo = Astro.url.searchParams.get('redirect');
const redirectToLevels = '/docs/levels/levels-titles';

const featuredResources = [
  {
    title: 'Leadership Blueprint',
    description: 'Essential frameworks and tools for new design leaders',
    href: '/docs/manager/leadership-blueprint',
    section: 'Manager',
    icon: 'FileText'
  },
  {
    title: 'Level Competencies',
    description: 'Comprehensive competency framework for design roles and career progression',
    href: '/docs/levels/level-competencies',
    section: 'Levels',
    icon: 'Target'
  },
  {
    title: 'Reviews AI',
    description: 'AI-powered performance reviews that save time and improve feedback quality',
    href: '/docs/reviews-ai',
    section: 'Tools',
    icon: 'Bot'
  }
];

---

<HomeLayout title={title}>
  <div class="min-h-screen bg-[#FAFAFA]">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
              </svg>
              <span class="text-[15px] font-medium text-gray-900 leading-none">Open Design Docs</span>
            </a>
          </div>
          
          <div class="flex items-center space-x-4">
            <!-- Dynamic auth component that shows profile avatar when logged in -->
            <HomeHeaderAuth client:load />
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <div class="pt-24 pb-8 sm:pt-40 sm:pb-12 lg:pt-48 lg:pb-16">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl relative">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif text-gray-900 mb-4 sm:mb-6">Resources for building great design teams.</h1>
              <p class="text-base sm:text-lg lg:text-xl font-semibold text-gray-600 mb-6 sm:mb-8 pt-2 sm:pt-4">Access comprehensive guides, templates, and insights to help you build and scale effective design organizations.</p>
              <div class="mt-6 sm:mt-10">
                <a
                  href={redirectToLevels}
                  class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-[rgb(79,70,229)] hover:bg-[rgb(67,56,202)] rounded-md transition-colors cursor-pointer no-underline"
                >
                  Browse all resources
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Resources -->
    <div class="pt-8 pb-8 sm:pt-8 sm:pb-12">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4">Featured Resources</h2>
        <div class="grid grid-cols-1 gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {featuredResources.map((resource, index) => (
            <a 
              href={resource.href}
              class="group block text-left w-full cursor-pointer no-underline"
              id={`featured-resource-${index}`}
            >
              <div class="relative bg-white rounded-2xl border border-gray-200 p-6 transition-all duration-200 hover:shadow-lg hover:-translate-y-1">
                <div class="flex flex-col items-start gap-3 mb-3">
                  {resource.icon === 'FileText' && (
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14,2 14,8 20,8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10,9 9,9 8,9"></polyline>
                    </svg>
                  )}
                  {resource.icon === 'Target' && (
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <circle cx="12" cy="12" r="10"></circle>
                      <circle cx="12" cy="12" r="6"></circle>
                      <circle cx="12" cy="12" r="2"></circle>
                    </svg>
                  )}
                  {resource.icon === 'Mic' && (
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                      <line x1="12" y1="19" x2="12" y2="23"></line>
                      <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                  )}
                  {resource.icon === 'Bot' && (
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path d="M12 8V4H8"></path>
                      <rect width="16" height="12" x="4" y="8" rx="2"></rect>
                      <path d="M2 14h2"></path>
                      <path d="M20 14h2"></path>
                      <path d="M15 13v2"></path>
                      <path d="M9 13v2"></path>
                    </svg>
                  )}
                  {resource.icon === 'Search' && (
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <circle cx="11" cy="11" r="8"></circle>
                      <path d="m21 21-4.35-4.35"></path>
                    </svg>
                  )}
                  <h3 class="text-xl font-semibold text-gray-900">
                  {resource.title}
                </h3>
                </div>
                <p class="text-gray-600 text-base">{resource.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
    <!-- Full-width Footer -->
    <footer class="py-8 mt-12">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-t border-gray-200 pt-8">
          <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="text-sm text-gray-500">
              &copy; {new Date().getFullYear()} Open Design Docs. All rights reserved.
            </div>
            <div class="flex space-x-6 mt-4 md:mt-0">
              <a href="/legal/privacy" class="text-sm text-gray-500 hover:text-gray-700">Privacy</a>
              <a href="/legal/terms" class="text-sm text-gray-500 hover:text-gray-700">Terms</a>
              <a href="https://linkedin.com/in/jasonculbertson" class="text-sm text-gray-500 hover:text-gray-700">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </div>
  

</HomeLayout>

<!-- Authentication temporarily disabled - buttons now go directly to pages -->