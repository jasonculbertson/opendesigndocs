---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeHeader from '../components/HomeHeader';

const title = "Open Design Docs";
const redirectTo = Astro.url.searchParams.get('redirect');
const redirectToLevels = '/docs/levels/levels-titles';

const featuredResources = [
  {
    title: 'Leadership Blueprint',
    description: 'Essential frameworks and tools for new design leaders',
    href: '/docs/leadership/day-1/leadership-blueprint',
    section: 'Manager Docs'
  },
  {
    title: 'Design Sprint Guide',
    description: 'A comprehensive guide for running effective design sprints with your team',
    href: '/docs/team/design/design-sprint',
    section: 'Team Resources'
  },
  {
    title: 'Design Leader Interviews',
    description: 'Learn from experienced design leaders about building and scaling design teams',
    href: '/docs/videos/interviews',
    section: 'Interviews'
  }
];

---

<HomeLayout title={title}>
  <div class="min-h-screen bg-[#FAFAFA]">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
              </svg>
              <span class="text-[15px] font-medium text-gray-900 leading-none">Open Design Docs</span>
            </a>
          </div>
          <HomeHeader client:load />
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <div class="pt-24 pb-8 sm:pt-40 sm:pb-12 lg:pt-48 lg:pb-16">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl relative">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif text-gray-900 mb-4 sm:mb-6">Resources for building great design teams.</h1>
              <p class="text-base sm:text-lg lg:text-xl font-semibold text-gray-600 mb-6 sm:mb-8 pt-2 sm:pt-4">Access comprehensive guides, templates, and insights to help you build and scale effective design organizations.</p>
              <div class="mt-6 sm:mt-10">
                <button
                  id="browse-resources-btn"
                  type="button"
                  class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base font-medium text-white bg-[rgb(79,70,229)] hover:bg-[rgb(67,56,202)] rounded-md transition-colors cursor-pointer"
                >
                  Browse all resources
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Featured Resources -->
    <div class="pt-8 pb-8 sm:pt-8 sm:pb-12">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4">Featured Resources</h2>
        <div class="grid grid-cols-1 gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {featuredResources.map((resource, index) => (
            <button 
              class="group block text-left w-full cursor-pointer featured-resource-btn" 
              data-href={resource.href}
              id={`featured-resource-${index}`}
            >
              <div class="relative bg-white rounded-2xl border border-gray-200 p-6 transition-all duration-200 hover:shadow-lg hover:-translate-y-1">
                <div class="text-sm font-medium text-gray-500 mb-3">{resource.section}</div>
                <h3 class="text-xl font-semibold text-gray-900 mb-3">
                  {resource.title}
                </h3>
                <p class="text-gray-600 text-base">{resource.description}</p>
              </div>
            </button>
          ))}
        </div>
      </div>
    </div>
    <!-- Full-width Footer -->
    <footer class="py-8 mt-12">
      <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="border-t border-gray-200 pt-8">
          <div class="flex flex-col md:flex-row justify-between items-center">
            <div class="text-sm text-gray-500">
              &copy; {new Date().getFullYear()} Open Design Docs. All rights reserved.
            </div>
            <div class="flex space-x-6 mt-4 md:mt-0">
              <a href="/legal/privacy" class="text-sm text-gray-500 hover:text-gray-700">Privacy</a>
              <a href="/legal/terms" class="text-sm text-gray-500 hover:text-gray-700">Terms</a>
              <a href="https://linkedin.com/in/jasonculbertson" class="text-sm text-gray-500 hover:text-gray-700">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </footer>
  </div>
  

</HomeLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const browseButton = document.getElementById('browse-resources-btn');
    const redirectToLevels = '/docs/levels/levels-titles';
    const redirectTo = new URLSearchParams(window.location.search).get('redirect');

    // Setup auth event listeners
    function setupAuthListeners() {
      const signinLink = document.getElementById('signin-link');
      const signupButton = document.getElementById('signup-button');

      if (signinLink) {
        signinLink.addEventListener('click', (e) => {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('openAuthOverlay', {
            detail: {
              view: 'sign_in',
              redirectTo: redirectToLevels
            }
          }));
        });
      }

      if (signupButton) {
        signupButton.addEventListener('click', (e) => {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('openAuthOverlay', {
            detail: {
              view: 'sign_up',
              redirectTo: redirectToLevels
            }
          }));
        });
      }
    }

    // Setup auth listeners immediately
    setupAuthListeners();

    // Setup again after React hydration
    setTimeout(setupAuthListeners, 1000);

    if (browseButton) {
      browseButton.addEventListener('click', (e) => {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('openAuthOverlay', {
          detail: {
            view: 'sign_up',
            redirectTo: redirectToLevels
          }
        }));
      });
    }

    // Handle featured resource clicks
    const featuredResourceButtons = document.querySelectorAll('.featured-resource-btn');
    featuredResourceButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const href = button.getAttribute('data-href');
        window.dispatchEvent(new CustomEvent('openAuthOverlay', { 
          detail: { 
            view: 'sign_up',
            redirectTo: href
          } 
        }));
      });
    });
  });
</script>