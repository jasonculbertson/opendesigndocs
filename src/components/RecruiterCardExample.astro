---

<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold text-gray-900 mb-2">Design Recruiters</h1>
  <p class="text-lg text-gray-600 mb-8">Connect with top design talent recruiters</p>
  
  <!-- Grid layout for recruiter cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sampleRecruiters.map((recruiter) => (
      <RecruiterCard
        key={recruiter.id}
        imageUrl={recruiter.imageUrl}
        title={recruiter.title}
        subtitle={recruiter.subtitle}
        description={recruiter.description}
        tagSections={recruiter.tagSections}
        primaryButtonText={recruiter.primaryButtonText}
        primaryButtonUrl={recruiter.primaryButtonUrl}
        secondaryLinks={recruiter.secondaryLinks}
        client:load
      />
    ))}
  </div>
</div>

<script>
  import RecruiterCard from './RecruiterCard.tsx';
</script>
