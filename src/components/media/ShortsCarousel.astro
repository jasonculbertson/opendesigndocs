---
import type { ShortData } from '../../utils/videoUtils';

interface Props {
  shorts: ShortData[];
}

const { shorts } = Astro.props;

// Import video utilities
const { getYouTubeVideoId, videoStyles } = await import('../../utils/videoUtils');

// Calculate if we need scroll buttons (rough estimate: 6 visible at desktop width)
const needsScrolling = shorts.length > 6;
---

<section class="mb-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-semibold text-[#1a1f36]">Quick Insights</h2>
  </div>
  
  <div class="relative">
    <div class="flex gap-3 overflow-x-auto pb-4 scrollbar-hide" style="scroll-behavior: smooth;">
      {shorts.map((short, index) => {
        const videoId = getYouTubeVideoId(short.href);
        return (
          <div class="flex-shrink-0 group cursor-pointer" onclick={`window.loadYouTubeVideo && window.loadYouTubeVideo('${videoId}', 'short-thumbnail-${videoId}', '${short.title.replace(/'/g, "\\'")}')`}>
            <div class="w-[180px] relative">
              <div id={`short-thumbnail-${videoId}`} class="relative">
                <div class={`${videoStyles.aspectShorts} rounded-lg overflow-hidden bg-gray-100`}>
                  <img 
                    src={short.thumbnailUrl} 
                    alt={`${short.title} - YouTube Short`}
                    class={`w-full h-full object-cover ${videoStyles.hover}`}
                    loading="lazy"
                  />

                  {/* Duration badge */}
                  <div class={videoStyles.duration}>
                    {short.duration}
                  </div>
                </div>
              </div>
              
              <div class="mt-2">
                <h3 class="text-sm font-medium text-[#1a1f36] line-clamp-2 leading-tight">
                  {short.title}
                </h3>
                <p class="text-xs text-[#3c4257] mt-1">Kevin Wong, Webflow</p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
    
    {/* Scroll buttons - only show if scrolling is needed */}
    {needsScrolling && (
      <>
        <button 
          id="scroll-left" 
          class="absolute left-0 top-1/2 -translate-y-1/2 w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center opacity-0 transition-opacity hover:opacity-100 z-10"
          onclick="scrollShortsCarousel('left')"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        
        <button 
          id="scroll-right" 
          class="absolute right-0 top-1/2 -translate-y-1/2 w-8 h-8 bg-white rounded-full shadow-md flex items-center justify-center opacity-0 transition-opacity hover:opacity-100 z-10"
          onclick="scrollShortsCarousel('right')"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </>
    )}
  </div>
</section>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Show scroll buttons on hover - only when they exist */
  .relative:hover #scroll-left,
  .relative:hover #scroll-right {
    opacity: 1;
  }
</style>

<script is:inline>
// Import and make video loading function available globally
async function initShortsVideoLoader() {
  const { loadYouTubeVideo } = await import('/src/utils/videoUtils.js');
  window.loadYouTubeVideo = loadYouTubeVideo;
}
initShortsVideoLoader();

function scrollShortsCarousel(direction) {
  const carousel = document.querySelector('.overflow-x-auto');
  const scrollAmount = 200;
  
  if (direction === 'left') {
    carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  } else {
    carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }
}
</script> 