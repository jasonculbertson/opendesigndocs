---
interface Props { title: string; }
const { title } = Astro.props;
---
<div data-llm-tools data-title={title} class="llm-tools not-prose" hidden>
  <div class="llm-split">
    <button type="button" data-copy><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="8" y="3" width="13" height="13" rx="1"/><path d="M16 16v5H3V8h5"/></svg><span data-copy-label>Copy for LLM</span></button>
    <button type="button" data-toggle aria-label="More document options" aria-expanded="false" aria-controls="llm-options"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m6 9 6 6 6-6"/></svg></button>
  </div>
  <div id="llm-options" class="llm-menu" hidden>
    <button type="button" data-markdown><span aria-hidden="true">↓</span>View as markdown</button>
    <hr />
    <a data-claude target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span>Open in Claude</a>
    <a data-chatgpt target="_blank" rel="noopener noreferrer"><span aria-hidden="true">↗</span>Open in ChatGPT</a>
  </div>
  <span data-status class="llm-status" role="status" aria-live="polite"></span>
  <dialog aria-labelledby="llm-dialog-title">
    <div class="llm-dialog-header"><h2 id="llm-dialog-title">Document markdown</h2><button type="button" data-close aria-label="Close markdown">✕</button></div>
    <textarea aria-label="Document markdown" readonly spellcheck="false"></textarea>
    <p>Copy this document into your preferred assistant.</p>
  </dialog>
</div>
<style>
  .llm-tools { position:relative; margin: 20px 0 28px; color:#374151; font-family:Inter,system-ui,sans-serif; font-size:14px; line-height:1.5; }
  [hidden] { display:none !important; }
  .llm-split { display:inline-flex; border:1px solid #d1d5db; border-radius:10px; background:white; }
  .llm-split button { display:flex; align-items:center; justify-content:center; gap:9px; min-height:40px; padding:8px 12px; font-weight:500; }
  .llm-split button:first-child { border-radius:9px 0 0 9px; }
  .llm-split button:last-child { border-left:1px solid #d1d5db; border-radius:0 9px 9px 0; min-width:40px; }
  button:hover, .llm-menu a:hover { background:#f3f4f6; }
  button:focus-visible, a:focus-visible, textarea:focus-visible { outline:2px solid #4f46e5; outline-offset:3px; }
  .llm-menu { position:absolute; top:46px; left:0; z-index:40; width:240px; max-width:calc(100vw - 48px); padding:6px; background:white; border:1px solid #e5e7eb; border-radius:12px; box-shadow:0 8px 24px #00000014; }
  .llm-menu button, .llm-menu a { display:flex; align-items:center; gap:12px; padding:10px 12px; width:100%; text-align:left; text-decoration:none; color:inherit; border-radius:6px; font-weight:400; }
  .llm-menu span { width:18px; text-align:center; }
  .llm-menu hr { margin:5px 6px; border:0; border-top:1px solid #e5e7eb; }
  .llm-status { display:block; font-size:12px; margin-top:4px; }
  .llm-status:empty { display:none; }
  dialog { width:min(760px,calc(100vw - 32px)); max-height:85vh; padding:20px; border:1px solid #e5e7eb; border-radius:14px; }
  dialog::backdrop { background:#11182780; }
  .llm-dialog-header { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:16px; }
  .llm-dialog-header h2 { margin:0; font-size:18px; font-weight:600; }
  .llm-dialog-header button { padding:8px; border-radius:6px; }
  textarea { width:100%; height:50vh; padding:12px; border:1px solid #d1d5db; border-radius:6px; font:13px/1.6 ui-monospace,monospace; resize:vertical; }
  dialog p { margin:12px 0 0; font-size:13px; color:#6b7280; }
  @media (min-width:1024px) {
    :global(.llm-heading-row) { display:flex; align-items:center; justify-content:space-between; gap:24px; margin-bottom:28px; }
    :global(.llm-heading-row > h1) { flex:1; min-width:0; margin:0 !important; }
    :global(.llm-heading-row > .llm-tools) { flex-shrink:0; margin:0; }
    .llm-split { white-space:nowrap; }
    .llm-menu { left:auto; right:0; }
    .llm-status { position:absolute; top:100%; right:0; width:220px; text-align:right; }
  }
</style>
<script>
  import { documentMarkdown } from '../utils/documentMarkdown';
  function setupLLMTools() {
    const tools = document.querySelector<HTMLElement>('[data-llm-tools]');
    const content = document.querySelector('main .prose');
    if (!tools || !content || tools.dataset.ready) return;
    tools.dataset.ready = 'true';
    const heading = content.querySelector('h1') || document.querySelector('main h1');
    if (heading) {
      const row = document.createElement('div');
      row.className = 'llm-heading-row';
      heading.before(row);
      row.append(heading, tools);
    } else content.before(tools);
    tools.hidden = false;
    const controller = new AbortController();
    const { signal } = controller;
    const toggle = tools.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const menu = tools.querySelector<HTMLElement>('.llm-menu')!;
    const dialog = tools.querySelector<HTMLDialogElement>('dialog')!;
    const textarea = tools.querySelector<HTMLTextAreaElement>('textarea')!;
    const label = tools.querySelector<HTMLElement>('[data-copy-label]')!;
    const status = tools.querySelector<HTMLElement>('[data-status]')!;
    const title = tools.dataset.title || document.title;
    const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.origin + location.pathname;
    const markdown = () => documentMarkdown(content, title, url);
    const prompt = `Read this Open Design Docs resource, "${title}", and help me apply it to my design team: ${url}`;
    tools.querySelector<HTMLAnchorElement>('[data-claude]')!.href = 'https://claude.ai/new?q=' + encodeURIComponent(prompt);
    tools.querySelector<HTMLAnchorElement>('[data-chatgpt]')!.href = 'https://chatgpt.com/?q=' + encodeURIComponent(prompt);
    const close = () => { menu.hidden = true; toggle.setAttribute('aria-expanded', 'false'); };
    const view = () => { close(); textarea.value = markdown(); dialog.showModal(); textarea.focus(); textarea.select(); };
    let timer: ReturnType<typeof setTimeout>;
    toggle.addEventListener('click', () => { menu.hidden = !menu.hidden; toggle.setAttribute('aria-expanded', String(!menu.hidden)); }, { signal });
    toggle.addEventListener('keydown', e => { if (e.key === 'ArrowDown') { e.preventDefault(); menu.hidden = false; toggle.setAttribute('aria-expanded', 'true'); menu.querySelector('button')?.focus(); } }, { signal });
    document.addEventListener('click', e => { if (!tools.contains(e.target as Node)) close(); }, { signal });
    tools.addEventListener('keydown', e => { if (e.key === 'Escape' && !dialog.open && !menu.hidden) { e.preventDefault(); close(); toggle.focus(); } }, { signal });
    tools.querySelector('[data-markdown]')!.addEventListener('click', view, { signal });
    tools.querySelector('[data-close]')!.addEventListener('click', () => dialog.close(), { signal });
    dialog.addEventListener('close', () => toggle.focus(), { signal });
    menu.querySelectorAll('a').forEach(a => a.addEventListener('click', close, { signal }));
    tools.querySelector('[data-copy]')!.addEventListener('click', async () => {
      close();
      try {
        await navigator.clipboard.writeText(markdown());
        label.textContent = 'Copied!'; status.textContent = 'Document copied as markdown.';
        clearTimeout(timer); timer = setTimeout(() => { label.textContent = 'Copy for LLM'; status.textContent = ''; }, 2500);
      } catch { view(); status.textContent = 'Clipboard unavailable. Select and copy the markdown below.'; }
    }, { signal });
    document.addEventListener('astro:before-swap', () => { controller.abort(); clearTimeout(timer); }, { once:true });
  }
  document.addEventListener('astro:page-load', setupLLMTools);
  setupLLMTools();
</script>
