---
import { getEntry } from 'astro:content';
import CompetencyLayout from '../../../../layouts/CompetencyLayout.astro';

const entry = await getEntry('docs', 'leadership/month-1/level-competencies/copywriter');
const { Content } = await entry.render();

const breadcrumbs = [
  { text: 'Level Competencies', href: '/docs/frameworks/level-competencies' }
];

const frontmatter = {
  title: entry.data.title,
  ...entry.data
};

---

<CompetencyLayout frontmatter={frontmatter} breadcrumbs={breadcrumbs}>
  <Content />
</CompetencyLayout>
