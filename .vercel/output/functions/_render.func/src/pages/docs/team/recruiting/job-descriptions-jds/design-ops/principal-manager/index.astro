---
import CompetencyLayout from '../../../../../../../layouts/CompetencyLayout.astro';

const breadcrumbs = [
  { text: 'Recruiting Team', href: '/docs/team/recruiting' },
  { text: 'Job Descriptions', href: '/docs/team/recruiting/job-descriptions-jds' },
  { text: 'Design Ops', href: '/docs/team/recruiting/job-descriptions-jds/design-ops' }
];

const frontmatter = {
  title: "Principal Design Ops Manager"
};

---

<CompetencyLayout frontmatter={frontmatter} breadcrumbs={breadcrumbs}>
  <div class="prose prose-blue max-w-none">
    <h1>Principal Design Ops Manager</h1>
    
    <h2>Role Overview</h2>
    <p>As a Principal Design Ops Manager, you will be responsible for shaping the future of design operations at the highest level. You will drive organizational transformation, establish company-wide operational strategies, and serve as a key strategic partner to executive leadership.</p>

    <h2>Key Responsibilities</h2>
    <ul>
      <li>Define and drive company-wide design operations vision and strategy</li>
      <li>Lead transformational initiatives that fundamentally improve design effectiveness</li>
      <li>Establish operational frameworks that scale across the organization</li>
      <li>Partner with executive leadership to align operational strategy with business goals</li>
      <li>Drive innovation in design operations practices and methodologies</li>
      <li>Serve as a thought leader and mentor in the design operations community</li>
    </ul>

    <h2>Required Skills</h2>
    <ul>
      <li>12+ years of experience in design operations or related field</li>
      <li>Proven track record of driving organizational transformation</li>
      <li>Strategic vision and exceptional business acumen</li>
      <li>Outstanding leadership and executive presence</li>
      <li>Deep expertise in organizational design and change management</li>
      <li>Strong track record of building and scaling operational frameworks</li>
    </ul>

    <h2>Impact</h2>
    <p>Principal Design Ops Managers are expected to have company-wide and industry impact. They should demonstrate the ability to:</p>
    <ul>
      <li>Drive transformational change that shapes the future of design operations</li>
      <li>Influence company strategy through operational excellence</li>
      <li>Build and scale world-class operational frameworks</li>
      <li>Lead through vision and inspire the next generation of design operations leaders</li>
    </ul>
  </div>
</CompetencyLayout>
